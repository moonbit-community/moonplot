  for row in rows {
    let (date, ordinal, offset, decoded) = row
    assert_eq(reference_date(date).to_ordinal(), ordinal)
    let actual = Some(
      reference_fields(@date.from_ordinal(ordinal, offset_seconds=offset)),
    ) catch {
      _ => None
    }
    assert_eq(actual, decoded)
  }
  let probes : Array[(Double, Array[Int32]?)] = [
    (0.0, None),
    (1.0, None),
    (-1.0, Some([9999, 12, 31, 0, 0, 0, 0, 0])),
    (25550.0, None),
    (-25550.0, Some([9930, 1, 18, 0, 0, 0, 0, 0])),
    (25550.00000142889, None),
    (-25550.00000142889, Some([9930, 1, 17, 23, 59, 59, 876540, 0])),
    (1.0e-11, None),
    (-1.0e-11, Some([9999, 12, 31, 23, 59, 59, 999999, 0])),
    (106751992.0, None),
    (-106751992.0, None),
    (1.0e+100, None),
  ]
  for probe in probes {
    let (ordinal, decoded) = probe
    let actual = Some(reference_fields(@date.num2date(ordinal))) catch {
      _ => None
    }
    assert_eq(actual, decoded)
  }
  let values = @date.drange(
    reference_date([2400, 1, 1, 0, 0, 0, 123456, 0]),
    reference_date([2400, 1, 3, 0, 0, 0, 123456, 0]),
    @date.timedelta(days=0, seconds=25200, microseconds=0),
  )
  assert_eq(values, [
    -2775842.9999985714, -2775842.708331905, -2775842.416665238, -2775842.1249985714,
    -2775841.833331905, -2775841.541665238, -2775841.2499985714,
  ])
  let values = @date.drange(
    reference_date([2400, 1, 1, 0, 0, 0, 123456, 0]),
    reference_date([2400, 1, 1, 0, 0, 1, 123456, 0]),
    @date.timedelta(days=0, seconds=0, microseconds=200003),
  )
  assert_eq(values, [
    -2775842.9999985714, -2775842.9999962565, -2775842.9999939417, -2775842.9999916265,
    -2775842.9999893117,
  ])
