  }
  {
    let locator = @date.MicrosecondLocator::new(interval=7.0, tz="UTC")
    assert_eq(
      locator.tick_values(
        @date.RRuleDateTime::naive(@date.datetime(2000, 1, 1, microsecond=0)),
