    ])
  }
  {
    let locator = @date.MicrosecondLocator::new(interval=2.5, tz="UTC")
    assert_eq(
      locator.tick_values(
        @date.RRuleDateTime::naive(@date.datetime(2000, 1, 1, microsecond=0)),
        @date.RRuleDateTime::naive(@date.datetime(2000, 1, 1, microsecond=3)),
      ),
      [
        -2.8935185185185184e-11, 0.0, 2.8935185185185184e-11, 5.787037037037037e-11,
      ],
