    assert_eq(auto.tick_values(0.0, 3.472222222222222e-11), [
      1.4288773148148148e-06, 1.4288888888888888e-06, 1.428900462962963e-06, 1.428912037037037e-06,
      1.428923611111111e-06, 1.4289351851851852e-06,
