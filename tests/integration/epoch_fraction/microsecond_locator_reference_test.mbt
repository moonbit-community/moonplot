    assert_eq(
      locator
      .as_locator()
      .tick_values(4.6296296296296294e-11, 1.1574074074074074e-11),
      [
        1.4289363425925924e-06, 1.4289351851851852e-06, 1.4289340277777777e-06, 1.4289328703703702e-06,
        1.428931712962963e-06, 1.4289305555555555e-06, 1.428929398148148e-06, 1.4289282407407406e-06,
        1.4289270833333332e-06, 1.428925925925926e-06, 1.4289247685185185e-06, 1.428923611111111e-06,
        1.4289224537037036e-06, 1.428921296296296e-06, 1.4289201388888889e-06, 1.4289189814814814e-06,
        1.4289178240740742e-06, 1.4289166666666667e-06, 1.428915509259259e-06, 1.4289143518518518e-06,
