        1.3002931712962962e-05, 1.3002930555555555e-05, 1.3002929398148147e-05, 1.300292824074074e-05,
        1.3002927083333332e-05, 1.3002925925925923e-05, 1.3002924768518519e-05, 1.300292361111111e-05,
        1.3002922453703704e-05, 1.3002921296296295e-05, 1.3002920138888887e-05, 1.300291898148148e-05,
        1.3002917824074072e-05, 1.3002916666666667e-05, 1.3002915509259259e-05, 1.3002914351851849e-05,
        1.3002913194444444e-05, 1.3002912037037036e-05, 1.3002910879629629e-05, 1.300290972222222e-05,
        1.3002908564814812e-05, 1.3002907407407408e-05, 1.300290625e-05, 1.3002905092592593e-05,
        1.3002903935185184e-05,
      ],
    )
  }
  {
    let locator = @date.MicrosecondLocator::new(interval=0.5, tz="UTC")
    assert_eq(
      locator.tick_values(
        @date.RRuleDateTime::naive(
          @date.datetime(2000, 1, 1, microsecond=999995),
        ),
        @date.RRuleDateTime::naive(
          @date.datetime(2000, 1, 1, microsecond=999998),
        ),
      ),
      [
        1.1574010416666666e-05, 1.1574016203703704e-05, 1.157402199074074e-05, 1.1574027777777779e-05,
        1.1574033564814815e-05, 1.1574039351851851e-05, 1.157404513888889e-05, 1.1574050925925926e-05,
        1.1574056712962962e-05,
      ],
    )
    assert_eq(
      locator
      .as_locator()
      .tick_values(1.1574050925925926e-05, 1.1574016203703704e-05),
      [
        1.3002945601851851e-05, 1.3002939814814815e-05, 1.3002934027777778e-05, 1.300292824074074e-05,
        1.3002922453703704e-05, 1.3002916666666667e-05, 1.3002910879629629e-05, 1.3002905092592593e-05,
        1.3002899305555556e-05,
      ],
    )
  }
  {
    let locator = @date.MicrosecondLocator::new(interval=1.0, tz="UTC")
    assert_eq(
      locator.tick_values(
        @date.RRuleDateTime::naive(
          @date.datetime(2000, 1, 1, microsecond=999995),
        ),
        @date.RRuleDateTime::naive(
          @date.datetime(2000, 1, 1, microsecond=999998),
        ),
      ),
      [
        1.157400462962963e-05, 1.1574016203703704e-05, 1.1574027777777779e-05, 1.1574039351851851e-05,
        1.1574050925925926e-05, 1.15740625e-05,
      ],
    )
    assert_eq(
      locator
      .as_locator()
      .tick_values(1.1574050925925926e-05, 1.1574016203703704e-05),
      [
        1.300295138888889e-05, 1.3002939814814815e-05, 1.300292824074074e-05, 1.3002916666666667e-05,
        1.3002905092592593e-05, 1.3002893518518518e-05,
      ],
    )
  }
  {
    let locator = @date.MicrosecondLocator::new(interval=2.5, tz="UTC")
    assert_eq(
      locator.tick_values(
        @date.RRuleDateTime::naive(
          @date.datetime(2000, 1, 1, microsecond=999995),
        ),
        @date.RRuleDateTime::naive(
          @date.datetime(2000, 1, 1, microsecond=999998),
        ),
      ),
      [
        1.1573987268518518e-05, 1.1574016203703704e-05, 1.157404513888889e-05, 1.1574074074074073e-05,
      ],
    )
    assert_eq(
      locator
      .as_locator()
      .tick_values(1.1574050925925926e-05, 1.1574016203703704e-05),
      [1.300295138888889e-05, 1.3002922453703704e-05, 1.3002893518518518e-05],
    )
  }
  {
    let locator = @date.MicrosecondLocator::new(interval=7.0, tz="UTC")
    assert_eq(
      locator.tick_values(
        @date.RRuleDateTime::naive(
          @date.datetime(2000, 1, 1, microsecond=999995),
        ),
        @date.RRuleDateTime::naive(
          @date.datetime(2000, 1, 1, microsecond=999998),
        ),
      ),
      [1.1573981481481482e-05, 1.15740625e-05],
    )
    assert_eq(
      locator
      .as_locator()
      .tick_values(1.1574050925925926e-05, 1.1574016203703704e-05),
      [1.3002986111111111e-05, 1.3002905092592593e-05, 1.3002824074074074e-05],
    )
  }
  let auto = @date.AutoDateLocator::new(tz="UTC")
  assert_eq(auto.tick_values(1.1574016203703704e-05, 1.1574050925925926e-05), [
    1.3002893518518518e-05, 1.3002905092592593e-05, 1.3002916666666667e-05, 1.300292824074074e-05,
    1.3002939814814815e-05, 1.300295138888889e-05,
  ])
}
