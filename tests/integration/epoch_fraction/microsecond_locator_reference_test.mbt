// Original MicrosecondLocator and AutoDateLocator with custom epoch.

///|
fn verify_microsecond_locator_epoch_reference() -> Unit raise {
  {
    let locator = @date.MicrosecondLocator::new(interval=0.1, tz="UTC")
    assert_eq(
      locator.tick_values(
        @date.RRuleDateTime::naive(@date.datetime(2000, 1, 1, microsecond=0)),
        @date.RRuleDateTime::naive(@date.datetime(2000, 1, 1, microsecond=3)),
      ),
      [
        -1.1574074074074076e-12, 0.0, 1.1574074074074076e-12, 2.314814814814815e-12,
        3.472222222222223e-12, 4.62962962962963e-12, 5.7870370370370384e-12, 6.944444444444446e-12,
        8.101851851851853e-12, 9.25925925925926e-12, 1.0416666666666666e-11, 1.1574074074074074e-11,
        1.2731481481481483e-11, 1.3888888888888888e-11, 1.5046296296296296e-11, 1.6203703703703703e-11,
        1.736111111111111e-11, 1.851851851851852e-11, 1.9675925925925925e-11, 2.0833333333333332e-11,
        2.199074074074074e-11, 2.3148148148148147e-11, 2.4305555555555558e-11, 2.5462962962962965e-11,
        2.6620370370370373e-11, 2.7777777777777777e-11, 2.8935185185185184e-11, 3.009259259259259e-11,
        3.125e-11, 3.240740740740741e-11, 3.3564814814814817e-11, 3.472222222222222e-11,
        3.587962962962963e-11,
      ],
    )
    assert_eq(locator.as_locator().tick_values(3.472222222222222e-11, 0.0), [
      1.4289247685185185e-06, 1.428923611111111e-06, 1.4289224537037036e-06, 1.428921296296296e-06,
      1.4289201388888889e-06, 1.4289189814814814e-06, 1.4289178240740742e-06, 1.4289166666666667e-06,
      1.428915509259259e-06, 1.4289143518518518e-06, 1.4289131944444443e-06, 1.428912037037037e-06,
      1.4289108796296296e-06, 1.4289097222222222e-06, 1.4289085648148147e-06, 1.4289074074074072e-06,
      1.42890625e-06, 1.4289050925925925e-06, 1.428903935185185e-06, 1.4289027777777778e-06,
      1.4289016203703702e-06, 1.428900462962963e-06, 1.4288993055555555e-06, 1.428898148148148e-06,
      1.4288969907407408e-06, 1.4288958333333333e-06, 1.4288946759259259e-06, 1.4288935185185184e-06,
      1.428892361111111e-06, 1.4288912037037037e-06, 1.4288900462962962e-06, 1.4288888888888888e-06,
      1.4288877314814813e-06,
    ])
  }
  {
    let locator = @date.MicrosecondLocator::new(interval=0.5, tz="UTC")
    assert_eq(
      locator.tick_values(
        @date.RRuleDateTime::naive(@date.datetime(2000, 1, 1, microsecond=0)),
        @date.RRuleDateTime::naive(@date.datetime(2000, 1, 1, microsecond=3)),
      ),
      [
        -5.787037037037037e-12, 0.0, 5.787037037037037e-12, 1.1574074074074074e-11,
        1.736111111111111e-11, 2.3148148148148147e-11, 2.8935185185185184e-11, 3.472222222222222e-11,
        4.050925925925926e-11,
      ],
    )
    assert_eq(locator.as_locator().tick_values(3.472222222222222e-11, 0.0), [
      1.428929398148148e-06, 1.428923611111111e-06, 1.4289178240740742e-06, 1.428912037037037e-06,
      1.42890625e-06, 1.428900462962963e-06, 1.4288946759259259e-06, 1.4288888888888888e-06,
      1.428883101851852e-06,
    ])
  }
  {
    let locator = @date.MicrosecondLocator::new(interval=1.0, tz="UTC")
    assert_eq(
      locator.tick_values(
        @date.RRuleDateTime::naive(@date.datetime(2000, 1, 1, microsecond=0)),
        @date.RRuleDateTime::naive(@date.datetime(2000, 1, 1, microsecond=3)),
