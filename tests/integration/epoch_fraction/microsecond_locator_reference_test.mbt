      [
        1.4288877314814813e-06, 1.4288888888888888e-06, 1.4288900462962962e-06, 1.4288912037037037e-06,
        1.428892361111111e-06, 1.4288935185185184e-06, 1.4288946759259259e-06, 1.4288958333333333e-06,
