  for row in rows {
    let (date, ordinal, offset, decoded) = row
    assert_eq(reference_date(date).to_ordinal(), ordinal)
    let actual = Some(
      reference_fields(@date.from_ordinal(ordinal, offset_seconds=offset)),
    ) catch {
      _ => None
    }
    assert_eq(actual, decoded)
  }
  let probes : Array[(Double, Array[Int32]?)] = [
    (0.0, Some([2000, 1, 1, 0, 0, 0, 123456, 0])),
    (1.0, Some([2000, 1, 2, 0, 0, 0, 123456, 0])),
    (-1.0, Some([1999, 12, 31, 0, 0, 0, 123456, 0])),
    (25550.0, Some([2069, 12, 14, 0, 0, 0, 123456, 0])),
    (-25550.0, Some([1930, 1, 18, 0, 0, 0, 123456, 0])),
    (25550.00000142889, Some([2069, 12, 14, 0, 0, 0, 246920, 0])),
    (-25550.00000142889, Some([1930, 1, 18, 0, 0, 0, 0, 0])),
    (1.0e-11, Some([2000, 1, 1, 0, 0, 0, 123457, 0])),
    (-1.0e-11, Some([2000, 1, 1, 0, 0, 0, 123455, 0])),
    (106751992.0, None),
    (-106751992.0, None),
    (1.0e+100, None),
  ]
  for probe in probes {
    let (ordinal, decoded) = probe
    let actual = Some(reference_fields(@date.num2date(ordinal))) catch {
      _ => None
    }
    assert_eq(actual, decoded)
  }
  let values = @date.drange(
    reference_date([2400, 1, 1, 0, 0, 0, 123456, 0]),
    reference_date([2400, 1, 3, 0, 0, 0, 123456, 0]),
    @date.timedelta(days=0, seconds=25200, microseconds=0),
  )
  assert_eq(values, [
    146097.00000142888, 146097.29166809554, 146097.58333476222, 146097.87500142888,
    146098.16666809554, 146098.45833476222, 146098.75000142888,
  ])
  let values = @date.drange(
    reference_date([2400, 1, 1, 0, 0, 0, 123456, 0]),
    reference_date([2400, 1, 1, 0, 0, 1, 123456, 0]),
    @date.timedelta(days=0, seconds=0, microseconds=200003),
  )
  assert_eq(values, [
    146097.00000142888, 146097.00000374374, 146097.0000060586, 146097.00000837343,
    146097.0000106883,
  ])
}
