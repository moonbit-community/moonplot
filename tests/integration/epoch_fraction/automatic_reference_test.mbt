// Generated by generate_auto_locator_reference.py from pinned classes.

///|
fn verify_automatic_epoch_reference(
  locator : @date.AutoDateLocator,
) -> Unit raise {
  let formatter = @date.AutoDateFormatter::new(locator=locator.as_locator())
  let values = locator.tick_values(0.0, 9.259259259259259e-09)
  assert_eq(values, [
    1.4282407407407408e-06, 1.4305555555555555e-06, 1.4328703703703704e-06, 1.435185185185185e-06,
    1.4375e-06, 1.439814814814815e-06,
  ])
  assert_eq(locator.frequency(), @date.Microsecond)
  assert_eq(formatter.format_ticks(values), [
    "00:00.246856", "00:00.247056", "00:00.247256", "00:00.247456", "00:00.247656",
    "00:00.247856",
  ])
  let values = locator.tick_values(0.0, 1.6666666666666667)
  assert_eq(values, [
    0.16666666666666666, 0.3333333333333333, 0.5, 0.6666666666666666, 0.8333333333333334,
    1.0, 1.1666666666666667, 1.3333333333333333, 1.5, 1.6666666666666667,
  ])
  assert_eq(locator.frequency(), @date.Hour)
  assert_eq(formatter.format_ticks(values), [
    "01-01 04", "01-01 08", "01-01 12", "01-01 16", "01-01 20", "01-02 00", "01-02 04",
    "01-02 08", "01-02 12", "01-02 16",
  ])
  let values = locator.tick_values(0.0, 1.1574074074074074e-11)
  assert_eq(values, [
    1.4288773148148148e-06, 1.4288888888888888e-06, 1.428900462962963e-06, 1.428912037037037e-06,
  ])
  assert_eq(locator.frequency(), @date.Hour)
  assert_eq(formatter.format_ticks(values), [
    "01-01 00", "01-01 00", "01-01 00", "01-01 00",
  ])
  let values = locator.tick_values(0.0, 0.0)
  assert_eq(values, [
    1.4288773148148148e-06, 1.4288888888888888e-06, 1.428900462962963e-06,
  ])
  assert_eq(locator.frequency(), @date.Hour)
  assert_eq(formatter.format_ticks(values), ["01-01 00", "01-01 00", "01-01 00"])
}
