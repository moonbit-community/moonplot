// Generated by generate_auto_locator_reference.py from pinned classes.

///|
fn verify_automatic_epoch_reference(
  locator : @date.AutoDateLocator,
) -> Unit raise {
  let formatter = @date.AutoDateFormatter::new(locator=locator.as_locator())
  let values = locator.tick_values(0.0, 9.259259259259259e-09)
  assert_eq(values, [
    -2.3148148148148148e-09, 0.0, 2.3148148148148148e-09, 4.6296296296296295e-09,
    6.944444444444444e-09, 9.259259259259259e-09, 1.1574074074074074e-08,
  ])
  assert_eq(locator.frequency(), @date.Microsecond)
  assert_eq(formatter.format_ticks(values), [
    "59:59.999800", "00:00.000000", "00:00.000200", "00:00.000400", "00:00.000600",
    "00:00.000800", "00:00.001000",
  ])
  let values = locator.tick_values(0.0, 1.6666666666666667)
  assert_eq(values, [
    0.0, 0.16666666666666666, 0.3333333333333333, 0.5, 0.6666666666666666, 0.8333333333333334,
    1.0, 1.1666666666666667, 1.3333333333333333, 1.5, 1.6666666666666667,
  ])
  assert_eq(locator.frequency(), @date.Hour)
  assert_eq(formatter.format_ticks(values), [
    "01-01 00", "01-01 04", "01-01 08", "01-01 12", "01-01 16", "01-01 20", "01-02 00",
    "01-02 04", "01-02 08", "01-02 12", "01-02 16",
  ])
  let values = locator.tick_values(0.0, 1.1574074074074074e-11)
  assert_eq(values, [
    -1.1574074074074074e-11, 0.0, 1.1574074074074074e-11, 2.3148148148148147e-11,
  ])
  assert_eq(locator.frequency(), @date.Hour)
  assert_eq(formatter.format_ticks(values), [
    "12-31 23", "01-01 00", "01-01 00", "01-01 00",
  ])
  let values = locator.tick_values(0.0, 0.0)
  assert_eq(values, [-1.1574074074074074e-11, 0.0, 1.1574074074074074e-11])
  assert_eq(locator.frequency(), @date.Hour)
  assert_eq(formatter.format_ticks(values), ["12-31 23", "01-01 00", "01-01 00"])
}
