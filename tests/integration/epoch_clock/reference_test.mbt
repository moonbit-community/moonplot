  for row in rows {
    let (date, ordinal, offset, decoded) = row
    assert_eq(reference_date(date).to_ordinal(), ordinal)
    let actual = Some(
      reference_fields(@date.from_ordinal(ordinal, offset_seconds=offset)),
    ) catch {
      _ => None
    }
    assert_eq(actual, decoded)
  }
  let probes : Array[(Double, Array[Int32]?)] = [
    (0.0, Some([1970, 1, 1, 1, 2, 3, 0, 0])),
    (1.0, Some([1970, 1, 2, 1, 2, 3, 0, 0])),
    (-1.0, Some([1969, 12, 31, 1, 2, 3, 0, 0])),
    (25550.0, Some([2039, 12, 15, 1, 2, 3, 0, 0])),
    (-25550.0, Some([1900, 1, 18, 1, 2, 3, 0, 0])),
    (25550.00000142889, Some([2039, 12, 15, 1, 2, 3, 123460, 0])),
    (-25550.00000142889, Some([1900, 1, 18, 1, 2, 2, 876540, 0])),
    (1.0e-11, Some([1970, 1, 1, 1, 2, 3, 1, 0])),
    (-1.0e-11, Some([1970, 1, 1, 1, 2, 2, 999999, 0])),
    (106751992.0, None),
    (-106751992.0, None),
    (1.0e+100, None),
  ]
  for probe in probes {
    let (ordinal, decoded) = probe
    let actual = Some(reference_fields(@date.num2date(ordinal))) catch {
      _ => None
    }
    assert_eq(actual, decoded)
  }
  let values = @date.drange(
    reference_date([2400, 1, 1, 0, 0, 0, 123456, 0]),
    reference_date([2400, 1, 3, 0, 0, 0, 123456, 0]),
    @date.timedelta(days=0, seconds=25200, microseconds=0),
  )
  assert_eq(values, [
    157053.9569111511, 157054.24857781775, 157054.54024448444, 157054.8319111511,
    157055.12357781775, 157055.41524448444, 157055.7069111511,
  ])
  let values = @date.drange(
    reference_date([2400, 1, 1, 0, 0, 0, 123456, 0]),
    reference_date([2400, 1, 1, 0, 0, 1, 123456, 0]),
    @date.timedelta(days=0, seconds=0, microseconds=200003),
  )
  assert_eq(values, [
    157053.9569111511, 157053.95691346595, 157053.9569157808, 157053.95691809565,
    157053.9569204105,
  ])
}
