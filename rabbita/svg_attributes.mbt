///|
// Explicit public String setters from Rabbita 0.16.7 svg/attrs.mbt.
// Unknown attributes are errors; no innerHTML or private VDOM access is used.
fn svg_attribute(
  attrs : @svg.Attrs,
  element : String,
  name : String,
  value : String,
) -> Unit raise AdapterError {
  ignore(
    match name {
      "style" => attrs.style_attr(value)
      "accumulate" => attrs.accumulate(value)
      "additive" => attrs.additive(value)
      "alignment-baseline" => attrs.alignment_baseline(value)
      "amplitude" => attrs.amplitude(value)
      "attributeName" => attrs.attribute_name(value)
      "attributeType" => attrs.attribute_type(value)
      "autofocus" => attrs.autofocus(value)
      "azimuth" => attrs.azimuth(value)
      "baseFrequency" => attrs.base_frequency(value)
      "baseline-shift" => attrs.baseline_shift(value)
      "baseProfile" => attrs.base_profile(value)
      "begin" => attrs.begin(value)
      "bias" => attrs.bias(value)
      "by" => attrs.by(value)
      "calcMode" => attrs.calc_mode(value)
      "class" => attrs.class(value)
      "clip" => attrs.clip(value)
      "clipPathUnits" => attrs.clip_path_units(value)
      "clip-path" => attrs.clip_path(value)
      "clip-rule" => attrs.clip_rule(value)
      "color" => attrs.color(value)
      "color-interpolation" => attrs.color_interpolation(value)
      "crossorigin" => attrs.crossorigin(value)
      "cursor" => attrs.cursor(value)
      "cx" => attrs.cx(value)
      "cy" => attrs.cy(value)
      "d" => attrs.d(value)
      "decoding" => attrs.decoding(value)
      "diffuseConstant" => attrs.diffuse_constant(value)
      "direction" => attrs.direction(value)
      "display" => attrs.display(value)
      "divisor" => attrs.divisor(value)
      "dominant-baseline" => attrs.dominant_baseline(value)
      "dur" => attrs.dur(value)
      "dx" => attrs.dx(value)
      "dy" => attrs.dy(value)
      "edgeMode" => attrs.edge_mode(value)
      "elevation" => attrs.elevation(value)
      "end" => attrs.end(value)
      "exponent" => attrs.exponent(value)
      "fetchpriority" => attrs.fetchpriority(value)
      "fill" => attrs.fill(value)
      "fill-opacity" => attrs.fill_opacity(value)
      "fill-rule" => attrs.fill_rule(value)
      "filter" => attrs.filter(value)
      "filterUnits" => attrs.filter_units(value)
      "flood-color" => attrs.flood_color(value)
      "flood-opacity" => attrs.flood_opacity(value)
      "font-family" => attrs.font_family(value)
      "font-size" => attrs.font_size(value)
      "font-size-adjust" => attrs.font_size_adjust(value)
      "font-stretch" => attrs.font_stretch(value)
      "font-style" => attrs.font_style(value)
      "font-variant" => attrs.font_variant(value)
      "font-weight" => attrs.font_weight(value)
      "fr" => attrs.fr(value)
      "from" => attrs.from(value)
      "fx" => attrs.fx(value)
      "fy" => attrs.fy(value)
      "glyph-orientation-vertical" => attrs.glyph_orientation_vertical(value)
      "gradientTransform" => attrs.gradient_transform(value)
      "gradientUnits" => attrs.gradient_units(value)
      "height" => attrs.height(value)
      "href" | "xlink:href" => attrs.href(value)
      "hreflang" => attrs.hreflang(value)
      "id" => attrs.id(value)
      "image-rendering" => attrs.image_rendering(value)
      "in" => attrs.in_(value)
      "in2" => attrs.in2(value)
      "intercept" => attrs.intercept(value)
      "k1" => attrs.k1(value)
      "k2" => attrs.k2(value)
      "k3" => attrs.k3(value)
      "k4" => attrs.k4(value)
      "kernelMatrix" => attrs.kernel_matrix(value)
      "kernelUnitLength" => attrs.kernel_unit_length(value)
      "keyPoints" => attrs.key_points(value)
      "keySplines" => attrs.key_splines(value)
      "keyTimes" => attrs.key_times(value)
      "lang" => attrs.lang(value)
      "lengthAdjust" => attrs.length_adjust(value)
      "letter-spacing" => attrs.letter_spacing(value)
      "lighting-color" => attrs.lighting_color(value)
      "limitingConeAngle" => attrs.limiting_cone_angle(value)
      "marker-end" => attrs.marker_end(value)
      "marker-mid" => attrs.marker_mid(value)
      "marker-start" => attrs.marker_start(value)
      "markerHeight" => attrs.marker_height(value)
      "markerUnits" => attrs.marker_units(value)
      "markerWidth" => attrs.marker_width(value)
      "mask" => attrs.mask(value)
      "maskContentUnits" => attrs.mask_content_units(value)
      "maskUnits" => attrs.mask_units(value)
      "max" => attrs.max(value)
      "media" => attrs.media(value)
      "method" => attrs.method_(value)
      "min" => attrs.min(value)
      "mode" => attrs.mode(value)
      "numOctaves" => attrs.num_octaves(value)
      "offset" => attrs.offset(value)
      "opacity" => attrs.opacity(value)
      "operator" => attrs.operator(value)
      "order" => attrs.order(value)
      "orient" => attrs.orient(value)
      "origin" => attrs.origin(value)
      "overflow" => attrs.overflow(value)
      "paint-order" => attrs.paint_order(value)
      "path" => attrs.path(value)
      "pathLength" => attrs.path_length(value)
      "patternContentUnits" => attrs.pattern_content_units(value)
      "patternTransform" => attrs.pattern_transform(value)
      "patternUnits" => attrs.pattern_units(value)
      "ping" => attrs.ping(value)
      "pointer-events" => attrs.pointer_events(value)
      "points" => attrs.points(value)
      "pointsAtX" => attrs.points_at_x(value)
      "pointsAtY" => attrs.points_at_y(value)
      "pointsAtZ" => attrs.points_at_z(value)
      "preserveAlpha" => attrs.preserve_alpha(value)
      "preserveAspectRatio" => attrs.preserve_aspect_ratio(value)
      "primitiveUnits" => attrs.primitive_units(value)
      "r" => attrs.r(value)
      "radius" => attrs.radius(value)
      "referrerPolicy" => attrs.referrer_policy(value)
      "refX" => attrs.ref_x(value)
      "refY" => attrs.ref_y(value)
      "rel" => attrs.rel(value)
      "repeatCount" => attrs.repeat_count(value)
      "repeatDur" => attrs.repeat_dur(value)
      "requiredExtensions" => attrs.required_extensions(value)
      "requiredFeatures" => attrs.required_features(value)
      "restart" => attrs.restart(value)
      "result" => attrs.result(value)
      "rotate" => attrs.rotate(value)
      "rx" => attrs.rx(value)
      "ry" => attrs.ry(value)
      "scale" => attrs.scale(value)
      "seed" => attrs.seed(value)
      "shape-rendering" => attrs.shape_rendering(value)
      "side" => attrs.side(value)
      "slope" => attrs.slope(value)
      "spacing" => attrs.spacing(value)
      "specularConstant" => attrs.specular_constant(value)
      "specularExponent" => attrs.specular_exponent(value)
      "spreadMethod" => attrs.spread_method(value)
      "startOffset" => attrs.start_offset(value)
      "stdDeviation" => attrs.std_deviation(value)
      "stitchTiles" => attrs.stitch_tiles(value)
      "stop-color" => attrs.stop_color(value)
      "stop-opacity" => attrs.stop_opacity(value)
      "stroke" => attrs.stroke(value)
      "stroke-dasharray" => attrs.stroke_dasharray(value)
      "stroke-dashoffset" => attrs.stroke_dashoffset(value)
      "stroke-linecap" => attrs.stroke_linecap(value)
      "stroke-linejoin" => attrs.stroke_linejoin(value)
      "stroke-miterlimit" => attrs.stroke_miterlimit(value)
      "stroke-opacity" => attrs.stroke_opacity(value)
      "stroke-width" => attrs.stroke_width(value)
      "surfaceScale" => attrs.surface_scale(value)
      "systemLanguage" => attrs.system_language(value)
      "tabindex" => attrs.tabindex(value)
      "tableValues" => attrs.table_values(value)
      "target" => attrs.target(value)
      "targetX" => attrs.target_x(value)
      "targetY" => attrs.target_y(value)
      "text-anchor" => attrs.text_anchor(value)
      "text-decoration" => attrs.text_decoration(value)
      "text-overflow" => attrs.text_overflow(value)
      "text-rendering" => attrs.text_rendering(value)
      "textLength" => attrs.text_length(value)
      "to" => attrs.to(value)
      "transform" => attrs.transform(value)
      "transform-origin" => attrs.transform_origin(value)
      "type" => attrs.type_(value)
      "unicode-bidi" => attrs.unicode_bidi(value)
      "values" => attrs.values(value)
      "vector-effect" => attrs.vector_effect(value)
      "viewBox" => attrs.view_box(value)
      "visibility" => attrs.visibility(value)
      "white-space" => attrs.white_space(value)
      "width" => attrs.width(value)
      "word-spacing" => attrs.word_spacing(value)
      "writing-mode" => attrs.writing_mode(value)
      "x" => attrs.x(value)
      "x1" => attrs.x1(value)
      "x2" => attrs.x2(value)
      "xChannelSelector" => attrs.x_channel_selector(value)
      "y" => attrs.y(value)
      "y1" => attrs.y1(value)
      "y2" => attrs.y2(value)
      "yChannelSelector" => attrs.y_channel_selector(value)
      "z" => attrs.z(value)
      "xmlns" => {
        if value != "http://www.w3.org/2000/svg" {
          raise InvalidSvg("Unsupported SVG namespace: " + value)
        }
        attrs
      }
      "xmlns:xlink" => {
        if value != "http://www.w3.org/1999/xlink" {
          raise InvalidSvg("Unsupported XLink namespace: " + value)
        }
        // xlink:href is explicitly translated to the equivalent SVG2 href above.
        attrs
      }
      _ =>
        if name.has_prefix("data-") {
          attrs.data_set(name[5:].to_owned(), value)
        } else {
          raise UnsupportedAttribute(element, name)
        }
    },
  )
}
