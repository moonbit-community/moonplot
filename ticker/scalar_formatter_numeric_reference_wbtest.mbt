test "scalar numeric 53 complete prepare and failed-state calls" {
  let previous_minus = @config.unicode_minus()
  defer @config.set_unicode_minus(previous_minus)
  @config.set_unicode_minus(true)
  let previous_threshold = @config.formatter_offset_threshold()
  @config.set_formatter_offset_threshold(@bigint.BigInt::from_int(4))
  let formatter = ScalarFormatter::new(
    use_offset=Some(ScalarNumber::Boolean(false)),
    use_math_text=Some(false),
    use_locale=Some(false),
    usetex=Some(false),
  )
  @config.set_formatter_offset_threshold(previous_threshold)
  formatter.set_scientific(true)
  formatter.set_power_limits(
    ScalarPowerLimits::Values([
      ScalarNumber::Integer(@bigint.BigInt::from_string("-5")),
      ScalarNumber::Integer(@bigint.BigInt::from_string("6")),
    ]),
  )
  let axis = FormatterAxisBinding::new()
  axis.set_view_interval(
    FormatterViewInterval::Sequence([
      9214871658872686752UL.reinterpret_as_double(),
      9214871658872686753UL.reinterpret_as_double(),
    ]),
  )
  formatter.set_axis(Some(axis))
  assert_eq(
    formatter.set_locs([
      9214871658872686752UL.reinterpret_as_double(),
      9214871658872686753UL.reinterpret_as_double(),
    ]),
    (),
  )
  verify_scalar_numeric_optional(
    formatter.offset(),
    Some(ScalarNumber::Integer(@bigint.BigInt::from_string("0"))),
  )
  verify_scalar_numeric_number(
    formatter.order_of_magnitude(),
    ScalarNumber::Integer(@bigint.BigInt::from_string("308")),
  )
  assert_eq(formatter.format_pattern(), "%1.16f")
  assert_eq(
    formatter.call_value(
      ScalarNumber::Number(9214871658872686752UL.reinterpret_as_double()),
    ),
    "1.0000000000000000",
  )
  assert_eq(
    formatter.call_value(
      ScalarNumber::Number(9214871658872686753UL.reinterpret_as_double()),
    ),
    "1.0000000000000002",
  )
  assert_eq(
    formatter.call_value(ScalarNumber::Number(0UL.reinterpret_as_double())),
    "0.0000000000000000",
  )
  assert_eq(
    formatter.call_value(
      ScalarNumber::Number(9223372036854775808UL.reinterpret_as_double()),
    ),
    "0.0000000000000000",
  )
  assert_eq(
    formatter.call_value(
      ScalarNumber::Number(4487126258331716666UL.reinterpret_as_double()),
    ),
    "0.0000000000000000",
  )
  assert_eq(
    formatter.call_value(
      ScalarNumber::Number(9221120237041090560UL.reinterpret_as_double()),
    ),
    "nan",
  )
  assert_eq(formatter.get_offset(), "1e308")
}

///|
test "scalar numeric 54 complete prepare and failed-state calls" {
  let previous_minus = @config.unicode_minus()
  defer @config.set_unicode_minus(previous_minus)
  @config.set_unicode_minus(true)
  let previous_threshold = @config.formatter_offset_threshold()
  @config.set_formatter_offset_threshold(@bigint.BigInt::from_int(4))
  let formatter = ScalarFormatter::new(
    use_offset=Some(ScalarNumber::Boolean(true)),
    use_math_text=Some(false),
    use_locale=Some(false),
    usetex=Some(false),
  )
  @config.set_formatter_offset_threshold(previous_threshold)
  formatter.set_scientific(false)
  formatter.set_power_limits(
    ScalarPowerLimits::Values([
      ScalarNumber::Integer(@bigint.BigInt::from_string("-5")),
      ScalarNumber::Integer(@bigint.BigInt::from_string("6")),
    ]),
  )
  let axis = FormatterAxisBinding::new()
  axis.set_view_interval(
    FormatterViewInterval::Sequence([
      9214871658872686752UL.reinterpret_as_double(),
      9214871658872686753UL.reinterpret_as_double(),
    ]),
  )
  formatter.set_axis(Some(axis))
  assert_eq(
    formatter.set_locs([
      9214871658872686752UL.reinterpret_as_double(),
      9214871658872686753UL.reinterpret_as_double(),
    ]),
    (),
  )
  verify_scalar_numeric_optional(
    formatter.offset(),
    Some(
      ScalarNumber::NumpyFloat64(9214871658872686752UL.reinterpret_as_double()),
    ),
  )
  verify_scalar_numeric_number(
    formatter.order_of_magnitude(),
    ScalarNumber::Integer(@bigint.BigInt::from_string("0")),
  )
  assert_eq(formatter.format_pattern(), "%1.0f")
  assert_eq(
    formatter.call_value(
      ScalarNumber::Number(9214871658872686752UL.reinterpret_as_double()),
    ),
    "0",
  )
  assert_eq(
    formatter.call_value(
      ScalarNumber::Number(9214871658872686753UL.reinterpret_as_double()),
    ),
    "19958403095347198116563727130368385660674512604354575415025472424372118918689640657849579654926357010893424468441924952439724379883935936607391717982848314203200056729510856765175377214443629871826533567445439239933308104551208703888888552684480441575071209068757560416423584952303440099278848",
  )
  assert_eq(
    formatter.call_value(ScalarNumber::Number(0UL.reinterpret_as_double())),
    "−",
  )
  assert_eq(
    formatter.call_value(
      ScalarNumber::Number(9223372036854775808UL.reinterpret_as_double()),
    ),
    "−",
  )
  assert_eq(
    formatter.call_value(
      ScalarNumber::Number(4487126258331716666UL.reinterpret_as_double()),
    ),
    "−",
  )
  assert_eq(
    formatter.call_value(
      ScalarNumber::Number(9221120237041090560UL.reinterpret_as_double()),
    ),
    "nan",
  )
  assert_eq(formatter.get_offset(), "+1e308")
}

