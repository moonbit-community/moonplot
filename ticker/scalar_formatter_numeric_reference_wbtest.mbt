  formatter.set_axis(Some(axis))
  assert_eq(
    formatter.set_locs([
      4681608360884174848UL.reinterpret_as_double(),
      4681608498323128320UL.reinterpret_as_double(),
      4681608635762081792UL.reinterpret_as_double(),
    ]),
    (),
  )
  verify_scalar_numeric_optional(
    formatter.offset(),
    Some(
      ScalarNumber::NumpyFloat64(4681608360884174848UL.reinterpret_as_double()),
    ),
  )
  verify_scalar_numeric_number(
    formatter.order_of_magnitude(),
    ScalarNumber::Integer(@bigint.BigInt::from_string("0")),
  )
  assert_eq(formatter.format_pattern(), "%1.0f")
  assert_eq(
    formatter.call_value(
      ScalarNumber::Number(4681608360884174848UL.reinterpret_as_double()),
    ),
    "0",
  )
  assert_eq(
    formatter.call_value(
      ScalarNumber::Number(4681608498323128320UL.reinterpret_as_double()),
    ),
    "2",
  )
  assert_eq(
    formatter.call_value(ScalarNumber::Number(0UL.reinterpret_as_double())),
    "−100000",
  )
  assert_eq(
    formatter.call_value(
      ScalarNumber::Number(9223372036854775808UL.reinterpret_as_double()),
    ),
    "−100000",
  )
  assert_eq(
    formatter.call_value(
      ScalarNumber::Number(4487126258331716666UL.reinterpret_as_double()),
    ),
    "−100000",
  )
  assert_eq(
    formatter.call_value(
      ScalarNumber::Number(9221120237041090560UL.reinterpret_as_double()),
    ),
    "nan",
  )
  assert_eq(formatter.get_offset(), "+1e5")
}

