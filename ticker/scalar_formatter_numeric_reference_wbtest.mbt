///|
test "scalar numeric 69 complete prepare and failed-state calls" {
  let previous_minus = @config.unicode_minus()
  defer @config.set_unicode_minus(previous_minus)
  @config.set_unicode_minus(true)
  let previous_threshold = @config.formatter_offset_threshold()
  @config.set_formatter_offset_threshold(@bigint.BigInt::from_int(4))
  let formatter = ScalarFormatter::new(
    use_offset=Some(ScalarNumber::Boolean(false)),
    use_math_text=Some(false),
    use_locale=Some(false),
    usetex=Some(false),
  )
  @config.set_formatter_offset_threshold(previous_threshold)
  formatter.set_scientific(true)
  formatter.set_power_limits(
    ScalarPowerLimits::Values([
      ScalarNumber::Integer(@bigint.BigInt::from_string("-5")),
      ScalarNumber::Integer(@bigint.BigInt::from_string("6")),
    ]),
  )
  let axis = FormatterAxisBinding::new()
  axis.set_view_interval(
    FormatterViewInterval::Integers([
      @bigint.BigInt::from_string(
        "-",
      ),
      @bigint.BigInt::from_string(
        "",
      ),
    ]),
  )
  formatter.set_axis(Some(axis))
  assert_eq(
    try {
      ignore(
        formatter.set_locs_view(
          TickValues::from_array([
            14114281232179134464UL.reinterpret_as_double(),
            14114281232179134464UL.reinterpret_as_double(),
          ]),
        ),
      )
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
      _ => "unexpected error"
    },
    "OverflowError: int too large to convert to float",
  )
  verify_scalar_numeric_optional(
    formatter.offset(),
    Some(ScalarNumber::Integer(@bigint.BigInt::from_string("0"))),
  )
  verify_scalar_numeric_number(
    formatter.order_of_magnitude(),
    ScalarNumber::Integer(@bigint.BigInt::from_string("0")),
  )
  assert_eq(formatter.format_pattern(), "")
  assert_eq(
    formatter.call_value(
      ScalarNumber::NumpyFloat64(14114281232179134464UL.reinterpret_as_double()),
    ),
    "",
  )
  assert_eq(
    formatter.call_value(
      ScalarNumber::NumpyFloat64(14114281232179134464UL.reinterpret_as_double()),
    ),
    "",
  )
  assert_eq(
    try {
      ignore(
        formatter.call_value(ScalarNumber::Number(0UL.reinterpret_as_double())),
      )
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
      _ => "unexpected error"
    },
    "TypeError: not all arguments converted during string formatting",
  )
  assert_eq(
    try {
      ignore(
        formatter.call_value(
          ScalarNumber::Number(9223372036854775808UL.reinterpret_as_double()),
        ),
      )
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
      _ => "unexpected error"
    },
    "TypeError: not all arguments converted during string formatting",
  )
  assert_eq(
    try {
      ignore(
        formatter.call_value(
          ScalarNumber::Number(4487126258331716666UL.reinterpret_as_double()),
        ),
      )
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
      _ => "unexpected error"
    },
    "TypeError: not all arguments converted during string formatting",
  )
  assert_eq(
    try {
      ignore(
        formatter.call_value(
          ScalarNumber::Number(9221120237041090560UL.reinterpret_as_double()),
        ),
      )
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
      _ => "unexpected error"
    },
    "TypeError: not all arguments converted during string formatting",
  )
  assert_eq(formatter.get_offset(), "")
}

