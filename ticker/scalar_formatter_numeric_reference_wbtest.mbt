///|
test "scalar numeric 1310 reentrant offset_capture" {
  let previous_minus = @config.unicode_minus()
  defer @config.set_unicode_minus(previous_minus)
  @config.set_unicode_minus(true)
  let previous_threshold = @config.formatter_offset_threshold()
  @config.set_formatter_offset_threshold(@bigint.BigInt::from_int(4))
  let formatter = ScalarFormatter::new(
    use_offset=Some(ScalarNumber::Boolean(true)),
    use_math_text=Some(false),
    use_locale=Some(false),
    usetex=Some(false),
  )
  @config.set_formatter_offset_threshold(previous_threshold)
  formatter.set_scientific(false)
  formatter.set_power_limits(
    ScalarPowerLimits::Values([
      ScalarNumber::Integer(@bigint.BigInt::from_string("-5")),
      ScalarNumber::Integer(@bigint.BigInt::from_string("6")),
    ]),
  )
  let axis = FormatterAxisBinding::new()
  axis.bind_view_interval(() => {
    formatter.set_use_offset(Some(ScalarNumber::Boolean(false)))
    formatter.set_locs([0.0, 1.0])
    FormatterViewInterval::Sequence([
      4681608360884174848UL.reinterpret_as_double(),
      4681608635762081792UL.reinterpret_as_double(),
    ])
  })
  formatter.set_axis(Some(axis))
  assert_eq(
    formatter.set_locs([
      4681608360884174848UL.reinterpret_as_double(),
      4681608498323128320UL.reinterpret_as_double(),
      4681608635762081792UL.reinterpret_as_double(),
    ]),
    (),
  )
  verify_scalar_numeric_optional(
    formatter.offset(),
    Some(
      ScalarNumber::NumpyFloat64(4681608360884174848UL.reinterpret_as_double()),
    ),
  )
  verify_scalar_numeric_number(
    formatter.order_of_magnitude(),
    ScalarNumber::Integer(@bigint.BigInt::from_string("0")),
  )
  assert_eq(formatter.format_pattern(), "%1.0f")
  assert_eq(formatter.call(1.0), "−99999")
  assert_eq(formatter.get_offset(), "+1e5")
  assert_eq(formatter.locations().get(0), 0.0)
  assert_eq(formatter.locations().length(), 2)
}

///|
test "scalar numeric 1311 reentrant format_length_reread" {
  let previous_minus = @config.unicode_minus()
  defer @config.set_unicode_minus(previous_minus)
  @config.set_unicode_minus(true)
  let previous_threshold = @config.formatter_offset_threshold()
  @config.set_formatter_offset_threshold(@bigint.BigInt::from_int(4))
  let formatter = ScalarFormatter::new(
    use_offset=Some(ScalarNumber::Boolean(false)),
    use_math_text=Some(false),
    use_locale=Some(false),
    usetex=Some(false),
  )
  @config.set_formatter_offset_threshold(previous_threshold)
  formatter.set_scientific(false)
  formatter.set_power_limits(
    ScalarPowerLimits::Values([
      ScalarNumber::Integer(@bigint.BigInt::from_string("-5")),
      ScalarNumber::Integer(@bigint.BigInt::from_string("6")),
    ]),
  )
  let axis = FormatterAxisBinding::new()
  axis.bind_view_interval(() => {
    formatter.set_use_offset(Some(ScalarNumber::Boolean(false)))
    formatter.set_locs([0.0, 1.0])
    FormatterViewInterval::Sequence([
      4598175219545276416UL.reinterpret_as_double(),
      4611967493404098560UL.reinterpret_as_double(),
    ])
  })
  formatter.set_axis(Some(axis))
  assert_eq(
    formatter.set_locs([4607182418800017408UL.reinterpret_as_double()]),
    (),
  )
  verify_scalar_numeric_optional(
    formatter.offset(),
    Some(ScalarNumber::Integer(@bigint.BigInt::from_string("0"))),
  )
  verify_scalar_numeric_number(
    formatter.order_of_magnitude(),
    ScalarNumber::Integer(@bigint.BigInt::from_string("0")),
  )
  assert_eq(formatter.format_pattern(), "%1.3f")
  assert_eq(formatter.call(1.0), "1.000")
  assert_eq(formatter.get_offset(), "")
  assert_eq(formatter.locations().get(0), 0.0)
  assert_eq(formatter.locations().length(), 2)
}

///|
test "scalar numeric 1312 full array last point beyond legacy prefix" {
  let previous_minus = @config.unicode_minus()
  defer @config.set_unicode_minus(previous_minus)
  @config.set_unicode_minus(true)
  let previous_threshold = @config.formatter_offset_threshold()
  @config.set_formatter_offset_threshold(@bigint.BigInt::from_int(4))
  let formatter = ScalarFormatter::new(
    use_offset=Some(ScalarNumber::Boolean(false)),
    use_math_text=Some(false),
    use_locale=Some(false),
    usetex=Some(false),
  )
  @config.set_formatter_offset_threshold(previous_threshold)
  formatter.set_scientific(false)
  formatter.set_power_limits(
    ScalarPowerLimits::Values([
      ScalarNumber::Integer(@bigint.BigInt::from_string("-5")),
      ScalarNumber::Integer(@bigint.BigInt::from_string("6")),
    ]),
  )
  let axis = FormatterAxisBinding::new()
  axis.set_view_interval(
    FormatterViewInterval::Integers([
      @bigint.BigInt::from_string("0"),
      @bigint.BigInt::from_string("1"),
    ]),
  )
  formatter.set_axis(Some(axis))
  let values = Array::make(200001, 0.0)
  values[200000] = 4548686775598520385UL.reinterpret_as_double()
  assert_eq(formatter.set_locs(values), ())
  verify_scalar_numeric_optional(
    formatter.offset(),
    Some(ScalarNumber::Integer(@bigint.BigInt::from_string("0"))),
  )
  verify_scalar_numeric_number(
    formatter.order_of_magnitude(),
    ScalarNumber::Integer(@bigint.BigInt::from_string("0")),
  )
  assert_eq(formatter.format_pattern(), "%1.7f")
  assert_eq(formatter.locations().length(), 200001)
  assert_eq(formatter.call(0UL.reinterpret_as_double()), "0.0000000")
  assert_eq(
    formatter.call(4548686775598520385UL.reinterpret_as_double()),
    "0.0001235",
  )
}
