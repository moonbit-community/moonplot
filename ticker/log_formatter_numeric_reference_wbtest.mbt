///|
fn log_formatter_numeric_case_886() -> Unit raise {
  let formatter = LogFormatterMathtext::new(
    base=LogValue::Numeric(
      ScalarNumber::Number(9221120237041090560UL.reinterpret_as_double()),
    ),
    label_only_base=LogValue::Numeric(ScalarNumber::Boolean(false)),
    minor_thresholds=Some(
      LogMinorThresholds::Sequence([
        LogValue::Numeric(
          ScalarNumber::Integer(@bigint.BigInt::from_string("1")),
        ),
        LogValue::Numeric(
          ScalarNumber::Number(4600877379321698714UL.reinterpret_as_double()),
        ),
      ]),
    ),
    linthresh=LogValue::NoneValue,
  )
  let base = formatter.as_base_formatter()
  let state = log_formatter_state(base)
  let axis = FormatterAxisBinding::new()
  axis.set_view_interval(
    FormatterViewInterval::Sequence([
      4607182418800017408UL.reinterpret_as_double(),
      4636737291354636288UL.reinterpret_as_double(),
    ]),
  )
  formatter.set_axis(Some(axis))
  let value = ScalarNumber::Integer(
    @bigint.BigInt::from_string(
      "",
    ),
  )
  assert_eq(
    try {
      ignore(log_named_call(base, state, value, None))
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
      _ => "unexpected error"
    },
    "ValueError: cannot convert float NaN to integer",
  )
  assert_eq(
    try {
      ignore(log_named_data(base, state, value))
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
      _ => "unexpected error"
    },
    "ValueError: cannot convert float NaN to integer",
  )
  assert_eq(
    try {
      ignore(log_named_short(value))
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
      _ => "unexpected error"
    },
    "OverflowError: int too large to convert to float",
  )
}

