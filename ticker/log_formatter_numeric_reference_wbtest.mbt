    base=LogValue::Numeric(
      ScalarNumber::Number(13837309855095848960UL.reinterpret_as_double()),
    ),
    label_only_base=LogValue::Numeric(ScalarNumber::Boolean(false)),
    minor_thresholds=Some(
      LogMinorThresholds::Sequence([
        LogValue::Numeric(
          ScalarNumber::Integer(@bigint.BigInt::from_string("100")),
        ),
        LogValue::Numeric(
          ScalarNumber::Integer(@bigint.BigInt::from_string("100")),
        ),
      ]),
    ),
    linthresh=LogValue::NoneValue,
  )
  let base = formatter.as_base_formatter()
  let state = log_formatter_state(base)
  let axis = FormatterAxisBinding::new()
  axis.set_view_interval(
    FormatterViewInterval::Sequence([
      4606281698874543309UL.reinterpret_as_double(),
      4607632778762754458UL.reinterpret_as_double(),
    ]),
  )
  formatter.set_axis(Some(axis))
  state.sublabels = Some(log_cache_explicit([13.0]))
  assert_eq(
    try {
      ignore(log_named_prepare(base, state))
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
      _ => "unexpected error"
    },
    "ValueError: math domain error",
  )
  let snapshot = log_cache_values(state.sublabels.unwrap())
  assert_eq(snapshot.length(), 1)
  assert_eq(snapshot.map(value => value.reinterpret_as_uint64()), [
    4623507967449235456UL,
  ])
}

