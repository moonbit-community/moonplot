        LogValue::Numeric(
          ScalarNumber::Integer(@bigint.BigInt::from_string("1")),
        ),
        LogValue::Numeric(
          ScalarNumber::Number(4600877379321698714UL.reinterpret_as_double()),
        ),
      ]),
    ),
    linthresh=LogValue::NoneValue,
  )
  let base = formatter.as_base_formatter()
  let state = log_formatter_state(base)
  let axis = FormatterAxisBinding::new()
  axis.set_view_interval(
    FormatterViewInterval::Sequence([
      4607182418800017408UL.reinterpret_as_double(),
      4617315517961601024UL.reinterpret_as_double(),
    ]),
  )
  formatter.set_axis(Some(axis))
  state.sublabels = Some(log_cache_explicit([13.0]))
  assert_eq(log_named_prepare(base, state), ())
  let snapshot = log_cache_values(state.sublabels.unwrap())
  assert_eq(snapshot.length(), 6)
  assert_eq(snapshot.map(value => value.reinterpret_as_uint64()), [
    4607182418800017408UL, 4611686018427387904UL, 4613937818241073152UL, 4616189618054758400UL,
    4618441417868443648UL, 4621819117588971520UL,
