// Generated from complete original ScalarFormatter and fixed stdlib locale.

///|
fn scalar_locale_case_failure(index : Int32, error : Error) -> Unit raise {
  fail(
    "Scalar original locale case " +
    index.to_string() +
    " failed: " +
    error.to_string(),
  )
}

///|
// Original case 0: numeric locale complete stages
fn scalar_original_locale_case_0() -> Unit raise {
  let saved_locale = @config.numeric_locale()
  defer @config.set_numeric_locale(saved_locale)
  let saved_minus = @config.unicode_minus()
  defer @config.set_unicode_minus(saved_minus)
  @config.set_unicode_minus(true)
  @config.set_numeric_locale(
    @config.NumericLocale::new(decimal_point=".", thousands_sep="", grouping=[]),
  )
  assert_eq(
    scalar_named_format("%1.0f", ScalarNumber::Number(-1234567.89), true, false),
    "−1234568",
  )
}

