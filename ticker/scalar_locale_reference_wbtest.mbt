///|
test "Scalar locale proven negative repeat boundary 0" {
  let saved = @config.numeric_locale()
  defer @config.set_numeric_locale(saved)
  @config.set_numeric_locale(
    @config.NumericLocale::new(thousands_sep=",", grouping=[-1, 0]),
  )
  let failed = try {
    ignore(
      scalar_named_format(
        "%d",
        ScalarNumber::Integer(@bigint.BigInt::from_int(12345)),
        true,
        false,
      ),
    )
    false
  } catch {
    @core.DataError::InvalidTicks(message~) => {
      assert_eq(
        message, "Unsupported: locale negative repeated grouping does not terminate in CPython",
      )
      true
    }
    _ => false
  }
  assert_true(failed)
}

///|
test "Scalar locale proven negative repeat boundary 1" {
  let saved = @config.numeric_locale()
  defer @config.set_numeric_locale(saved)
  @config.set_numeric_locale(
    @config.NumericLocale::new(thousands_sep=",", grouping=[-3, 0]),
  )
  let failed = try {
    ignore(
      scalar_named_format(
        "%d",
        ScalarNumber::Integer(@bigint.BigInt::from_int(12345)),
        true,
        false,
      ),
    )
    false
  } catch {
    @core.DataError::InvalidTicks(message~) => {
      assert_eq(
        message, "Unsupported: locale negative repeated grouping does not terminate in CPython",
      )
      true
    }
    _ => false
  }
  assert_true(failed)
}

///|
test "Scalar locale proven negative repeat boundary 2" {
  let saved = @config.numeric_locale()
  defer @config.set_numeric_locale(saved)
  @config.set_numeric_locale(
    @config.NumericLocale::new(thousands_sep=",", grouping=[3, -1, 0]),
  )
  let failed = try {
    ignore(
      scalar_named_format(
        "%d",
        ScalarNumber::Integer(@bigint.BigInt::from_int(12345)),
        true,
        false,
      ),
    )
    false
  } catch {
    @core.DataError::InvalidTicks(message~) => {
      assert_eq(
        message, "Unsupported: locale negative repeated grouping does not terminate in CPython",
      )
      true
    }
    _ => false
  }
  assert_true(failed)
}
