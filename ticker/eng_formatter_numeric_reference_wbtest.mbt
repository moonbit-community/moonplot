  state.scalar.offset = Some(
    ScalarNumber::Number(9221120237041090560UL.reinterpret_as_double()),
  )
  state.scalar.order = ScalarNumber::Integer(@bigint.BigInt::from_string("400"))
  state.scalar.format_pattern = "%r"
  assert_eq(
    try {
      ignore(formatter.call(0.0))
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
      _ => "unexpected error"
    },
    "OverflowError: (34, 'Result too large')",
  )
  assert_eq(
    try {
      ignore(formatter.get_offset())
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
      _ => "unexpected error"
    },
    "ValueError: cannot convert float NaN to integer",
  )
}

