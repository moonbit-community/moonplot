// Full original EngFormatter/Scalar algorithms. Portable primitive math is explicit.

///|
fn verify_eng_numeric_number(
  actual : ScalarNumber,
  expected : ScalarNumber,
) -> Unit raise {
  match (actual, expected) {
    (Number(a), Number(b)) | (NumpyFloat64(a), NumpyFloat64(b)) =>
      if b.is_nan() {
        assert_true(a.is_nan())
      } else {
        assert_eq(a.reinterpret_as_uint64(), b.reinterpret_as_uint64())
      }
    _ => assert_eq(actual, expected)
  }
}

///|
fn verify_eng_numeric_optional(
  actual : ScalarNumber?,
  expected : ScalarNumber?,
) -> Unit raise {
  match (actual, expected) {
    (Some(a), Some(b)) => verify_eng_numeric_number(a, b)
    (None, None) => ()
    _ => fail("unexpected scalar optional")
  }
}

///|
fn eng_numeric_case_0() -> Unit raise {
  let previous_minus = @config.unicode_minus()
  defer @config.set_unicode_minus(previous_minus)
  @config.set_unicode_minus(true)
  let previous_threshold = @config.formatter_offset_threshold()
  @config.set_formatter_offset_threshold(@bigint.BigInt::from_int(4))
  let formatter = EngFormatter::new(
    unit="",
    places=None,
    sep=" ",
    use_math_text=Some(false),
    usetex=Some(false),
    use_offset=Some(ScalarNumber::Boolean(false)),
  )
  @config.set_formatter_offset_threshold(previous_threshold)
  formatter.set_prefixes(EngPrefixes::si())
  assert_eq(
    formatter.format_data_value(
      ScalarNumber::Number(0UL.reinterpret_as_double()),
    ),
    "0",
  )
}

///|
fn eng_numeric_case_1() -> Unit raise {
  let previous_minus = @config.unicode_minus()
  defer @config.set_unicode_minus(previous_minus)
  @config.set_unicode_minus(true)
  let previous_threshold = @config.formatter_offset_threshold()
  @config.set_formatter_offset_threshold(@bigint.BigInt::from_int(4))
  let formatter = EngFormatter::new(
    unit="",
    places=Some(ScalarNumber::Integer(@bigint.BigInt::from_string("-1"))),
    sep=" ",
    use_math_text=Some(false),
    usetex=Some(false),
    use_offset=Some(ScalarNumber::Boolean(false)),
  )
  @config.set_formatter_offset_threshold(previous_threshold)
  formatter.set_prefixes(EngPrefixes::si())
  assert_eq(
    try {
      ignore(
        formatter.format_data_value(
          ScalarNumber::Number(0UL.reinterpret_as_double()),
        ),
      )
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
      _ => "unexpected error"
    },
    "ValueError: Format specifier missing precision",
  )
}

