  assert_eq(unique.get_int64(1), -1L)
  assert_eq(unique.get_int64(2), 0L)
  verify_auto_minor_grid_bits(major.to_array(), [
    -9.223372036854776e+18, -1.0, 0.0,
  ])
  let step = auto_minor_step(unique, @config.MinorTickDivisions::Number(2.0))
  verify_auto_minor_grid_bits([step], [4.611686018427388e+18])
  verify_auto_minor_grid_bits(
    auto_minor_grid(
      unique, step, -9.223372036854776e+18, -9.223372036854776e+18,
    ),
    [-9.223372036854776e+18],
  )
}

