      9999999999999992.0, 9999999999999994.0, 9999999999999996.0, 9999999999999996.0,
      9999999999999998.0, 1.0e+16, 1.0000000000000002e+16, 1.0000000000000004e+16,
      1.0000000000000004e+16, 1.0000000000000006e+16, 1.0000000000000008e+16, 1.000000000000001e+16,
      1.0000000000000012e+16, 1.0000000000000012e+16,
    ],
  )
}

