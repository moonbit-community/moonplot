///|
test "AutoMinor original grid 205 actual NumPy semantic size failure" {
  let major = TickValues::from_array([0.0, 1.0])
  let unique = auto_minor_unique(major)
  assert_true(!unique.is_int64())
  verify_auto_minor_grid_bits(unique.to_array(), [0.0, 1.0])
  verify_auto_minor_grid_bits(major.to_array(), [0.0, 1.0])
  let step = auto_minor_step(unique, @config.MinorTickDivisions::Number(1.0))
  verify_auto_minor_grid_bits([step], [1.0])
  assert_true(
    try {
      ignore(auto_minor_grid(unique, step, 0.0, 1.152921504606847e+18))
      false
    } catch {
      @core.DataError::InvalidTicks(..) => true
      _ => false
    },
  )
}

