///|
test "AutoMinor original grid 173 true Int64 unique difference wrap and t0" {
  let major = TickValues::from_int64_array([
    9007199254740993L, 9007199254740992L, 9007199254740995L, 9007199254740993L,
  ])
  let unique = auto_minor_unique(major)
  assert_true(unique.is_int64())
  assert_eq(unique.length(), 3)
  assert_eq(unique.get_int64(0), 9007199254740992L)
  assert_eq(unique.get_int64(1), 9007199254740993L)
  assert_eq(unique.get_int64(2), 9007199254740995L)
  verify_auto_minor_grid_bits(major.to_array(), [
    9007199254740992.0, 9007199254740992.0, 9007199254740996.0, 9007199254740992.0,
  ])
  let step = auto_minor_step(unique, @config.MinorTickDivisions::Text("auto"))
  verify_auto_minor_grid_bits([step], [0.2])
  verify_auto_minor_grid_bits(
    auto_minor_grid(unique, step, 9007199254740992.0, 9007199254740996.0),
    [
      9007199254740992.0, 9007199254740992.0, 9007199254740992.0, 9007199254740992.0,
      9007199254740992.0, 9007199254740992.0, 9007199254740994.0, 9007199254740994.0,
      9007199254740994.0, 9007199254740994.0, 9007199254740994.0, 9007199254740994.0,
      9007199254740994.0, 9007199254740994.0, 9007199254740994.0, 9007199254740996.0,
      9007199254740996.0, 9007199254740996.0, 9007199254740996.0, 9007199254740996.0,
      9007199254740996.0,
    ],
  )
}

