///|
test "AutoMinor original grid 169 separate multiply and add rounding" {
  let major = TickValues::from_array([9007199254740992.0, 9007199254740996.0])
  let unique = auto_minor_unique(major)
  assert_true(!unique.is_int64())
  verify_auto_minor_grid_bits(unique.to_array(), [
    9007199254740992.0, 9007199254740996.0,
  ])
  verify_auto_minor_grid_bits(major.to_array(), [
    9007199254740992.0, 9007199254740996.0,
  ])
  let step = auto_minor_step(unique, @config.MinorTickDivisions::Number(2.5))
  verify_auto_minor_grid_bits([step], [1.6])
  verify_auto_minor_grid_bits(
    auto_minor_grid(unique, step, 9007199254740984.0, 9007199254741004.0),
    [
      9007199254740984.0, 9007199254740986.0, 9007199254740987.0, 9007199254740989.0,
      9007199254740990.0, 9007199254740992.0, 9007199254740994.0, 9007199254740996.0,
      9007199254740996.0, 9007199254740998.0, 9007199254741000.0, 9007199254741002.0,
      9007199254741004.0, 9007199254741004.0,
    ],
  )
}

///|
test "AutoMinor original grid 170 separate multiply and add rounding" {
  let major = TickValues::from_array([-9007199254740992.0, -9007199254740988.0])
  let unique = auto_minor_unique(major)
  assert_true(!unique.is_int64())
  verify_auto_minor_grid_bits(unique.to_array(), [
    -9007199254740992.0, -9007199254740988.0,
  ])
  verify_auto_minor_grid_bits(major.to_array(), [
    -9007199254740992.0, -9007199254740988.0,
  ])
  let step = auto_minor_step(unique, @config.MinorTickDivisions::Number(2.5))
  verify_auto_minor_grid_bits([step], [1.6])
  verify_auto_minor_grid_bits(
    auto_minor_grid(unique, step, -9007199254741000.0, -9007199254740980.0),
    [
      -9007199254741000.0, -9007199254740998.0, -9007199254740996.0, -9007199254740996.0,
      -9007199254740994.0, -9007199254740992.0, -9007199254740990.0, -9007199254740989.0,
      -9007199254740987.0, -9007199254740986.0, -9007199254740984.0, -9007199254740982.0,
      -9007199254740981.0, -9007199254740979.0,
    ],
  )
}

