  let major = TickValues::from_array([0.0, 1.0])
  let unique = auto_minor_unique(major)
  assert_true(!unique.is_int64())
  verify_auto_minor_grid_bits(unique.to_array(), [0.0, 1.0])
  verify_auto_minor_grid_bits(major.to_array(), [0.0, 1.0])
  let step = auto_minor_step(
    unique,
    @config.MinorTickDivisions::Integer(
      @bigint.BigInt::from_string("9007199254740993"),
    ),
  )
  verify_auto_minor_grid_bits([step], [1.1102230246251565e-16])
  verify_auto_minor_grid_bits(auto_minor_grid(unique, step, 0.0, 0.0), [0.0])
}

