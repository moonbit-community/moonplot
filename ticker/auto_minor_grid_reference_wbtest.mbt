// Generated by complete original AutoMinorLocator calls and traced locals.

///|
fn verify_auto_minor_grid_bits(
  actual : Array[Double],
  expected : Array[Double],
) -> Unit raise {
  assert_eq(actual.length(), expected.length())
  for index, value in expected {
    if value.is_nan() {
      assert_true(actual[index].is_nan())
    } else {
      assert_eq(
        actual[index].reinterpret_as_uint64(),
        value.reinterpret_as_uint64(),
      )
    }
  }
}

///|
fn verify_auto_minor_unique_zero_set(
  actual : Array[Double],
  expected : Array[Double],
) -> Unit raise {
  assert_eq(actual.length(), expected.length())
  for index, value in expected {
    if value == 0.0 {
      assert_true(actual[index] == 0.0)
    } else if value.is_nan() {
      assert_true(actual[index].is_nan())
    } else {
      assert_eq(
        actual[index].reinterpret_as_uint64(),
        value.reinterpret_as_uint64(),
      )
    }
  }
}

///|
test "AutoMinor original grid 0 global first step and sorted view" {
  let major = TickValues::from_array([3.0, 0.0, 1.0, 1.0, 3.0])
  let unique = auto_minor_unique(major)
  assert_true(!unique.is_int64())
  verify_auto_minor_grid_bits(unique.to_array(), [0.0, 1.0, 3.0])
  verify_auto_minor_grid_bits(major.to_array(), [3.0, 0.0, 1.0, 1.0, 3.0])
  let step = auto_minor_step(unique, @config.MinorTickDivisions::Text("auto"))
  verify_auto_minor_grid_bits([step], [0.2])
  verify_auto_minor_grid_bits(auto_minor_grid(unique, step, 0.0, 1.0), [
    0.0, 0.2, 0.4, 0.6000000000000001, 0.8, 1.0,
  ])
}

