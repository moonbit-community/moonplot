  let step = auto_minor_step(unique, @config.MinorTickDivisions::Text("auto"))
  verify_auto_minor_grid_bits([step], [0.0])
  assert_true(
    try {
      ignore(auto_minor_grid(unique, step, 0.0, 1.0e-323))
      false
    } catch {
      @core.DataError::InvalidTicks(..) => true
      _ => false
    },
  )
}

