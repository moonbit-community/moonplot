///|
test "AutoMinor original grid 202 full phase precedes cap" {
  let major = TickValues::from_array([0.0, 1.0])
  let unique = auto_minor_unique(major)
  assert_true(!unique.is_int64())
  verify_auto_minor_grid_bits(unique.to_array(), [0.0, 1.0])
  verify_auto_minor_grid_bits(major.to_array(), [0.0, 1.0])
  let step = auto_minor_step(unique, @config.MinorTickDivisions::Number(2.5))
  verify_auto_minor_grid_bits([step], [0.4])
  let ticks = auto_minor_grid(unique, step, -20000.0, 30000.0)
  assert_eq(ticks.length(), 100000)
  verify_auto_minor_grid_bits(Array::makei(8, index => ticks[index]), [
    -20000.0, -19999.600000000002, -19999.2, -19998.800000000003, -19998.4, -19998.0,
    -19997.600000000002, -19997.2,
  ])
  verify_auto_minor_grid_bits(Array::makei(4, index => ticks[99996 + index]), [
    19998.4, 19998.800000000003, 19999.2, 19999.600000000002,
  ])
}

