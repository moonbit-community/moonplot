///|
fn logit_object_sort_reference_case_214() -> Unit raise {
  let values = Array::makei(125001, _ => {
    ScalarNumber::Number(0x7ff8000000000000UL.reinterpret_as_double())
  })
  let actual = logit_object_sort(values)
  let runs : Array[(ScalarNumber, Int32)] = [
    (
      ScalarNumber::Number(9221120237041090560UL.reinterpret_as_double()),
      125001,
    ),
  ]
  let mut index = 0
  for (value, count) in runs {
    for _ in 0..<count {
      logit_object_sort_reference_scalar(actual[index], value)
      index += 1
    }
  }
  assert_eq(actual.length(), index)
}

