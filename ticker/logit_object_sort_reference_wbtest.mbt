///|
fn logit_object_sort_reference_case_184() -> Unit raise {
  let values : Array[ScalarNumber] = [
    ScalarNumber::Boolean(false),
    ScalarNumber::NumpyBool(true),
    ScalarNumber::NumpyInt64(-2L),
    ScalarNumber::Integer(
      @bigint.BigInt::from_string("1000000000000000000000000000000"),
    ),
    ScalarNumber::Number(4608308318706860032UL.reinterpret_as_double()),
    ScalarNumber::NumpyFloat64(4602678819172646912UL.reinterpret_as_double()),
  ]
  let error = try {
    ignore(logit_object_sort(values))
    "unexpected success"
  } catch {
    @core.DataError::InvalidTicks(message~) => message
    _ => "unexpected error"
  }
  assert_eq(
    error,
    "OverflowError: Python int too large to convert to C long",
    msg="object sort case 184",
  )
}

