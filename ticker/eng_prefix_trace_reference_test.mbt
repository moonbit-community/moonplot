///|
fn eng_trace_case_0() -> Unit raise {
  let keys = eng_trace_new_keys()
  let mut table = @ticker.EngPrefixes::new()
  {
    table.set_key(keys[8], "0")
    eng_trace_keys(table, keys, [8])
    eng_trace_lookup(table, keys[8], Some("0"), None)
    eng_trace_lookup(table, keys[45], None, None)
  }
  {
    table.set_key(keys[9], "1")
    eng_trace_keys(table, keys, [8, 9])
    eng_trace_lookup(table, keys[9], Some("1"), None)
    eng_trace_lookup(table, keys[28], None, None)
  }
  {
    assert_eq(table.remove_key(keys[8]), true)
    eng_trace_keys(table, keys, [9])
    eng_trace_lookup(table, keys[8], None, None)
    eng_trace_lookup(table, keys[7], None, None)
  }
  {
    table.set_key(keys[7], "3")
    eng_trace_keys(table, keys, [9, 7])
    eng_trace_lookup(table, keys[7], Some("3"), None)
    eng_trace_lookup(table, keys[29], None, None)
  }
  {
    assert_eq(table.get_key(keys[17]), Some("3"))
    eng_trace_keys(table, keys, [9, 7])
    eng_trace_lookup(table, keys[17], Some("3"), None)
    eng_trace_lookup(table, keys[36], None, None)
  }
  {
    table = table.copy()
    eng_trace_keys(table, keys, [9, 7])
    eng_trace_lookup(table, keys[0], None, None)
    eng_trace_lookup(table, keys[21], None, None)
  }
  assert_eq(table.get_key(keys[17]), Some("3"))
  eng_trace_keys(table, keys, [9, 7])
  eng_trace_lookup(table, keys[17], Some("3"), None)
  eng_trace_lookup(table, keys[0], None, None)
}

