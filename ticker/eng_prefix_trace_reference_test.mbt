// Builtin CPython dictionary operation traces; no port algorithm oracle.

///|
fn eng_trace_keys(
  table : @ticker.EngPrefixes,
  all : Array[@ticker.EngPrefixKey],
  expected : Array[Int32],
) -> Unit raise {
  let retained = table.keys()
  assert_eq(retained.length(), expected.length())
  for index, key in retained {
    assert_true(physical_equal(key, all[expected[index]]))
  }
}

///|
fn eng_trace_lookup(
  table : @ticker.EngPrefixes,
  key : @ticker.EngPrefixKey,
  expected : String?,
  expected_error : String?,
) -> Unit raise {
  let (actual, error) = (table.get_key(key), None) catch {
    @core.DataError::InvalidTicks(message~) => (None, Some(message))
    _ => (None, Some("unexpected error"))
  }
  assert_eq(error, expected_error)
  assert_eq(actual, expected)
}

