///|
test "engineering dictionary source traces 0" {
  eng_trace_case_0() catch {
    error =>
      fail(
        "engineering dictionary case " +
        (0).to_string() +
        ": " +
        error.to_string(),
      )
  }
  eng_trace_case_1() catch {
    error =>
      fail(
        "engineering dictionary case " +
        (1).to_string() +
        ": " +
        error.to_string(),
      )
  }
  eng_trace_case_2() catch {
    error =>
      fail(
        "engineering dictionary case " +
        (2).to_string() +
        ": " +
        error.to_string(),
