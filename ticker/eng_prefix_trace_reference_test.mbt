    eng_trace_lookup(table, keys[9], None, None)
  }
  {
    assert_eq(table.get_key(keys[16]), None)
    eng_trace_keys(table, keys, [43])
    eng_trace_lookup(table, keys[16], None, None)
    eng_trace_lookup(table, keys[22], None, None)
  }
  {
    table.set_key(keys[24], "2")
    eng_trace_keys(table, keys, [43, 24])
    eng_trace_lookup(table, keys[24], Some("2"), None)
    eng_trace_lookup(table, keys[8], None, None)
  }
  {
    assert_eq(table.remove_key(keys[39]), false)
    eng_trace_keys(table, keys, [43, 24])
    eng_trace_lookup(table, keys[39], None, None)
    eng_trace_lookup(table, keys[10], None, None)
  }
  {
    table.set_key(keys[26], "4")
    eng_trace_keys(table, keys, [43, 24, 26])
    eng_trace_lookup(table, keys[26], Some("4"), None)
    eng_trace_lookup(table, keys[30], None, None)
  }
