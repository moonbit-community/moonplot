    eng_trace_lookup(table, keys[38], None, None)
  }
  {
    let error = try {
      ignore(table.get_key(keys[37]))
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
      _ => "unexpected error"
    }
    assert_eq(error, "OverflowError: Python int too large to convert to C long")
    eng_trace_keys(table, keys, [43, 24, 26, 23])
    eng_trace_lookup(
      table,
      keys[37],
      None,
      Some("OverflowError: Python int too large to convert to C long"),
    )
