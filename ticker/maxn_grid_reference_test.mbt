  let previous_mode = @config.axes_autolimit_mode()
  defer (try! @config.set_axes_autolimit_mode(previous_mode))
  let locator = @ticker.MaxNLocator::new(nbins=@ticker.MaxNBins::Count(1))
  @config.set_axes_autolimit_mode("data")
  verify_maxn_grid_values(locator.tick_values(1000000.000001, 1000000.000004), [
    1000000.0, 1000000.000002, 1000000.000004,
  ])
  let view_data = locator.view_limits(1000000.000001, 1000000.000004)
  verify_maxn_grid_values([view_data.0, view_data.1], [
    1000000.000001, 1000000.000004,
  ])
  @config.set_axes_autolimit_mode("round_numbers")
  verify_maxn_grid_values(locator.tick_values(1000000.000001, 1000000.000004), [
    1000000.0, 1000000.000002, 1000000.000004,
  ])
  let view_round_numbers = locator.view_limits(1000000.000001, 1000000.000004)
  verify_maxn_grid_values([view_round_numbers.0, view_round_numbers.1], [
    1000000.0, 1000000.000004,
  ])
  let inherited = locator.nonsingular(1000000.000001, 1000000.000004)
  verify_maxn_grid_values([inherited.0, inherited.1], [
    1000000.000001, 1000000.000004,
  ])
}

