  defer (try! @config.set_axes_autolimit_mode(previous_mode))
  let locator = @ticker.MaxNLocator::new(
    nbins=@ticker.MaxNBins::Count(3),
    steps=@ticker.TickValues::from_array([1.0, 0.0 / 0.0, 10.0]),
    integer=false,
  )
  @config.set_axes_autolimit_mode("data")
  verify_maxn_grid_values(locator.tick_values(0.1, 2.1), [0.0, 1.0, 2.0, 3.0])
  let view_data = locator.view_limits(0.1, 2.1)
  verify_maxn_grid_values([view_data.0, view_data.1], [0.1, 2.1])
  @config.set_axes_autolimit_mode("round_numbers")
  verify_maxn_grid_values(locator.tick_values(0.1, 2.1), [0.0, 1.0, 2.0, 3.0])
  let view_round_numbers = locator.view_limits(0.1, 2.1)
  verify_maxn_grid_values([view_round_numbers.0, view_round_numbers.1], [
    0.0, 3.0,
  ])
  let inherited = locator.nonsingular(0.1, 2.1)
  verify_maxn_grid_values([inherited.0, inherited.1], [0.1, 2.1])
}

