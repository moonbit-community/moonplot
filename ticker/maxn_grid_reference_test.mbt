///|
test "MaxN grid original 305 complete search and pruning precede eager prefix" {
  let previous_mode = @config.axes_autolimit_mode()
  defer (try! @config.set_axes_autolimit_mode(previous_mode))
  let locator = @ticker.MaxNLocator::new(
    nbins=@ticker.MaxNBins::Count(100001),
    min_n_ticks=100002,
  )
  @config.set_axes_autolimit_mode("data")
  let ticks_data = locator.tick_values(0.0, 1.0)
  assert_eq(ticks_data.length(), 100000)
  verify_maxn_grid_values(Array::makei(8, index => ticks_data[index]), [
    0.0, 8.0e-06, 1.6e-05, 2.4e-05, 3.2e-05, 3.9999999999999996e-05, 4.8e-05, 5.6e-05,
  ])
  verify_maxn_grid_values(Array::makei(4, index => ticks_data[99996 + index]), [
    0.799968, 0.7999759999999999, 0.7999839999999999, 0.7999919999999999,
  ])
  let view_data = locator.view_limits(0.0, 1.0)
  verify_maxn_grid_values([view_data.0, view_data.1], [0.0, 1.0])
  @config.set_axes_autolimit_mode("round_numbers")
  let ticks_round_numbers = locator.tick_values(0.0, 1.0)
  assert_eq(ticks_round_numbers.length(), 100000)
  verify_maxn_grid_values(
    Array::makei(8, index => ticks_round_numbers[index]),
    [
      0.0, 8.0e-06, 1.6e-05, 2.4e-05, 3.2e-05, 3.9999999999999996e-05, 4.8e-05, 5.6e-05,
    ],
  )
  verify_maxn_grid_values(
    Array::makei(4, index => ticks_round_numbers[99996 + index]),
    [0.799968, 0.7999759999999999, 0.7999839999999999, 0.7999919999999999],
  )
  let view_round_numbers = locator.view_limits(0.0, 1.0)
  verify_maxn_grid_values([view_round_numbers.0, view_round_numbers.1], [
    0.0, 1.0,
  ])
  let inherited = locator.nonsingular(0.0, 1.0)
  verify_maxn_grid_values([inherited.0, inherited.1], [0.0, 1.0])
}

