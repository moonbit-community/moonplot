      @core.DataError::InvalidTicks(..) => true
      _ => false
    },
  )
  let view_data = locator.view_limits(-0.25, 0.75)
  verify_maxn_grid_values([view_data.0, view_data.1], [-0.25, 0.75])
  @config.set_axes_autolimit_mode("round_numbers")
  assert_true(
    try {
      ignore(locator.tick_values(-0.25, 0.75))
      false
    } catch {
      @core.DataError::InvalidTicks(..) => true
      _ => false
    },
  )
  assert_true(
    try {
      ignore(locator.view_limits(-0.25, 0.75))
      false
    } catch {
      @core.DataError::InvalidTicks(..) => true
      _ => false
    },
  )
  let inherited = locator.nonsingular(-0.25, 0.75)
  verify_maxn_grid_values([inherited.0, inherited.1], [-0.25, 0.75])
}

