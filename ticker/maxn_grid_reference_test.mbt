      ignore(locator.tick_values(-1.0e+308, 1.0e+308))
      false
    } catch {
      @core.DataError::InvalidTicks(..) => true
      _ => false
    },
  )
  assert_true(
    try {
      ignore(locator.view_limits(-1.0e+308, 1.0e+308))
      false
    } catch {
      @core.DataError::InvalidTicks(..) => true
      _ => false
    },
  )
  let inherited = locator.nonsingular(-1.0e+308, 1.0e+308)
  verify_maxn_grid_values([inherited.0, inherited.1], [-1.0e+308, 1.0e+308])
}

