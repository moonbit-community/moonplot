test "MaxN grid original 250 Python symmetric max NaN order" {
  let previous_mode = @config.axes_autolimit_mode()
  defer (try! @config.set_axes_autolimit_mode(previous_mode))
  let locator = @ticker.MaxNLocator::new(
    nbins=@ticker.MaxNBins::Count(3),
    symmetric=false,
  )
  @config.set_axes_autolimit_mode("data")
  verify_maxn_grid_values(locator.tick_values(0.0 / 0.0, 1.0), [
    -1.6e-13, -8.0e-14, 0.0, 7.999999999999999e-14, 1.6e-13,
  ])
  let view_data = locator.view_limits(0.0 / 0.0, 1.0)
  verify_maxn_grid_values([view_data.0, view_data.1], [-1.0e-12, 1.0e-12])
  @config.set_axes_autolimit_mode("round_numbers")
