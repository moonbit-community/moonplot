///|
test "MaxN grid original 210 automatic physical budget clipping" {
  let previous_mode = @config.axes_autolimit_mode()
  defer (try! @config.set_axes_autolimit_mode(previous_mode))
  let locator = @ticker.MaxNLocator::new(
    nbins=@ticker.MaxNBins::Auto,
    min_n_ticks=1,
  )
  let reads = [0]
  locator.bind_tick_space(() => {
    reads[0] += 1
    -1.0 / 0.0
  })
  @config.set_axes_autolimit_mode("data")
  reads[0] = 0
  verify_maxn_grid_values(locator.tick_values(0.0, 20.0), [0.0, 20.0])
  assert_eq(reads[0], 1)
  reads[0] = 0
  let view_data = locator.view_limits(0.0, 20.0)
  verify_maxn_grid_values([view_data.0, view_data.1], [0.0, 20.0])
  assert_eq(reads[0], 0)
  @config.set_axes_autolimit_mode("round_numbers")
  reads[0] = 0
  verify_maxn_grid_values(locator.tick_values(0.0, 20.0), [0.0, 20.0])
  assert_eq(reads[0], 1)
  reads[0] = 0
  let view_round_numbers = locator.view_limits(0.0, 20.0)
  verify_maxn_grid_values([view_round_numbers.0, view_round_numbers.1], [
    0.0, 20.0,
  ])
  assert_eq(reads[0], 1)
  let inherited = locator.nonsingular(0.0, 20.0)
  verify_maxn_grid_values([inherited.0, inherited.1], [0.0, 20.0])
}

