// Generated by complete original MaxNLocator/scale_range/Edge bodies.
// Finite values and infinities compare by bits. Allocation omissions are not source errors.

///|
fn verify_maxn_grid_values(
  actual : Array[Double],
  expected : Array[Double],
) -> Unit raise {
  assert_eq(actual.length(), expected.length())
  for index, value in expected {
    if value.is_nan() {
      assert_true(actual[index].is_nan())
    } else {
      assert_eq(
        actual[index].reinterpret_as_uint64(),
        value.reinterpret_as_uint64(),
      )
    }
  }
}

///|
test "MaxN grid original 0 bin intervals / integer relaxation" {
  let previous_mode = @config.axes_autolimit_mode()
  defer (try! @config.set_axes_autolimit_mode(previous_mode))
  let locator = @ticker.MaxNLocator::new(
    nbins=@ticker.MaxNBins::Count(1),
    integer=false,
  )
  @config.set_axes_autolimit_mode("data")
  verify_maxn_grid_values(locator.tick_values(0.1, 0.9), [
    0.0, 0.4, 0.8, 1.2000000000000002,
  ])
  let view_data = locator.view_limits(0.1, 0.9)
  verify_maxn_grid_values([view_data.0, view_data.1], [0.1, 0.9])
  @config.set_axes_autolimit_mode("round_numbers")
  verify_maxn_grid_values(locator.tick_values(0.1, 0.9), [
    0.0, 0.4, 0.8, 1.2000000000000002,
  ])
  let view_round_numbers = locator.view_limits(0.1, 0.9)
  verify_maxn_grid_values([view_round_numbers.0, view_round_numbers.1], [
    0.0, 1.2000000000000002,
  ])
  let inherited = locator.nonsingular(0.1, 0.9)
  verify_maxn_grid_values([inherited.0, inherited.1], [0.1, 0.9])
}

