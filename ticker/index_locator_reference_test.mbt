///|
test "IndexLocator original 222 underflow / epsilon / signed zero / overflow / explicit budget" {
  let locator = @ticker.IndexLocator::new(base=1.0e+308, offset=0.0)
  verify_index_reference_values([locator.base(), locator.offset()], [
    1.0e+308, 0.0,
  ])
  assert_true(
    try {
      ignore(locator.tick_values(-1.0e+308, 1.0e+308))
      false
    } catch {
      @core.DataError::InvalidTicks(..) => true
      _ => false
    },
  )
  let view_data = locator.view_limits(-1.0e+308, 1.0e+308)
  verify_index_reference_values([view_data.0, view_data.1], [
    -1.0e+308, 1.0e+308,
  ])
  let view_round_numbers = locator.view_limits(-1.0e+308, 1.0e+308)
  verify_index_reference_values([view_round_numbers.0, view_round_numbers.1], [
    -1.0e+308, 1.0e+308,
  ])
  let bounds = locator.nonsingular(-1.0e+308, 1.0e+308)
  verify_index_reference_values([bounds.0, bounds.1], [-1.0e+308, 1.0e+308])
}

