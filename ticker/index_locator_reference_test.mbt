///|
test "IndexLocator original 206 binary64 actual fill step" {
  let locator = @ticker.IndexLocator::new(base=0.1, offset=0.0)
  verify_index_reference_values([locator.base(), locator.offset()], [0.1, 0.0])
  verify_index_reference_values(
    locator.tick_values(1.0e+16, 1.0000000000000004e+16),
    [
      1.0e+16, 1.0e+16, 1.0e+16, 1.0e+16, 1.0e+16, 1.0e+16, 1.0e+16, 1.0e+16, 1.0e+16,
