  let locator = @ticker.IndexLocator::new(base=1.0, offset=0.0)
  verify_index_reference_values([locator.base(), locator.offset()], [1.0, 0.0])
  verify_index_reference_values(locator.tick_values(0.2, 3.2), [
    0.2, 1.2, 2.2, 3.2,
  ])
  let view_data = locator.view_limits(0.2, 3.2)
  verify_index_reference_values([view_data.0, view_data.1], [0.2, 3.2])
  let view_round_numbers = locator.view_limits(0.2, 3.2)
  verify_index_reference_values([view_round_numbers.0, view_round_numbers.1], [
    0.2, 3.2,
  ])
  let bounds = locator.nonsingular(0.2, 3.2)
  verify_index_reference_values([bounds.0, bounds.1], [0.2, 3.2])
}

