///|
test "IndexLocator original 180 unchecked nonfinite or zero step" {
  let locator = @ticker.IndexLocator::new(base=0.0, offset=0.0)
  verify_index_reference_values([locator.base(), locator.offset()], [0.0, 0.0])
  assert_true(
    try {
      ignore(locator.tick_values(0.0, 3.0))
      false
    } catch {
      @core.DataError::InvalidTicks(..) => true
      _ => false
    },
  )
  let view_data = locator.view_limits(0.0, 3.0)
  verify_index_reference_values([view_data.0, view_data.1], [0.0, 3.0])
  let view_round_numbers = locator.view_limits(0.0, 3.0)
  verify_index_reference_values([view_round_numbers.0, view_round_numbers.1], [
    0.0, 3.0,
  ])
  let bounds = locator.nonsingular(0.0, 3.0)
  verify_index_reference_values([bounds.0, bounds.1], [0.0, 3.0])
}

