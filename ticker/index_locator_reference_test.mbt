// Generated by the original IndexLocator, inherited Locator methods and NumPy 2.3.5.
// Allocation omissions are not source exceptions; finite values compare by bits.

///|
fn verify_index_reference_values(
  actual : Array[Double],
  expected : Array[Double],
) -> Unit raise {
  assert_eq(actual.length(), expected.length())
  for index, value in expected {
    if value.is_nan() {
      assert_true(actual[index].is_nan())
    } else {
      assert_eq(
        actual[index].reinterpret_as_uint64(),
        value.reinterpret_as_uint64(),
      )
    }
  }
}

///|
test "IndexLocator original 0 fractional spacing / offset / direction" {
  let locator = @ticker.IndexLocator::new(base=0.1, offset=0.0)
  verify_index_reference_values([locator.base(), locator.offset()], [0.1, 0.0])
  verify_index_reference_values(locator.tick_values(0.0, 3.0), [
    0.0, 0.1, 0.2, 0.30000000000000004, 0.4, 0.5, 0.6000000000000001, 0.7000000000000001,
    0.8, 0.9, 1.0, 1.1, 1.2000000000000002, 1.3, 1.4000000000000001, 1.5, 1.6, 1.7000000000000002,
    1.8, 1.9000000000000001, 2.0, 2.1, 2.2, 2.3000000000000003, 2.4000000000000004,
    2.5, 2.6, 2.7, 2.8000000000000003, 2.9000000000000004, 3.0,
  ])
  let view_data = locator.view_limits(0.0, 3.0)
  verify_index_reference_values([view_data.0, view_data.1], [0.0, 3.0])
  let view_round_numbers = locator.view_limits(0.0, 3.0)
  verify_index_reference_values([view_round_numbers.0, view_round_numbers.1], [
    0.0, 3.0,
  ])
  let bounds = locator.nonsingular(0.0, 3.0)
  verify_index_reference_values([bounds.0, bounds.1], [0.0, 3.0])
}

