///|
test "IndexLocator original unchecked updates and independent parameters" {
  let locator = @ticker.IndexLocator::new(base=2.0, offset=0.25)
  let independent = locator.copy()
  locator.set_params(base=-1.0)
  verify_index_reference_values([locator.base(), locator.offset()], [-1.0, 0.25])
  verify_index_reference_values(locator.tick_values(-1.0, 3.0), [])
  verify_index_reference_values([independent.base(), independent.offset()], [
    2.0, 0.25,
  ])
  locator.set_params(offset=-0.5)
  verify_index_reference_values([locator.base(), locator.offset()], [-1.0, -0.5])
  verify_index_reference_values(locator.tick_values(-1.0, 3.0), [])
  verify_index_reference_values([independent.base(), independent.offset()], [
    2.0, 0.25,
  ])
  locator.set_params()
  verify_index_reference_values([locator.base(), locator.offset()], [-1.0, -0.5])
  verify_index_reference_values(locator.tick_values(-1.0, 3.0), [])
  verify_index_reference_values([independent.base(), independent.offset()], [
    2.0, 0.25,
  ])
  locator.set_params()
  verify_index_reference_values([locator.base(), locator.offset()], [-1.0, -0.5])
  verify_index_reference_values(locator.tick_values(-1.0, 3.0), [])
  verify_index_reference_values([independent.base(), independent.offset()], [
    2.0, 0.25,
  ])
  locator.set_params(base=0.0, offset=100.0)
  verify_index_reference_values([locator.base(), locator.offset()], [0.0, 100.0])
  assert_true(
    try {
      ignore(locator.tick_values(-1.0, 3.0))
      false
    } catch {
      @core.DataError::InvalidTicks(..) => true
      _ => false
    },
  )
  verify_index_reference_values([independent.base(), independent.offset()], [
    2.0, 0.25,
  ])
  locator.set_params(base=0.0 / 0.0)
  verify_index_reference_values([locator.base(), locator.offset()], [
    0.0 / 0.0,
    100.0,
  ])
  assert_true(
    try {
      ignore(locator.tick_values(-1.0, 3.0))
      false
    } catch {
      @core.DataError::InvalidTicks(..) => true
      _ => false
    },
  )
  verify_index_reference_values([independent.base(), independent.offset()], [
    2.0, 0.25,
  ])
  locator.set_params(base=1.0 / 0.0, offset=0.0)
  verify_index_reference_values([locator.base(), locator.offset()], [
    1.0 / 0.0,
    0.0,
  ])
  verify_index_reference_values(locator.tick_values(-1.0, 3.0), [-1.0])
  verify_index_reference_values([independent.base(), independent.offset()], [
    2.0, 0.25,
  ])
  locator.set_params(base=1.0, offset=0.0 / 0.0)
  verify_index_reference_values([locator.base(), locator.offset()], [
    1.0,
    0.0 / 0.0,
  ])
  assert_true(
    try {
      ignore(locator.tick_values(-1.0, 3.0))
      false
    } catch {
      @core.DataError::InvalidTicks(..) => true
      _ => false
    },
  )
  verify_index_reference_values([independent.base(), independent.offset()], [
    2.0, 0.25,
  ])
  locator.set_params(base=0.5, offset=0.25)
  verify_index_reference_values([locator.base(), locator.offset()], [0.5, 0.25])
  verify_index_reference_values(locator.tick_values(-1.0, 3.0), [
    -0.75, -0.25, 0.25, 0.75, 1.25, 1.75, 2.25, 2.75,
  ])
  verify_index_reference_values([independent.base(), independent.offset()], [
    2.0, 0.25,
  ])
}

///|
test "IndexLocator original data provider 0" {
  let locator = @ticker.IndexLocator::new(base=1.0, offset=0.0)
  assert_true(
    try {
      ignore(locator.call())
      false
    } catch {
      @core.DataError::InvalidTicks(..) => true
      _ => false
    },
  )
  let state = [0.0, 4.0]
  let reads = [0]
  locator.bind_data_interval(() => {
    reads[0] += 1
    (state[0], state[1])
  })
  let independent = locator.copy()
  state[0] = 0.0
  state[1] = 4.0
  verify_index_reference_values(locator.call(), [0.0, 1.0, 2.0, 3.0, 4.0])
  verify_index_reference_values(independent.call(), [0.0, 1.0, 2.0, 3.0, 4.0])
  assert_eq(reads[0], 2)
  state[0] = 2.0
  state[1] = 5.0
  verify_index_reference_values(locator.call(), [2.0, 3.0, 4.0, 5.0])
  verify_index_reference_values(independent.call(), [2.0, 3.0, 4.0, 5.0])
  assert_eq(reads[0], 4)
  state[0] = -2.0
  state[1] = 2.0
  verify_index_reference_values(locator.call(), [-2.0, -1.0, 0.0, 1.0, 2.0])
  verify_index_reference_values(independent.call(), [-2.0, -1.0, 0.0, 1.0, 2.0])
  assert_eq(reads[0], 6)
}

///|
test "IndexLocator original data provider 1" {
  let locator = @ticker.IndexLocator::new(base=0.5, offset=0.25)
  assert_true(
    try {
      ignore(locator.call())
      false
    } catch {
      @core.DataError::InvalidTicks(..) => true
      _ => false
    },
  )
  let state = [1.0, 3.0]
  let reads = [0]
  locator.bind_data_interval(() => {
    reads[0] += 1
    (state[0], state[1])
  })
  let independent = locator.copy()
  state[0] = 1.0
  state[1] = 3.0
  verify_index_reference_values(locator.call(), [1.25, 1.75, 2.25, 2.75])
  verify_index_reference_values(independent.call(), [1.25, 1.75, 2.25, 2.75])
  assert_eq(reads[0], 2)
  state[0] = 3.0
  state[1] = 1.0
  verify_index_reference_values(locator.call(), [])
  verify_index_reference_values(independent.call(), [])
  assert_eq(reads[0], 4)
  state[0] = 0.0
  state[1] = 0.0
  verify_index_reference_values(locator.call(), [])
  verify_index_reference_values(independent.call(), [])
  assert_eq(reads[0], 6)
}

///|
test "IndexLocator original data provider 2" {
  let locator = @ticker.IndexLocator::new(base=-1.0, offset=0.0)
  assert_true(
    try {
      ignore(locator.call())
      false
    } catch {
      @core.DataError::InvalidTicks(..) => true
      _ => false
    },
  )
  let state = [4.0, 0.0]
  let reads = [0]
  locator.bind_data_interval(() => {
    reads[0] += 1
    (state[0], state[1])
  })
  let independent = locator.copy()
  state[0] = 4.0
  state[1] = 0.0
  verify_index_reference_values(locator.call(), [4.0, 3.0, 2.0, 1.0])
  verify_index_reference_values(independent.call(), [4.0, 3.0, 2.0, 1.0])
  assert_eq(reads[0], 2)
  state[0] = 5.0
  state[1] = 2.0
  verify_index_reference_values(locator.call(), [5.0, 4.0, 3.0])
  verify_index_reference_values(independent.call(), [5.0, 4.0, 3.0])
  assert_eq(reads[0], 4)
  state[0] = 0.0
  state[1] = 4.0
  verify_index_reference_values(locator.call(), [])
  verify_index_reference_values(independent.call(), [])
  assert_eq(reads[0], 6)
}
