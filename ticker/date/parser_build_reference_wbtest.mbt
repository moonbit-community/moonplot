  for (text, expected) in cases {
    let result = try {
      let value = parser.parse(text, default_date=fallback)
      Some([
        value.year,
        value.month,
        value.day,
        value.hour,
        value.minute,
        value.second,
        value.microsecond,
        value.offset_seconds,
      ])
    } catch {
      _ => None
    }
    assert_eq((text, result), (text, expected))
  }
}

///|
test "parser explicit default reference: inherited rule zone" {
  let fallback = datetime(2024, 3, 9, hour=7, minute=30).with_timezone(
    tzif_timezone(parser_new_york),
  )
  let parser = DateStringParser::new(
    context=DateParserContext::utc(clock=fn() { 1767225600000L }),
    reference_year=2026,
  )
  let cases : Array[(String, Array[Int32]?)] = [
    ("10 March", Some([2024, 3, 10, 2, 30, 0, 0, -14400])),
    ("10 March 02:30", Some([2024, 3, 10, 2, 30, 0, 0, -14400])),
    ("11 March", Some([2024, 3, 11, 2, 30, 0, 0, -14400])),
    ("Sunday", Some([2024, 3, 10, 2, 30, 0, 0, -14400])),
    ("2024-11-03 01:30", Some([2024, 11, 3, 1, 30, 0, 0, -14400])),
    ("2024-11-03 01:30 UTC", Some([2024, 11, 3, 1, 30, 0, 0, 0])),
    ("10:30 BRST", Some([2024, 3, 9, 10, 30, 0, 0, -18000])),
  ]
  for (text, expected) in cases {
    let result = try {
      let value = parser.parse(text, default_date=fallback)
      Some([
        value.year,
        value.month,
        value.day,
        value.hour,
        value.minute,
        value.second,
        value.microsecond,
        value.offset_seconds,
      ])
    } catch {
      _ => None
    }
    assert_eq((text, result), (text, expected))
  }
}

///|
test "parser explicit default reference: default later fold" {
  let fallback = datetime(2024, 11, 3, hour=6, minute=30).with_timezone(
    tzif_timezone(parser_new_york),
  )
  let parser = DateStringParser::new(
    context=DateParserContext::utc(clock=fn() { 1767225600000L }),
    reference_year=2026,
  )
  let cases : Array[(String, Array[Int32]?)] = [
    ("01:30", Some([2024, 11, 3, 1, 30, 0, 0, -18000])),
    ("Sunday 01:30", Some([2024, 11, 3, 1, 30, 0, 0, -14400])),
    ("Nov 3 01:30", Some([2024, 11, 3, 1, 30, 0, 0, -18000])),
    ("Nov 4 01:30", Some([2024, 11, 4, 1, 30, 0, 0, -18000])),
    ("2024-03-10 02:30", Some([2024, 3, 10, 2, 30, 0, 0, -14400])),
    ("2024-11-03 01:30 +0300", Some([2024, 11, 3, 1, 30, 0, 0, 10800])),
  ]
  for (text, expected) in cases {
    let result = try {
      let value = parser.parse(text, default_date=fallback)
      Some([
        value.year,
        value.month,
        value.day,
        value.hour,
        value.minute,
        value.second,
        value.microsecond,
        value.offset_seconds,
      ])
    } catch {
      _ => None
    }
    assert_eq((text, result), (text, expected))
  }
}
