    ),
    (
      "0.000000000000000000000000000000000000000000000000001h",
      Some([2003, 9, 25, 0, 0, 0, 0, 0]),
    ),
    (
      "0.000000000000000000000000000000000000000000000000001m",
      Some([2003, 9, 25, 0, 0, 0, 0, 0]),
    ),
    (
      "0.000000000000000000000000000000000000000000000000001s",
      Some([2003, 9, 25, 0, 0, 0, 0, 0]),
    ),
    ("5.5999999999999999999999999999h", Some([2003, 9, 25, 5, 35, 0, 0, 0])),
    ("5.5999999999999999999999999999m", Some([2003, 9, 25, 0, 5, 35, 0, 0])),
    ("5.5999999999999999999999999999s", Some([2003, 9, 25, 0, 0, 5, 599999, 0])),
    ("5.6000000000000000000000000001h", Some([2003, 9, 25, 5, 36, 0, 0, 0])),
    ("5.6000000000000000000000000001m", Some([2003, 9, 25, 0, 5, 36, 0, 0])),
    ("5.6000000000000000000000000001s", Some([2003, 9, 25, 0, 0, 5, 600000, 0])),
    ("100.1h", None),
    ("100.1m", None),
    ("100.1s", None),
    ("23.99999999999999999999999999999h", None),
    ("23.99999999999999999999999999999m", None),
    (
      "23.99999999999999999999999999999s",
      Some([2003, 9, 25, 0, 0, 23, 999999, 0]),
    ),
  ]
  for (text, expected) in cases {
    let result = try {
      let value = parser.parse(text, default_date=fallback)
      Some([
        value.year,
        value.month,
        value.day,
        value.hour,
        value.minute,
        value.second,
        value.microsecond,
        value.offset_seconds,
      ])
    } catch {
      _ => None
    }
    assert_eq((text, result), (text, expected))
  }
}

