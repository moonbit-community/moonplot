  let selected = locator.get_locator_for_range(157054.0, 157054.00000000006)
  assert_eq(locator.frequency(), @date.Year)
  assert_eq(selected.interval(), 1)
  assert_eq(selected.unit_scale(), 1.1574074074074074e-11)
  assert_eq(locator.tick_values(157054.0, 157054.00000000006), [
    157054.0, 157054.0, 157054.0,
  ])
  assert_eq(locator.frequency(), @date.Year)
  assert_eq(
    locator.warnings().any(value => value is @date.IntervalFallback(_, _)),
    false,
  )
  assert_eq(locator.warnings().contains(@date.DistantMicroseconds), true)
}

