///|
test "auto locator reference: timezone PARIS/141 days, 0:00:00" {
  let locator = @date.AutoDateLocator::new(minticks=5, interval_multiples=true).with_timezone(
    @date.tzif_timezone(tzif_paris),
  )
  let selected = locator.get_locator_for_range(
    -25567.006493055556, -25426.006493055556,
  )
  assert_eq(locator.frequency(), @date.Day)
  assert_eq(selected.interval(), 1)
  assert_eq(selected.unit_scale(), 1.0)
  assert_eq(locator.tick_values(-25567.006493055556, -25426.006493055556), [
    -25567.006493055556, -25553.006493055556, -25536.006493055556, -25522.006493055556,
    -25508.006493055556, -25494.006493055556, -25477.006493055556, -25463.006493055556,
    -25447.006493055556, -25433.006493055556,
  ])
  assert_eq(locator.frequency(), @date.Day)
  assert_eq(
    locator.warnings().any(value => value is @date.IntervalFallback(_, _)),
    false,
  )
  assert_eq(locator.warnings().contains(@date.DistantMicroseconds), false)
}

