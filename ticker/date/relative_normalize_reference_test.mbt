      delta.month(),
      delta.day(),
      delta.hour(),
      delta.minute(),
      delta.second(),
      delta.microsecond(),
    ],
    [None, None, None, None, None, None, None],
  )
  assert_true(delta.weekday() is None)
  assert_eq(value.days(), -57102.0)
}

