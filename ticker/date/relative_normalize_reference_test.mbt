///|
test "relative delta original normalized 315" {
  let value = @date.RelativeDelta::new(
    day=31,
    leapdays=2.25,
    on_weekday=@date.RelativeWeekday::new(0, nth=0),
    days=1.5,
    hours=-37.25,
  )
  let delta = value.normalized()
  assert_eq(delta.years(), 0L)
  assert_eq(delta.months(), 0)
  assert_eq(
    [
      delta.days(),
      delta.leapdays(),
      delta.hours(),
      delta.minutes(),
      delta.seconds(),
      delta.microseconds(),
    ],
    [0.0, 2.25, -1.0, -15.0, 0.0, 0.0],
  )
  assert_eq(
    [
      delta.year(),
      delta.month(),
      delta.day(),
      delta.hour(),
      delta.minute(),
      delta.second(),
      delta.microsecond(),
    ],
    [None, None, Some(31), None, None, None, None],
  )
  assert_eq(delta.weekday().unwrap().weekday(), 0)
  assert_eq(delta.weekday().unwrap().nth(), Some(0))
  assert_eq(value.days(), 0.5)
}

