test "clock iteration original 149 valid early until Minutely cache False base True count None until 2023-12-31 12:00:00" {
  let wrapper = @date.RRuleWrapper::new(
    @date.Minutely,
    dtstart=@date.RRuleDateTime::naive(@date.parse_iso("2024-01-01T12:00:00")),
    interval=1440,
    cache=false,
    timezone=@date.fixed_timezone(0),
    until=@date.RRuleDateTime::naive(@date.parse_iso("2023-12-31T12:00:00")),
    byhour=[12],
    byminute=[0],
  )
  assert_eq(
    Some(
      wrapper
      .after(
        @date.RRuleDateTime::naive(@date.parse_iso("2024-01-01T12:00:00")),
        inc=true,
      )
      .map(wrapper_reference_fields),
    ) catch {
      _ => None
    },
    None,
  )
  let wrapper = @date.RRuleWrapper::new(
    @date.Minutely,
    dtstart=@date.RRuleDateTime::naive(@date.parse_iso("2024-01-01T12:00:00")),
    interval=1440,
    cache=false,
    timezone=@date.fixed_timezone(0),
    until=@date.RRuleDateTime::naive(@date.parse_iso("2023-12-31T12:00:00")),
    byhour=[12],
    byminute=[0],
  )
  assert_eq(
    Some(
      wrapper
      .after(
        @date.RRuleDateTime::naive(@date.parse_iso("2023-12-30T12:00:00")),
        inc=false,
      )
      .map(wrapper_reference_fields),
    ) catch {
      _ => None
    },
    None,
  )
  let wrapper = @date.RRuleWrapper::new(
    @date.Minutely,
    dtstart=@date.RRuleDateTime::naive(@date.parse_iso("2024-01-01T12:00:00")),
    interval=1440,
    cache=false,
    timezone=@date.fixed_timezone(0),
    until=@date.RRuleDateTime::naive(@date.parse_iso("2023-12-31T12:00:00")),
    byhour=[12],
    byminute=[0],
  )
  assert_eq(
    Some(
      wrapper
      .before(
        @date.RRuleDateTime::naive(@date.parse_iso("2023-12-30T12:00:00")),
        inc=false,
      )
      .map(wrapper_reference_fields),
    ) catch {
      _ => None
    },
    None,
  )
  let wrapper = @date.RRuleWrapper::new(
    @date.Minutely,
    dtstart=@date.RRuleDateTime::naive(@date.parse_iso("2024-01-01T12:00:00")),
    interval=1440,
    cache=false,
    timezone=@date.fixed_timezone(0),
    until=@date.RRuleDateTime::naive(@date.parse_iso("2023-12-31T12:00:00")),
    byhour=[12],
    byminute=[0],
  )
  assert_eq(
    Some(
      wrapper
      .before(
        @date.RRuleDateTime::naive(@date.parse_iso("2024-01-04T12:00:00")),
        inc=true,
      )
      .map(wrapper_reference_fields),
    ) catch {
      _ => None
    },
    None,
  )
  let wrapper = @date.RRuleWrapper::new(
    @date.Minutely,
    dtstart=@date.RRuleDateTime::naive(@date.parse_iso("2024-01-01T12:00:00")),
    interval=1440,
    cache=false,
    timezone=@date.fixed_timezone(0),
    until=@date.RRuleDateTime::naive(@date.parse_iso("2023-12-31T12:00:00")),
    byhour=[12],
    byminute=[0],
  )
  assert_eq(
    Some(
      wrapper
      .between(
        @date.RRuleDateTime::naive(@date.parse_iso("2023-12-30T12:00:00")),
        @date.RRuleDateTime::naive(@date.parse_iso("2024-01-01T12:00:00")),
        inc=false,
      )
      .map(wrapper_reference_fields),
    ) catch {
      _ => None
    },
    Some([]),
  )
  let wrapper = @date.RRuleWrapper::new(
    @date.Minutely,
    dtstart=@date.RRuleDateTime::naive(@date.parse_iso("2024-01-01T12:00:00")),
    interval=1440,
    cache=false,
    timezone=@date.fixed_timezone(0),
    until=@date.RRuleDateTime::naive(@date.parse_iso("2023-12-31T12:00:00")),
    byhour=[12],
    byminute=[0],
  )
  assert_eq(
    Some(
      wrapper
      .between(
        @date.RRuleDateTime::naive(@date.parse_iso("2024-01-04T12:00:00")),
        @date.RRuleDateTime::naive(@date.parse_iso("2023-12-30T12:00:00")),
        inc=true,
      )
      .map(wrapper_reference_fields),
    ) catch {
      _ => None
    },
    Some([]),
  )
  let wrapper = @date.RRuleWrapper::new(
    @date.Minutely,
    dtstart=@date.RRuleDateTime::naive(@date.parse_iso("2024-01-01T12:00:00")),
    interval=1440,
    cache=false,
    timezone=@date.fixed_timezone(0),
    until=@date.RRuleDateTime::naive(@date.parse_iso("2023-12-31T12:00:00")),
    byhour=[12],
    byminute=[0],
  )
  assert_eq(
    Some(
      wrapper
      .xafter(
        @date.RRuleDateTime::naive(@date.parse_iso("2024-01-01T12:00:00")),
        count=0,
        inc=true,
      )
      .map(wrapper_reference_fields),
    ) catch {
      _ => None
    },
    Some([]),
  )
  let wrapper = @date.RRuleWrapper::new(
    @date.Minutely,
    dtstart=@date.RRuleDateTime::naive(@date.parse_iso("2024-01-01T12:00:00")),
    interval=1440,
    cache=false,
    timezone=@date.fixed_timezone(0),
    until=@date.RRuleDateTime::naive(@date.parse_iso("2023-12-31T12:00:00")),
    byhour=[12],
    byminute=[0],
  )
  assert_eq(
    Some(
      wrapper
      .xafter(
        @date.RRuleDateTime::naive(@date.parse_iso("2024-01-01T12:00:00")),
        count=2,
        inc=true,
      )
      .map(wrapper_reference_fields),
    ) catch {
      _ => None
    },
    Some([]),
  )
  let wrapper = @date.RRuleWrapper::new(
    @date.Minutely,
    dtstart=@date.RRuleDateTime::naive(@date.parse_iso("2024-01-01T12:00:00")),
    interval=1440,
    cache=false,
    timezone=@date.fixed_timezone(0),
    until=@date.RRuleDateTime::naive(@date.parse_iso("2023-12-31T12:00:00")),
    byhour=[12],
    byminute=[0],
  )
  assert_eq(Some(wrapper.occurrence_count()) catch { _ => None }, Some(0L))
  let wrapper = @date.RRuleWrapper::new(
    @date.Minutely,
    dtstart=@date.RRuleDateTime::naive(@date.parse_iso("2024-01-01T12:00:00")),
    interval=1440,
    cache=false,
    timezone=@date.fixed_timezone(0),
    until=@date.RRuleDateTime::naive(@date.parse_iso("2023-12-31T12:00:00")),
    byhour=[12],
    byminute=[0],
  )
  let locator = @date.RRuleLocator::new(wrapper, tz="UTC")
  assert_eq(
    Some(
      locator.tick_values(
        @date.RRuleDateTime::naive(@date.parse_iso("2024-01-01T12:00:00")),
        @date.RRuleDateTime::naive(@date.parse_iso("2024-01-04T12:00:00")),
      ),
    ) catch {
      _ => None
    },
    Some([19723.5, 19724.5, 19725.5, 19726.5]),
  )
  let wrapper = @date.RRuleWrapper::new(
    @date.Minutely,
    dtstart=@date.RRuleDateTime::naive(@date.parse_iso("2024-01-01T12:00:00")),
    interval=1440,
    cache=false,
    timezone=@date.fixed_timezone(0),
    until=@date.RRuleDateTime::naive(@date.parse_iso("2023-12-31T12:00:00")),
    byhour=[12],
    byminute=[0],
  )
  let locator = @date.RRuleLocator::new(wrapper, tz="UTC")
  assert_eq(locator.as_locator().tick_values(19723.5, 19726.5), [
    19723.5, 19724.5, 19725.5, 19726.5,
  ])
  let wrapper = @date.RRuleWrapper::new(
    @date.Minutely,
    dtstart=@date.RRuleDateTime::naive(@date.parse_iso("2024-01-01T12:00:00")),
    interval=1440,
    cache=false,
    timezone=@date.fixed_timezone(0),
    until=@date.RRuleDateTime::naive(@date.parse_iso("2023-12-31T12:00:00")),
    byhour=[12],
    byminute=[0],
  )
  let reader = wrapper.checked_raw_iter()
  assert_eq(
    Some(reader.next().map(wrapper_reference_fields)) catch {
      _ => None
    },
    Some(None),
  )
  assert_eq(
    Some(reader.next().map(wrapper_reference_fields)) catch {
      _ => None
    },
    Some(None),
  )
  assert_eq(
    Some(reader.next().map(wrapper_reference_fields)) catch {
      _ => None
    },
    Some(None),
  )
}

