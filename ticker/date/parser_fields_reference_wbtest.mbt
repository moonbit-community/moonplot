// Generated by original default parser._parse with a fixed 2026 year pivot.

///|
test "parser field reference 0" {
  let result = try {
    let fields = parser_select("Thu Sep 25 10:36:28 2003", 2026)
    Some(
      (
        fields.year,
        fields.month,
        fields.day,
        fields.weekday,
        fields.hour,
        fields.minute,
        fields.second,
        fields.microsecond,
        fields.tzname,
        fields.tzoffset,
        fields.century,
        fields.ampm,
      ),
    )
  } catch {
    _ => None
  }
  assert_eq(
    result,
    Some(
      (
        Some(2003),
        Some(9),
        Some(25),
        Some(3),
        Some(10),
        Some(36),
        Some(28),
        Some(0),
        None,
        None,
        true,
        None,
      ),
    ),
  )
}

