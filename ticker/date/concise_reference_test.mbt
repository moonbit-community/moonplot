  ]
  assert_eq(formatter.format_ticks(values, inverted=false), [
    "Jan$\\mathdefault{{-}01}$", "$\\mathdefault{04{:}00}$", "$\\mathdefault{08{:}00}$",
    "$\\mathdefault{12{:}00}$", "$\\mathdefault{16{:}00}$", "$\\mathdefault{20{:}00}$",
    "Jan$\\mathdefault{{-}02}$", "$\\mathdefault{04{:}00}$", "$\\mathdefault{08{:}00}$",
    "$\\mathdefault{12{:}00}$", "$\\mathdefault{16{:}00}$",
