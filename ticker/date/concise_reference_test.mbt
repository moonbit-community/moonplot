    "03:00", "07:00", "11:00", "15:00", "19:00", "23:00", "03:00", "07:00", "11:00",
    "15:00", "19:00",
  ])
  assert_eq(formatter.get_offset(), "1997-Jan-02")
  assert_eq(formatter.format_value(values[0]), "1997")
  assert_eq(formatter.format_data_short(values[0]), "1997-01-01 03:00:00")
  let generic = formatter.as_formatter()
  assert_eq(generic.format_values(values, inverted=false), [
    "03:00", "07:00", "11:00", "15:00", "19:00", "23:00", "03:00", "07:00", "11:00",
    "15:00", "19:00",
