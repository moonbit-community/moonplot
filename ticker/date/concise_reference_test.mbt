///|
test "concise reference: microseconds custom suffix prevents trimming" {
  let formatter = @date.concise_date_formatter(formats=[
    "%Y", "%m/%Y", "day: %d", "%H hr %M min", "%H hr %M min", "%S.%f sec",
  ])
  let values = [9862.0, 9862.00000011574, 9862.000001157408]
  assert_eq(formatter.format_ticks(values, inverted=false), [
    "00 hr 00 min", "00.010000 sec", "00.100000 sec",
  ])
  assert_eq(formatter.get_offset(), "1997-Jan-01 00:00")
  assert_eq(formatter.format_value(values[0]), "1997")
  assert_eq(formatter.format_data_short(values[0]), "1997-01-01 00:00:00")
  let generic = formatter.as_formatter()
  assert_eq(generic.format_values(values, inverted=false), [
    "00 hr 00 min", "00.010000 sec", "00.100000 sec",
  ])
  assert_eq(generic.offset_label(values, inverted=false), "1997-Jan-01 00:00")
}

///|
test "concise reference: NY / 2024-03-10T06:00:00+00:00" {
  let formatter = @date.concise_date_formatter().with_timezone(
    @date.tzif_timezone(tzif_new_york),
  )
  let values = [
    19792.25, 19792.270833333332, 19792.291666666668, 19792.3125, 19792.333333333332,
    19792.354166666668,
  ]
  assert_eq(formatter.format_ticks(values, inverted=false), [
    "01:00", "01:30", "03:00", "03:30", "04:00", "04:30",
  ])
  assert_eq(formatter.get_offset(), "2024-Mar-10")
  assert_eq(formatter.format_value(values[0]), "2024")
  assert_eq(formatter.format_data_short(values[0]), "2024-03-10 01:00:00")
  let generic = formatter.as_formatter()
  assert_eq(generic.format_values(values, inverted=false), [
    "01:00", "01:30", "03:00", "03:30", "04:00", "04:30",
  ])
  assert_eq(generic.offset_label(values, inverted=false), "2024-Mar-10")
}

///|
test "concise reference: NY / exact offset labels / 2024-03-10T06:00:00+00:00" {
  let formatter = @date.concise_date_formatter(formats=[
    "%Y", "%b", "%d", "%H:%M %Z %z", "%H:%M %Z %z", "%S.%f %Z %z",
  ]).with_timezone(@date.tzif_timezone(tzif_new_york))
  let values = [
    19792.25, 19792.270833333332, 19792.291666666668, 19792.3125, 19792.333333333332,
    19792.354166666668,
  ]
  assert_eq(formatter.format_ticks(values, inverted=false), [
    "01:00 EST -0500", "01:30 EST -0500", "03:00 EDT -0400", "03:30 EDT -0400", "04:00 EDT -0400",
    "04:30 EDT -0400",
  ])
  assert_eq(formatter.get_offset(), "2024-Mar-10")
  assert_eq(formatter.format_value(values[0]), "2024")
  assert_eq(formatter.format_data_short(values[0]), "2024-03-10 01:00:00")
  let generic = formatter.as_formatter()
  assert_eq(generic.format_values(values, inverted=false), [
    "01:00 EST -0500", "01:30 EST -0500", "03:00 EDT -0400", "03:30 EDT -0400", "04:00 EDT -0400",
    "04:30 EDT -0400",
  ])
  assert_eq(generic.offset_label(values, inverted=false), "2024-Mar-10")
}

