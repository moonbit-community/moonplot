    "Jan-01", "04:00", "08:00", "12:00", "16:00", "20:00", "Jan-02", "04:00", "08:00",
    "12:00", "16:00",
  ])
  assert_eq(formatter.get_offset(), "1997-Jan-02")
  assert_eq(formatter.format_value(values[0]), "1997")
  assert_eq(formatter.format_data_short(values[0]), "1997-01-01 00:00:00")
  let generic = formatter.as_formatter()
  assert_eq(generic.format_values(values, inverted=false), [
    "Jan-01", "04:00", "08:00", "12:00", "16:00", "20:00", "Jan-02", "04:00", "08:00",
    "12:00", "16:00",
  ])
  assert_eq(generic.offset_label(values, inverted=false), "1997-Jan-02")
}

