    formatter.get_offset(),
    "$\\mathdefault{1997{-}}$Jan$\\mathdefault{{-}02}$",
  )
  assert_eq(formatter.format_value(values[0]), "$\\mathdefault{1997}$")
  assert_eq(formatter.format_data_short(values[0]), "1997-01-01 00:00:00")
