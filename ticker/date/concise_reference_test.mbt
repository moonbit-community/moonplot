///|
test "concise reference: literal unicode punctuation and tex" {
  let formatter = @date.concise_date_formatter(
    formats=["年%Y", "%b", "%d", "α %H:%M", "%H:%M", "β%S.%f-xy"],
    zero_formats=["", "%Y", "%b", "%d", "%H:%M", "z %H:%M"],
    usetex=true,
  )
  let values = [
    9861.999994212963, 9862.0, 9862.000005787037, 9862.000011574075, 9862.000017361112,
    9862.000023148148, 9862.000028935185,
  ]
  assert_eq(formatter.format_ticks(values, inverted=false), [
    "$\\mathdefault{β59.500000{-}}$xy", "z$\\mathdefault{\\;00{:}00}$", "$\\mathdefault{β00.500000{-}}$xy",
    "$\\mathdefault{β01.000000{-}}$xy", "$\\mathdefault{β01.500000{-}}$xy", "$\\mathdefault{β02.000000{-}}$xy",
    "$\\mathdefault{β02.500000{-}}$xy",
  ])
  assert_eq(
    formatter.get_offset(),
    "$\\mathdefault{1997{-}}$Jan$\\mathdefault{{-}01\\;00{:}00}$",
  )
  assert_eq(formatter.format_value(values[0]), "$\\mathdefault{1996}$")
  assert_eq(formatter.format_data_short(values[0]), "1996-12-31 23:59:59")
  let generic = formatter.as_formatter()
  assert_eq(generic.format_values(values, inverted=false), [
    "$\\mathdefault{β59.500000{-}}$xy", "z$\\mathdefault{\\;00{:}00}$", "$\\mathdefault{β00.500000{-}}$xy",
    "$\\mathdefault{β01.000000{-}}$xy", "$\\mathdefault{β01.500000{-}}$xy", "$\\mathdefault{β02.000000{-}}$xy",
    "$\\mathdefault{β02.500000{-}}$xy",
  ])
  assert_eq(
    generic.offset_label(values, inverted=false),
    "$\\mathdefault{1997{-}}$Jan$\\mathdefault{{-}01\\;00{:}00}$",
  )
}

///|
test "concise reference: multiple dots and shared trailing zeros" {
  let formatter = @date.concise_date_formatter(formats=[
    "%Y", "%b", "%d", "%H:%M", "%H:%M", "%S.%f.000",
  ])
  let values = [
    9861.999994212963, 9862.0, 9862.000005787037, 9862.000011574075, 9862.000017361112,
    9862.000023148148, 9862.000028935185,
  ]
  assert_eq(formatter.format_ticks(values, inverted=false), [
    "59.500000", "00:00", "00.500000", "01.000000", "01.500000", "02.000000", "02.500000",
  ])
  assert_eq(formatter.get_offset(), "1997-Jan-01 00:00")
  assert_eq(formatter.format_value(values[0]), "1996")
  assert_eq(formatter.format_data_short(values[0]), "1996-12-31 23:59:59")
  let generic = formatter.as_formatter()
  assert_eq(generic.format_values(values, inverted=false), [
    "59.500000", "00:00", "00.500000", "01.000000", "01.500000", "02.000000", "02.500000",
  ])
  assert_eq(generic.offset_label(values, inverted=false), "1997-Jan-01 00:00")
}
