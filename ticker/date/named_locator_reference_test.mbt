  assert_eq(
    wrapper.raw_iter().take(3).to_array().map(wrapper_reference_fields),
    [
      [0, 2024, 1, 31, 6, 7, 6, 0, 0],
      [0, 2024, 1, 31, 6, 7, 7, 0, 0],
      [0, 2024, 1, 31, 6, 7, 8, 0, 0],
    ],
  )
  let restored = shifted.with_timezone(zone_utc)
  assert_eq(
    restored.as_locator().tick_values(19753.129989854813, 19753.130047725186),
    [
      19753.13, 19753.130011574074, 19753.130023148147, 19753.13003472222, 19753.130046296297,
    ],
  )
  assert_eq(calls.val, 1)
  assert_true(wrapper.frequency() is @date.Secondly)
  assert_eq(locator.interval(), 1)
  assert_eq(copy.interval(), 1)
  assert_eq(copy.unit_scale(), 1.1574074074074073e-05)
  assert_eq(wrapper.timezone() is Some(_), true)
  assert_eq(wrapper_reference_fields(wrapper.dtstart()), [
    0, 2024, 1, 31, 3, 7, 6, 0, 0,
  ])
  assert_eq(
    wrapper.until().map(wrapper_reference_fields),
    Some([0, 2024, 1, 31, 3, 7, 21, 123456, 0]),
  )
  assert_eq(
    wrapper.raw_iter().take(3).to_array().map(wrapper_reference_fields),
    [
      [0, 2024, 1, 31, 3, 7, 6, 0, 0],
      [0, 2024, 1, 31, 3, 7, 7, 0, 0],
      [0, 2024, 1, 31, 3, 7, 8, 0, 0],
    ],
  )
}

