///|
test "named locator original 94 Day invalid interval before clock" {
  let previous_rc = @config.timezone()
  defer @config.set_timezone(previous_rc)
  @config.set_timezone("UTC")
  let calls = Ref(0)
  let context = @date.DateParserContext::utc(clock=fn() {
    let now = 1781524800123L + Int64::from_int(calls.val) * 86400000L
    calls.val += 1
    now
  })
  assert_true(
    try {
      ignore(
        @date.DayLocator::new(interval=0, context~, tz="invalid/D17-reference"),
      )
      false
    } catch {
      _ => true
    },
  )
  assert_eq(calls.val, 0)
}

///|
test "named locator original 95 Day negative interval before clock" {
  let previous_rc = @config.timezone()
  defer @config.set_timezone(previous_rc)
  @config.set_timezone("UTC")
  let zone_utc = @date.get_timezone(name="UTC")
  let calls = Ref(0)
  let context = @date.DateParserContext::utc(clock=fn() {
    let now = 1781524800123L + Int64::from_int(calls.val) * 86400000L
    calls.val += 1
    now
  })
  ignore(zone_utc)
  assert_true(
    try {
      ignore(@date.DayLocator::new(interval=-1, context~, timezone=zone_utc))
      false
    } catch {
      _ => true
    },
  )
  assert_eq(calls.val, 0)
}

