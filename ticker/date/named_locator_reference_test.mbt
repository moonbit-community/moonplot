      [0, 2024, 1, 31, 3, 7, 7, 0, 0],
      [0, 2024, 1, 31, 3, 7, 8, 0, 0],
    ],
  )
  let shifted = locator.with_offset(180)
  assert_eq(shifted.timezone().initial_offset_seconds(), 10800)
  assert_eq(
    shifted.as_locator().tick_values(19753.129989854813, 19753.130047725186),
    [
      19753.13, 19753.130011574074, 19753.130023148147, 19753.13003472222, 19753.130046296297,
