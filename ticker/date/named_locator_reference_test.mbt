///|
test "named locator original 33 Day defaults aware False display UTC" {
  let previous_rc = @config.timezone()
  defer @config.set_timezone(previous_rc)
  @config.set_timezone("UTC")
  let zone_utc = @date.get_timezone(name="UTC")
  let calls = Ref(0)
  let context = @date.DateParserContext::utc(clock=fn() {
    let now = 1781524800123L + Int64::from_int(calls.val) * 86400000L
    calls.val += 1
    now
  })
  let locator = @date.DayLocator::new(context~, timezone=zone_utc)
  let wrapper = locator.rule()
  let generic = locator.as_rrule_locator()
  let adapter = locator.as_locator()
  let copy = adapter.copy()
  @config.set_timezone("UTC")
  assert_eq(calls.val, 1)
  assert_true(wrapper.frequency() is @date.Daily)
  assert_eq(locator.interval(), 1)
  assert_eq(copy.interval(), 1)
  assert_eq(copy.unit_scale(), 1.0)
  assert_eq(wrapper.timezone() is Some(_), false)
  assert_eq(wrapper_reference_fields(wrapper.dtstart()), [
    0, 2026, 6, 15, 12, 0, 0, 0, 0,
  ])
  assert_eq(wrapper.until().map(wrapper_reference_fields), None)
  assert_eq(
    wrapper.raw_iter().take(3).to_array().map(wrapper_reference_fields),
    [
      [0, 2026, 6, 16, 0, 0, 0, 0, 0],
      [0, 2026, 6, 17, 0, 0, 0, 0, 0],
      [0, 2026, 6, 18, 0, 0, 0, 0, 0],
    ],
  )
  assert_eq(
    Some(
      locator.tick_values(
        @date.RRuleDateTime::naive(
          @date.parse_iso("2024-01-31T03:07:11.123456"),
        ),
        @date.RRuleDateTime::naive(
          @date.parse_iso("2024-02-10T03:07:11.123456"),
        ),
      ),
    ) catch {
      _ => None
    },
    Some([
      19754.0, 19755.0, 19756.0, 19757.0, 19758.0, 19759.0, 19760.0, 19761.0, 19762.0,
      19763.0,
    ]),
  )
  assert_eq(
    Some(
      generic.tick_values(
        @date.RRuleDateTime::naive(
          @date.parse_iso("2024-01-31T03:07:11.123456"),
        ),
        @date.RRuleDateTime::naive(
          @date.parse_iso("2024-02-10T03:07:11.123456"),
        ),
      ),
    ) catch {
      _ => None
    },
