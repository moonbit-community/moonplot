// Generated six original Matplotlib locator classes, timezone helper and core recurrence.

///|
test "named locator original 0 Month defaults aware False display UTC" {
  let previous_rc = @config.timezone()
  defer @config.set_timezone(previous_rc)
  @config.set_timezone("UTC")
  let zone_utc = @date.get_timezone(name="UTC")
  let calls = Ref(0)
  let context = @date.DateParserContext::utc(clock=fn() {
    let now = 1781524800123L + Int64::from_int(calls.val) * 86400000L
    calls.val += 1
    now
  })
  let locator = @date.MonthLocator::new(context~, timezone=zone_utc)
  let wrapper = locator.rule()
  let generic = locator.as_rrule_locator()
  let adapter = locator.as_locator()
  let copy = adapter.copy()
  @config.set_timezone("UTC")
  assert_eq(calls.val, 1)
  assert_true(wrapper.frequency() is @date.Monthly)
  assert_eq(locator.interval(), 1)
  assert_eq(copy.interval(), 1)
  assert_eq(copy.unit_scale(), 30.0)
  assert_eq(wrapper.timezone() is Some(_), false)
  assert_eq(wrapper_reference_fields(wrapper.dtstart()), [
    0, 2026, 6, 15, 12, 0, 0, 0, 0,
  ])
  assert_eq(wrapper.until().map(wrapper_reference_fields), None)
  assert_eq(
    wrapper.raw_iter().take(3).to_array().map(wrapper_reference_fields),
    [
      [0, 2026, 7, 1, 0, 0, 0, 0, 0],
      [0, 2026, 8, 1, 0, 0, 0, 0, 0],
      [0, 2026, 9, 1, 0, 0, 0, 0, 0],
    ],
  )
  assert_eq(
    Some(
      locator.tick_values(
        @date.RRuleDateTime::naive(
          @date.parse_iso("2024-01-31T03:07:11.123456"),
        ),
        @date.RRuleDateTime::naive(
          @date.parse_iso("2024-05-10T03:07:11.123456"),
        ),
      ),
    ) catch {
      _ => None
    },
    Some([19754.0, 19783.0, 19814.0, 19844.0]),
  )
  assert_eq(
    Some(
      generic.tick_values(
        @date.RRuleDateTime::naive(
          @date.parse_iso("2024-01-31T03:07:11.123456"),
        ),
        @date.RRuleDateTime::naive(
          @date.parse_iso("2024-05-10T03:07:11.123456"),
        ),
      ),
    ) catch {
      _ => None
    },
    Some([19754.0, 19783.0, 19814.0, 19844.0]),
  )
  assert_eq(calls.val, 1)
  assert_true(wrapper.frequency() is @date.Monthly)
  assert_eq(locator.interval(), 1)
  assert_eq(copy.interval(), 1)
  assert_eq(copy.unit_scale(), 30.0)
  assert_eq(wrapper.timezone() is Some(_), false)
  assert_eq(wrapper_reference_fields(wrapper.dtstart()), [
    0, 2023, 10, 21, 3, 7, 11, 0, 0,
  ])
  assert_eq(
    wrapper.until().map(wrapper_reference_fields),
    Some([0, 2024, 8, 20, 3, 7, 11, 123456, 0]),
  )
  assert_eq(
    wrapper.raw_iter().take(3).to_array().map(wrapper_reference_fields),
    [
      [0, 2023, 11, 1, 0, 0, 0, 0, 0],
      [0, 2023, 12, 1, 0, 0, 0, 0, 0],
      [0, 2024, 1, 1, 0, 0, 0, 0, 0],
    ],
  )
  assert_eq(adapter.tick_values(19753.129989854813, 19853.129989854813), [
    19754.0, 19783.0, 19814.0, 19844.0,
  ])
  assert_eq(calls.val, 1)
  assert_true(wrapper.frequency() is @date.Monthly)
  assert_eq(locator.interval(), 1)
  assert_eq(copy.interval(), 1)
  assert_eq(copy.unit_scale(), 30.0)
  assert_eq(wrapper.timezone() is Some(_), true)
  assert_eq(wrapper_reference_fields(wrapper.dtstart()), [
    0, 2023, 10, 21, 3, 7, 11, 0, 0,
  ])
  assert_eq(
    wrapper.until().map(wrapper_reference_fields),
    Some([0, 2024, 8, 20, 3, 7, 11, 123456, 0]),
  )
  assert_eq(
    wrapper.raw_iter().take(3).to_array().map(wrapper_reference_fields),
    [
      [0, 2023, 11, 1, 0, 0, 0, 0, 0],
      [0, 2023, 12, 1, 0, 0, 0, 0, 0],
      [0, 2024, 1, 1, 0, 0, 0, 0, 0],
    ],
  )
  let shifted = locator.with_offset(180)
  assert_eq(shifted.timezone().initial_offset_seconds(), 10800)
  assert_eq(
    shifted.as_locator().tick_values(19753.129989854813, 19853.129989854813),
    [19753.875, 19782.875, 19813.875, 19843.875],
  )
  assert_eq(calls.val, 1)
  assert_true(wrapper.frequency() is @date.Monthly)
  assert_eq(locator.interval(), 1)
  assert_eq(copy.interval(), 1)
  assert_eq(copy.unit_scale(), 30.0)
  assert_eq(wrapper.timezone() is Some(_), true)
  assert_eq(wrapper_reference_fields(wrapper.dtstart()), [
    0, 2023, 10, 21, 6, 7, 11, 0, 0,
  ])
  assert_eq(
    wrapper.until().map(wrapper_reference_fields),
    Some([0, 2024, 8, 20, 6, 7, 11, 123456, 0]),
  )
  assert_eq(
    wrapper.raw_iter().take(3).to_array().map(wrapper_reference_fields),
    [
      [0, 2023, 11, 1, 0, 0, 0, 0, 0],
      [0, 2023, 12, 1, 0, 0, 0, 0, 0],
      [0, 2024, 1, 1, 0, 0, 0, 0, 0],
    ],
  )
  let restored = shifted.with_timezone(zone_utc)
  assert_eq(
    restored.as_locator().tick_values(19753.129989854813, 19853.129989854813),
    [19754.0, 19783.0, 19814.0, 19844.0],
  )
  assert_eq(calls.val, 1)
  assert_true(wrapper.frequency() is @date.Monthly)
  assert_eq(locator.interval(), 1)
  assert_eq(copy.interval(), 1)
  assert_eq(copy.unit_scale(), 30.0)
  assert_eq(wrapper.timezone() is Some(_), true)
  assert_eq(wrapper_reference_fields(wrapper.dtstart()), [
    0, 2023, 10, 21, 3, 7, 11, 0, 0,
  ])
  assert_eq(
    wrapper.until().map(wrapper_reference_fields),
    Some([0, 2024, 8, 20, 3, 7, 11, 123456, 0]),
  )
  assert_eq(
    wrapper.raw_iter().take(3).to_array().map(wrapper_reference_fields),
    [
      [0, 2023, 11, 1, 0, 0, 0, 0, 0],
      [0, 2023, 12, 1, 0, 0, 0, 0, 0],
      [0, 2024, 1, 1, 0, 0, 0, 0, 0],
    ],
  )
}

///|
test "named locator original 1 Month defaults aware False display FIX" {
  let previous_rc = @config.timezone()
  defer @config.set_timezone(previous_rc)
  @config.set_timezone("UTC")
  let zone_fix = @date.fixed_timezone_seconds(561)
  let calls = Ref(0)
  let context = @date.DateParserContext::utc(clock=fn() {
    let now = 1781524800123L + Int64::from_int(calls.val) * 86400000L
    calls.val += 1
    now
  })
  let locator = @date.MonthLocator::new(context~, timezone=zone_fix)
  let wrapper = locator.rule()
  let generic = locator.as_rrule_locator()
  let adapter = locator.as_locator()
  let copy = adapter.copy()
  @config.set_timezone("UTC")
  assert_eq(calls.val, 1)
  assert_true(wrapper.frequency() is @date.Monthly)
  assert_eq(locator.interval(), 1)
  assert_eq(copy.interval(), 1)
  assert_eq(copy.unit_scale(), 30.0)
  assert_eq(wrapper.timezone() is Some(_), false)
  assert_eq(wrapper_reference_fields(wrapper.dtstart()), [
    0, 2026, 6, 15, 12, 0, 0, 0, 0,
  ])
  assert_eq(wrapper.until().map(wrapper_reference_fields), None)
  assert_eq(
    wrapper.raw_iter().take(3).to_array().map(wrapper_reference_fields),
    [
      [0, 2026, 7, 1, 0, 0, 0, 0, 0],
      [0, 2026, 8, 1, 0, 0, 0, 0, 0],
      [0, 2026, 9, 1, 0, 0, 0, 0, 0],
    ],
  )
  assert_eq(
    Some(
      locator.tick_values(
        @date.RRuleDateTime::naive(
          @date.parse_iso("2024-01-31T03:07:11.123456"),
        ),
        @date.RRuleDateTime::naive(
          @date.parse_iso("2024-05-10T03:07:11.123456"),
        ),
      ),
    ) catch {
      _ => None
    },
    Some([19754.0, 19783.0, 19814.0, 19844.0]),
  )
  assert_eq(
    Some(
      generic.tick_values(
        @date.RRuleDateTime::naive(
          @date.parse_iso("2024-01-31T03:07:11.123456"),
        ),
        @date.RRuleDateTime::naive(
          @date.parse_iso("2024-05-10T03:07:11.123456"),
        ),
      ),
    ) catch {
      _ => None
    },
    Some([19754.0, 19783.0, 19814.0, 19844.0]),
  )
  assert_eq(calls.val, 1)
  assert_true(wrapper.frequency() is @date.Monthly)
  assert_eq(locator.interval(), 1)
  assert_eq(copy.interval(), 1)
  assert_eq(copy.unit_scale(), 30.0)
  assert_eq(wrapper.timezone() is Some(_), false)
  assert_eq(wrapper_reference_fields(wrapper.dtstart()), [
    0, 2023, 10, 21, 3, 7, 11, 0, 0,
  ])
  assert_eq(
    wrapper.until().map(wrapper_reference_fields),
    Some([0, 2024, 8, 20, 3, 7, 11, 123456, 0]),
  )
  assert_eq(
    wrapper.raw_iter().take(3).to_array().map(wrapper_reference_fields),
    [
      [0, 2023, 11, 1, 0, 0, 0, 0, 0],
      [0, 2023, 12, 1, 0, 0, 0, 0, 0],
      [0, 2024, 1, 1, 0, 0, 0, 0, 0],
    ],
  )
  assert_eq(adapter.tick_values(19753.129989854813, 19853.129989854813), [
    19753.993506944444, 19782.993506944444, 19813.993506944444, 19843.993506944444,
  ])
  assert_eq(calls.val, 1)
  assert_true(wrapper.frequency() is @date.Monthly)
  assert_eq(locator.interval(), 1)
  assert_eq(copy.interval(), 1)
  assert_eq(copy.unit_scale(), 30.0)
  assert_eq(wrapper.timezone() is Some(_), true)
  assert_eq(wrapper_reference_fields(wrapper.dtstart()), [
    0, 2023, 10, 21, 3, 16, 32, 0, 0,
  ])
  assert_eq(
    wrapper.until().map(wrapper_reference_fields),
    Some([0, 2024, 8, 20, 3, 16, 32, 123456, 0]),
  )
  assert_eq(
    wrapper.raw_iter().take(3).to_array().map(wrapper_reference_fields),
    [
      [0, 2023, 11, 1, 0, 0, 0, 0, 0],
      [0, 2023, 12, 1, 0, 0, 0, 0, 0],
      [0, 2024, 1, 1, 0, 0, 0, 0, 0],
