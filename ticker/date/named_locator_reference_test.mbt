///|
test "named locator original 102 Month transition NY 2024-11-03T00:00:00" {
  let previous_rc = @config.timezone()
  defer @config.set_timezone(previous_rc)
  @config.set_timezone("UTC")
  @date.register_timezone("D17/reference-NY", tzif_new_york)
  defer @date.unregister_timezone("D17/reference-NY")
  let zone_ny = @date.get_timezone(name="D17/reference-NY")
  let calls = Ref(0)
  let context = @date.DateParserContext::utc(clock=fn() {
    let now = 1781524800123L + Int64::from_int(calls.val) * 86400000L
    calls.val += 1
    now
  })
  let locator = @date.MonthLocator::new(context~, timezone=zone_ny)
  let wrapper = locator.rule()
  let generic = locator.as_rrule_locator()
  let adapter = locator.as_locator()
  let copy = adapter.copy()
  @config.set_timezone("UTC")
  assert_eq(calls.val, 1)
  assert_true(wrapper.frequency() is @date.Monthly)
  assert_eq(locator.interval(), 1)
  assert_eq(copy.interval(), 1)
  assert_eq(copy.unit_scale(), 30.0)
  assert_eq(wrapper.timezone() is Some(_), false)
  assert_eq(wrapper_reference_fields(wrapper.dtstart()), [
    0, 2026, 6, 15, 12, 0, 0, 0, 0,
  ])
  assert_eq(wrapper.until().map(wrapper_reference_fields), None)
  assert_eq(
    wrapper.raw_iter().take(3).to_array().map(wrapper_reference_fields),
    [
      [0, 2026, 7, 1, 0, 0, 0, 0, 0],
      [0, 2026, 8, 1, 0, 0, 0, 0, 0],
      [0, 2026, 9, 1, 0, 0, 0, 0, 0],
    ],
  )
  assert_eq(
    Some(
      locator.tick_values(
        @date.RRuleDateTime::from_local(
          @date.parse_iso("2024-11-03T00:00:00"),
          zone_ny,
          fold=false,
        ),
        @date.RRuleDateTime::from_local(
          @date.parse_iso("2024-11-03T04:00:00"),
          zone_ny,
          fold=false,
        ),
      ),
    ) catch {
      _ => None
    },
    Some([20030.166666666668, 20030.375]),
  )
  assert_eq(
    Some(
      generic.tick_values(
        @date.RRuleDateTime::from_local(
          @date.parse_iso("2024-11-03T00:00:00"),
          zone_ny,
          fold=false,
        ),
        @date.RRuleDateTime::from_local(
          @date.parse_iso("2024-11-03T04:00:00"),
          zone_ny,
          fold=false,
        ),
      ),
    ) catch {
      _ => None
    },
    Some([20030.166666666668, 20030.375]),
  )
  assert_eq(calls.val, 1)
  assert_true(wrapper.frequency() is @date.Monthly)
  assert_eq(locator.interval(), 1)
  assert_eq(copy.interval(), 1)
  assert_eq(copy.unit_scale(), 30.0)
  assert_eq(wrapper.timezone() is Some(_), true)
  assert_eq(wrapper_reference_fields(wrapper.dtstart()), [
    0, 2024, 11, 2, 20, 0, 0, 0, 0,
  ])
  assert_eq(
    wrapper.until().map(wrapper_reference_fields),
    Some([0, 2024, 11, 3, 8, 0, 0, 0, 0]),
  )
  assert_eq(
    wrapper.raw_iter().take(3).to_array().map(wrapper_reference_fields),
    [],
  )
  assert_eq(adapter.tick_values(20030.166666666668, 20030.375), [
    20030.166666666668, 20030.375,
  ])
  assert_eq(calls.val, 1)
  assert_true(wrapper.frequency() is @date.Monthly)
  assert_eq(locator.interval(), 1)
  assert_eq(copy.interval(), 1)
  assert_eq(copy.unit_scale(), 30.0)
  assert_eq(wrapper.timezone() is Some(_), true)
  assert_eq(wrapper_reference_fields(wrapper.dtstart()), [
    0, 2024, 11, 2, 20, 0, 0, 0, 0,
  ])
  assert_eq(
    wrapper.until().map(wrapper_reference_fields),
    Some([0, 2024, 11, 3, 8, 0, 0, 0, 0]),
  )
  assert_eq(
    wrapper.raw_iter().take(3).to_array().map(wrapper_reference_fields),
    [],
  )
}

///|
test "named locator original 103 Weekday transition NY 2024-11-03T00:00:00" {
  let previous_rc = @config.timezone()
  defer @config.set_timezone(previous_rc)
  @config.set_timezone("UTC")
  @date.register_timezone("D17/reference-NY", tzif_new_york)
  defer @date.unregister_timezone("D17/reference-NY")
  let zone_ny = @date.get_timezone(name="D17/reference-NY")
  let calls = Ref(0)
  let context = @date.DateParserContext::utc(clock=fn() {
    let now = 1781524800123L + Int64::from_int(calls.val) * 86400000L
    calls.val += 1
    now
  })
  let locator = @date.WeekdayLocator::new(context~, timezone=zone_ny)
  let wrapper = locator.rule()
  let generic = locator.as_rrule_locator()
  let adapter = locator.as_locator()
  let copy = adapter.copy()
  @config.set_timezone("UTC")
  assert_eq(calls.val, 1)
