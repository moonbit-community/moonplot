  assert_eq(wrapper.timezone() is Some(_), true)
  assert_eq(wrapper_reference_fields(wrapper.dtstart()), [
    0, 2024, 1, 21, 6, 7, 11, 0, 0,
  ])
  assert_eq(
    wrapper.until().map(wrapper_reference_fields),
    Some([0, 2024, 2, 20, 6, 7, 11, 123456, 0]),
  )
  assert_eq(
    wrapper.raw_iter().take(3).to_array().map(wrapper_reference_fields),
    [
      [0, 2024, 1, 22, 0, 0, 0, 0, 0],
      [0, 2024, 1, 23, 0, 0, 0, 0, 0],
      [0, 2024, 1, 24, 0, 0, 0, 0, 0],
    ],
  )
  let restored = shifted.with_timezone(zone_utc)
  assert_eq(
    restored.as_locator().tick_values(19753.129989854813, 19763.129989854813),
    [
      19754.0, 19755.0, 19756.0, 19757.0, 19758.0, 19759.0, 19760.0, 19761.0, 19762.0,
      19763.0,
    ],
  )
  assert_eq(calls.val, 1)
  assert_true(wrapper.frequency() is @date.Daily)
  assert_eq(locator.interval(), 1)
  assert_eq(copy.interval(), 1)
  assert_eq(copy.unit_scale(), 1.0)
  assert_eq(wrapper.timezone() is Some(_), true)
  assert_eq(wrapper_reference_fields(wrapper.dtstart()), [
    0, 2024, 1, 21, 3, 7, 11, 0, 0,
  ])
  assert_eq(
    wrapper.until().map(wrapper_reference_fields),
    Some([0, 2024, 2, 20, 3, 7, 11, 123456, 0]),
  )
  assert_eq(
    wrapper.raw_iter().take(3).to_array().map(wrapper_reference_fields),
    [
      [0, 2024, 1, 22, 0, 0, 0, 0, 0],
      [0, 2024, 1, 23, 0, 0, 0, 0, 0],
      [0, 2024, 1, 24, 0, 0, 0, 0, 0],
    ],
  )
}

