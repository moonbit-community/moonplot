///|
test "parser tagged YMD reference 0" {
  let result = try {
    let ymd = parser_ymd()
    Some((ymd.resolve(), ymd.century))
  } catch {
    _ => None
  }
  assert_eq(result, Some(((None, None, None), false)))
}

///|
test "parser tagged YMD reference 1" {
  let result = try {
    let ymd = parser_ymd()
    ymd.append_text("1")
    Some((ymd.resolve(), ymd.century))
  } catch {
    _ => None
  }
  assert_eq(result, Some(((None, None, Some(1)), false)))
}

