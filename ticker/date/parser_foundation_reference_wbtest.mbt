  for (values, expected) in cases {
    let result = try {
      let ymd = parser_ymd()
      for value in values {
        ymd.append_number(value)
      }
      Some(ymd.resolve(yearfirst=true, dayfirst=true))
    } catch {
      _ => None
    }
    assert_eq((values, result), (values, expected))
  }
