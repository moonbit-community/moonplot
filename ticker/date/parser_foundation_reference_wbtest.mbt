///|
test "parser numeric YMD reference False/True/0" {
  let cases : Array[(Array[Int32], (Int32?, Int32?, Int32?)?)] = [
    ([], Some((None, None, None))),
  ]
  for (values, expected) in cases {
    let result = try {
      let ymd = parser_ymd()
      for value in values {
        ymd.append_number(value)
      }
      Some(ymd.resolve(yearfirst=false, dayfirst=true))
    } catch {
      _ => None
    }
    assert_eq((values, result), (values, expected))
  }
}

