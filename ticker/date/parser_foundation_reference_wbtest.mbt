  for (values, expected) in cases {
    let result = try {
      let ymd = parser_ymd()
      for value in values {
        ymd.append_number(value)
      }
      Some(ymd.resolve(yearfirst=true, dayfirst=false))
    } catch {
      _ => None
    }
    assert_eq((values, result), (values, expected))
  }
}

///|
test "parser numeric YMD reference True/True/0" {
  let cases : Array[(Array[Int32], (Int32?, Int32?, Int32?)?)] = [
    ([], Some((None, None, None))),
  ]
  for (values, expected) in cases {
    let result = try {
      let ymd = parser_ymd()
      for value in values {
        ymd.append_number(value)
      }
      Some(ymd.resolve(yearfirst=true, dayfirst=true))
    } catch {
      _ => None
    }
    assert_eq((values, result), (values, expected))
  }
}

///|
test "parser numeric YMD reference True/True/1" {
  let cases : Array[(Array[Int32], (Int32?, Int32?, Int32?)?)] = [
    ([1], Some((None, None, Some(1)))),
    ([12], Some((None, None, Some(12)))),
    ([13], Some((None, None, Some(13)))),
    ([31], Some((None, None, Some(31)))),
