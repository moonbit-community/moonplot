  ymd.append_number(2024, label=Y)
  ymd.append_number(2, label=M)
  ymd.append_number(29, label=D)
  assert_eq(
    [-1, 0, 1, 28, 29, 30, 31, 32].map(value => ymd.could_be_day(value)),
    [false, false, false, false, false, false, false, false],
  )
}
