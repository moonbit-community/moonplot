///|
test "parser day feasibility reference 0" {
  let ymd = parser_ymd()
  assert_eq(
    [-1, 0, 1, 28, 29, 30, 31, 32].map(value => ymd.could_be_day(value)),
    [false, false, true, true, true, true, true, false],
  )
}

///|
test "parser day feasibility reference 1" {
  let ymd = parser_ymd()
  ymd.append_number(2, label=M)
  assert_eq(
    [-1, 0, 1, 28, 29, 30, 31, 32].map(value => ymd.could_be_day(value)),
    [false, false, true, true, true, false, false, false],
  )
}

///|
test "parser day feasibility reference 2" {
  let ymd = parser_ymd()
  ymd.append_number(1900, label=Y)
  ymd.append_number(2, label=M)
  assert_eq(
    [-1, 0, 1, 28, 29, 30, 31, 32].map(value => ymd.could_be_day(value)),
    [false, false, true, true, false, false, false, false],
  )
}

