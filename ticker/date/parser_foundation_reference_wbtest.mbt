    ([12, 100], Some((Some(100), Some(12), None))),
    ([12, 101], Some((Some(101), Some(12), None))),
    ([12, 2000], Some((Some(2000), Some(12), None))),
    ([13, 1], Some((None, Some(13), Some(1)))),
    ([13, 12], Some((None, Some(13), Some(12)))),
    ([13, 13], Some((None, Some(13), Some(13)))),
    ([13, 31], Some((None, Some(13), Some(31)))),
    ([13, 32], Some((Some(32), Some(13), None))),
    ([13, 100], Some((Some(100), Some(13), None))),
    ([13, 101], Some((Some(101), Some(13), None))),
    ([13, 2000], Some((Some(2000), Some(13), None))),
    ([31, 1], Some((None, Some(31), Some(1)))),
    ([31, 12], Some((None, Some(31), Some(12)))),
    ([31, 13], Some((None, Some(31), Some(13)))),
