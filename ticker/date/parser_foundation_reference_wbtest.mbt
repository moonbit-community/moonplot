    ([32, 1], Some((Some(32), Some(1), None))),
    ([32, 12], Some((Some(32), Some(12), None))),
    ([32, 13], Some((Some(32), Some(13), None))),
    ([32, 31], Some((Some(32), Some(31), None))),
    ([32, 32], Some((Some(32), Some(32), None))),
    ([32, 100], Some((Some(32), Some(100), None))),
    ([32, 101], Some((Some(32), Some(101), None))),
    ([32, 2000], Some((Some(32), Some(2000), None))),
    ([100, 1], Some((Some(100), Some(1), None))),
    ([100, 12], Some((Some(100), Some(12), None))),
    ([100, 13], Some((Some(100), Some(13), None))),
    ([100, 31], Some((Some(100), Some(31), None))),
    ([100, 32], Some((Some(100), Some(32), None))),
    ([100, 100], Some((Some(100), Some(100), None))),
    ([100, 101], Some((Some(100), Some(101), None))),
    ([100, 2000], Some((Some(100), Some(2000), None))),
    ([101, 1], Some((Some(101), Some(1), None))),
    ([101, 12], Some((Some(101), Some(12), None))),
    ([101, 13], Some((Some(101), Some(13), None))),
    ([101, 31], Some((Some(101), Some(31), None))),
    ([101, 32], Some((Some(101), Some(32), None))),
    ([101, 100], Some((Some(101), Some(100), None))),
    ([101, 101], None),
    ([101, 2000], None),
    ([2000, 1], Some((Some(2000), Some(1), None))),
    ([2000, 12], Some((Some(2000), Some(12), None))),
    ([2000, 13], Some((Some(2000), Some(13), None))),
    ([2000, 31], Some((Some(2000), Some(31), None))),
    ([2000, 32], Some((Some(2000), Some(32), None))),
    ([2000, 100], Some((Some(2000), Some(100), None))),
    ([2000, 101], None),
    ([2000, 2000], None),
  ]
  for (values, expected) in cases {
    let result = try {
      let ymd = parser_ymd()
      for value in values {
        ymd.append_number(value)
      }
      Some(ymd.resolve(yearfirst=false, dayfirst=false))
    } catch {
      _ => None
    }
    assert_eq((values, result), (values, expected))
  }
}

