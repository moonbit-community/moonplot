        percent_convert_to_pct(
          PercentXMax::Number(-0.0),
          NamedFormatValue::PythonFloat(1.0e+308),
        ),
      )
      false
    } catch {
      @core.DataError::InvalidTicks(message~) =>
        message == "ZeroDivisionError: float division by zero"
      _ => false
    },
  )
}

