///|
test "Percent complete source numeric 834 format" {
  let previous = @config.text_usetex()
  defer @config.set_text_usetex(previous)
  @config.set_text_usetex(false)
  let state : PercentFormatterState = {
    xmax: PercentXMax::Integer(decimal_power(309)),
    decimals: PercentDecimals::Automatic,
    symbol: Some("%"),
    is_latex: false,
  }
  assert_true(
    try {
      ignore(
        percent_format_pct_with_range(
          state,
          NamedFormatValue::PythonFloat(1.0),
          PercentDisplayRange::PythonInteger(@bigint.BigInt::from_string("0")),
        ),
      )
      false
    } catch {
      @core.DataError::InvalidTicks(message~) =>
        message == "OverflowError: int too large to convert to float"
      _ => false
    },
  )
}

