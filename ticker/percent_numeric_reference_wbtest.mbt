    decimals: PercentDecimals::Number(2.0),
    symbol: Some("😀%"),
    is_latex: false,
  }
  assert_eq(
    percent_format_pct(
      state,
      NamedFormatValue::PythonFloat(-0.0),
      NamedFormatValue::PythonFloat(1.0),
    ),
    "-0.00😀%",
  )
}

