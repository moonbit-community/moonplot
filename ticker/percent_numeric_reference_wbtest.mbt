  let previous = @config.text_usetex()
  defer @config.set_text_usetex(previous)
  @config.set_text_usetex(false)
  let state : PercentFormatterState = {
    xmax: PercentXMax::Integer(decimal_power(308)),
    decimals: PercentDecimals::Automatic,
    symbol: Some("%"),
    is_latex: false,
  }
  assert_eq(
    percent_format_pct_with_range(
      state,
      NamedFormatValue::NumpyFloat64(1.0),
      PercentDisplayRange::PythonInteger(decimal_power(400)),
    ),
    "0%",
  )
}

