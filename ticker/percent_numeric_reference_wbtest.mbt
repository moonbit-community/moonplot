  defer @config.set_text_usetex(previous)
  @config.set_text_usetex(false)
  let state : PercentFormatterState = {
    xmax: PercentXMax::Number(1.0),
    decimals: PercentDecimals::Automatic,
    symbol: Some("%"),
    is_latex: false,
  }
  assert_eq(
    percent_format_pct(
      state,
      NamedFormatValue::PythonFloat(1.25),
      NamedFormatValue::PythonFloat(4.99999999999999e-07),
    ),
    "125.00000%",
  )
}

