///|
test "Percent complete source numeric 1601 format" {
  let previous = @config.text_usetex()
  defer @config.set_text_usetex(previous)
  @config.set_text_usetex(false)
  let state : PercentFormatterState = {
    xmax: PercentXMax::Number(-100.0),
    decimals: PercentDecimals::Automatic,
    symbol: Some("%"),
    is_latex: false,
  }
  assert_true(
    try {
      ignore(
        percent_format_pct(
          state,
          NamedFormatValue::PythonFloat(1.25),
          NamedFormatValue::PythonFloat(-1.0 / 0.0),
        ),
      )
      false
    } catch {
      @core.DataError::InvalidTicks(message~) =>
        message == "OverflowError: cannot convert float infinity to integer"
      _ => false
    },
  )
}

