    ),
    symbol: Some("%"),
    is_latex: false,
  }
  assert_true(
    try {
      ignore(
        percent_format_pct(
          state,
          NamedFormatValue::PythonFloat(0.0 / 0.0),
          NamedFormatValue::PythonFloat(1.0),
        ),
      )
      false
    } catch {
      @core.DataError::InvalidTicks(message~) =>
        message ==
        "ValueError: Exceeds the limit (4300 digits) for integer string conversion: value has 4301 digits; use sys.set_int_max_str_digits() to increase the limit"
      _ => false
    },
  )
}

///|
test "Percent complete source numeric 1779 format" {
  let previous = @config.text_usetex()
  defer @config.set_text_usetex(previous)
  @config.set_text_usetex(false)
  let state : PercentFormatterState = {
    xmax: PercentXMax::Number(100.0),
    decimals: PercentDecimals::Text(
      "",
    ),
    symbol: Some("%"),
    is_latex: false,
  }
  assert_true(
    try {
      ignore(
        percent_format_pct(
          state,
          NamedFormatValue::PythonFloat(0.0 / 0.0),
          NamedFormatValue::PythonFloat(1.0),
        ),
      )
      false
    } catch {
      @core.DataError::InvalidTicks(message~) =>
        message ==
        "ValueError: invalid literal for int() with base 10: '1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111"
      _ => false
    },
  )
}

