///|
fn logit_sort_reference_case_245() -> Unit raise {
  let pessimistic = Array::makei(125001, _ => {
    9221120237041090560UL.reinterpret_as_double()
  })
  let sums = Array::makei(125001, index => index.to_double())
  let actual = logit_sort_indices(pessimistic, sums)
  let expected = logit_sort_reference_expand([(0, 1, 125001)])
  assert_eq(actual.length(), expected.length(), msg="sort case 245 length")
  for index in 0..<expected.length() {
    assert_eq(
      actual[index],
      expected[index],
      msg="sort case 245 element " + index.to_string(),
    )
  }
}

