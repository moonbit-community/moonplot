///|
fn logit_sort_reference_expand(
  runs : Array[(Int32, Int32, Int32)],
) -> Array[Int32] {
  let values : Array[Int32] = []
  for (first, step, count) in runs {
    for index in 0..<count {
      values.push(first + step * index)
    }
  }
  values
}

