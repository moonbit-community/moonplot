      @bigint.BigInt::from_string(
        "",
      ),
    ),
  )
  assert_eq(logit_named_call(base, state, key, None), "")
  assert_eq(formatter.format_data_key(key), "")
  assert_eq(
    try {
      ignore(logit_named_short(key.value()))
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
      _ => "unexpected error"
    },
    "OverflowError: int too large to convert to float",
  )
}

///|
fn logit_formatter_numeric_case_1755() -> Unit raise {
  let formatter = LogitFormatter::new(
    minor=LogValue::Numeric(ScalarNumber::Boolean(true)),
    use_overline=LogValue::Numeric(ScalarNumber::Boolean(true)),
    minor_number=LogValue::Numeric(
      ScalarNumber::Integer(@bigint.BigInt::from_string("6")),
    ),
    minor_threshold=LogValue::Numeric(
      ScalarNumber::Integer(@bigint.BigInt::from_string("25")),
    ),
    one_half=LogValue::Text("\\frac{1}{2}"),
  )
  let base = formatter.as_base_formatter()
  let state = logit_formatter_state(base)
  let input_keys = [
    LogitKey::new(
      ScalarNumber::Integer(@bigint.BigInt::from_string("9223372036854775808")),
    ),
    LogitKey::new(
      ScalarNumber::Integer(@bigint.BigInt::from_string("18446744073709551615")),
    ),
  ]
  let input = LogitInput::from_keys(input_keys)
  assert_eq(
    try {
      ignore(logit_named_prepare(base, state, input))
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
      _ => "unexpected error"
    },
    "TypeError: loop of ufunc does not support argument 0 of type int which has no callable rint method",
