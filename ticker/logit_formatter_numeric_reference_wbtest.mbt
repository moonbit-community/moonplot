      ScalarNumber::Integer(@bigint.BigInt::from_string("100")),
    ),
    one_half=LogValue::Text("\\frac{1}{2}"),
  )
  let base = formatter.as_base_formatter()
  let state = logit_formatter_state(base)
  let input_keys = [
    LogitKey::new(
      ScalarNumber::Number(4605380978949069210UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4604480259023595110UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4601057523306793533UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4600877379321698714UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4598895795485655695UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4597094355634707497UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4596734067664517857UL.reinterpret_as_double()),
    ),
  ]
  let input = LogitInput::from_keys(input_keys)
  assert_eq(
    try {
      ignore(logit_named_prepare(base, state, input))
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
