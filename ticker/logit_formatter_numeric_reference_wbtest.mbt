///|
fn logit_formatter_numeric_case_1977() -> Unit raise {
  let formatter = LogitFormatter::new(
    minor=LogValue::Numeric(ScalarNumber::Boolean(true)),
    use_overline=LogValue::Numeric(ScalarNumber::Boolean(false)),
    minor_number=LogValue::Numeric(
      ScalarNumber::Integer(@bigint.BigInt::from_string("0")),
    ),
    minor_threshold=LogValue::Numeric(
      ScalarNumber::Integer(@bigint.BigInt::from_string("100")),
    ),
    one_half=LogValue::Text("\\frac{1}{2}"),
  )
  let base = formatter.as_base_formatter()
  let state = logit_formatter_state(base)
  let input_keys = [
    LogitKey::new(
      ScalarNumber::Number(4596373779694328218UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(9221120237041090560UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4599075939470750515UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4600877379321698714UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4605380978949069210UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4606281698874543309UL.reinterpret_as_double()),
    ),
  ]
  let input = LogitInput::from_keys(input_keys)
  assert_eq(logit_named_prepare(base, state, input), ())
  assert_eq(base.locations.length(), 6)
  let snapshot = match base.locations {
    NdArray(values) => values
    _ => abort("unexpected snapshot kind")
  }
  assert_eq(snapshot.is_int64(), false)
  assert_eq(snapshot.get(0).reinterpret_as_uint64(), 4596373779694328218UL)
  assert_eq(snapshot.get(1).reinterpret_as_uint64(), 9221120237041090560UL)
  assert_eq(snapshot.get(2).reinterpret_as_uint64(), 4599075939470750515UL)
  assert_eq(snapshot.get(3).reinterpret_as_uint64(), 4600877379321698714UL)
  assert_eq(snapshot.get(4).reinterpret_as_uint64(), 4605380978949069210UL)
  assert_eq(snapshot.get(5).reinterpret_as_uint64(), 4606281698874543309UL)
  assert_eq(state.labelled.keys().length(), 6)
  assert_eq(state.labelled.contains(input.key_at(0)), true)
  assert_eq(state.labelled.contains(input.key_at(1)), true)
  assert_eq(state.labelled.contains(input.key_at(2)), true)
  assert_eq(state.labelled.contains(input.key_at(3)), true)
  assert_eq(state.labelled.contains(input.key_at(4)), true)
  assert_eq(state.labelled.contains(input.key_at(5)), true)
}

