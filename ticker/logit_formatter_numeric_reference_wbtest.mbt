///|
fn logit_formatter_numeric_case_2385() -> Unit raise {
  let formatter = LogitFormatter::new(
    minor=LogValue::Numeric(ScalarNumber::Boolean(true)),
    use_overline=LogValue::Numeric(ScalarNumber::Boolean(false)),
    minor_number=LogValue::Numeric(
      ScalarNumber::Integer(@bigint.BigInt::from_string("6")),
    ),
    minor_threshold=LogValue::Numeric(
      ScalarNumber::Integer(@bigint.BigInt::from_string("200002")),
    ),
    one_half=LogValue::Text("\\frac{1}{2}"),
  )
  let base = formatter.as_base_formatter()
  let state = logit_formatter_state(base)
  let values = Array::makei(200001, index => {
    if index == 200000 {
      4607181518080091934UL.reinterpret_as_double()
    } else {
      index.to_double() * 4527515803391944323UL.reinterpret_as_double() +
      4547007122018943789UL.reinterpret_as_double()
    }
  })
  let input = LogitInput::from_view(TickValues::from_array(values))
  assert_eq(logit_named_prepare(base, state, input), ())
  assert_eq(base.locations.length(), 200001)
  assert_eq(state.labelled.keys().length(), 6)
  assert_true(
    state.labelled.contains(
      LogitKey::new(
        ScalarNumber::NumpyFloat64(
          4547007122018943789UL.reinterpret_as_double(),
        ),
      ),
    ),
  )
  assert_true(
    state.labelled.contains(
      LogitKey::new(
        ScalarNumber::NumpyFloat64(
          4547375983113441685UL.reinterpret_as_double(),
        ),
      ),
    ),
  )
  assert_true(
    state.labelled.contains(
      LogitKey::new(
        ScalarNumber::NumpyFloat64(
          4547744844207939581UL.reinterpret_as_double(),
        ),
      ),
    ),
  )
  assert_true(
    state.labelled.contains(
      LogitKey::new(
        ScalarNumber::NumpyFloat64(
          4607181428026113785UL.reinterpret_as_double(),
        ),
      ),
    ),
  )
  assert_true(
    state.labelled.contains(
      LogitKey::new(
        ScalarNumber::NumpyFloat64(
          4607181473053102859UL.reinterpret_as_double(),
        ),
      ),
    ),
  )
  assert_true(
    state.labelled.contains(
      LogitKey::new(
        ScalarNumber::NumpyFloat64(
          4607181518080091934UL.reinterpret_as_double(),
        ),
      ),
    ),
  )
  assert_eq(
    logit_named_call(
      base,
      state,
      LogitKey::new(
        ScalarNumber::NumpyFloat64(
          4607181518080091934UL.reinterpret_as_double(),
        ),
      ),
      None,
    ),
    "$\\mathdefault{1-10^{-4}}$",
  )
}

///|
fn logit_formatter_numeric_case_2386() -> Unit raise {
  let formatter = LogitFormatter::new(
    minor=LogValue::Numeric(ScalarNumber::Boolean(false)),
    use_overline=LogValue::Numeric(ScalarNumber::Boolean(false)),
    minor_number=LogValue::Numeric(
      ScalarNumber::Integer(@bigint.BigInt::from_string("6")),
    ),
    minor_threshold=LogValue::Numeric(
      ScalarNumber::Integer(@bigint.BigInt::from_string("25")),
    ),
    one_half=LogValue::Text("\\frac{1}{2}"),
  )
  let base = formatter.as_base_formatter()
  let state = logit_formatter_state(base)
  let input_keys = [
    LogitKey::new(
      ScalarNumber::Integer(@bigint.BigInt::from_string("18446744073709551616")),
    ),
    LogitKey::new(
      ScalarNumber::Number(4596373779694328218UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(9221120237041090560UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4596377382574030114UL.reinterpret_as_double()),
    ),
  ]
  let input = LogitInput::from_keys(input_keys)
  assert_eq(logit_named_prepare(base, state, input), ())
  assert_eq(base.locations.length(), 4)
  let snapshot = match base.locations {
    Typed(values) => values
    _ => abort("unexpected typed snapshot kind")
  }
  assert_eq(snapshot.dtype(), "object")
  assert_eq(
    snapshot.get_value(0),
    ScalarNumber::Integer(@bigint.BigInt::from_string("18446744073709551616")),
  )
  assert_true(
    snapshot.get_value(1) is Number(number) &&
    number.reinterpret_as_uint64() == 4596373779694328218UL,
  )
  assert_true(
    snapshot.get_value(2) is Number(number) &&
    number.reinterpret_as_uint64() == 9221120237041090560UL,
  )
  assert_true(
    snapshot.get_value(3) is Number(number) &&
    number.reinterpret_as_uint64() == 4596377382574030114UL,
  )
  assert_eq(
    logit_named_call(
      base,
      state,
      LogitKey::new(ScalarNumber::Number(0.2)),
      None,
    ),
    "$\\mathdefault{0.2}$",
  )
}

///|
fn logit_formatter_numeric_case_2387() -> Unit raise {
  let formatter = LogitFormatter::new(
    minor=LogValue::Numeric(ScalarNumber::Boolean(false)),
    use_overline=LogValue::Numeric(ScalarNumber::Boolean(false)),
    minor_number=LogValue::Numeric(
      ScalarNumber::Integer(@bigint.BigInt::from_string("6")),
    ),
    minor_threshold=LogValue::Numeric(
      ScalarNumber::Integer(@bigint.BigInt::from_string("25")),
    ),
    one_half=LogValue::Text("\\frac{1}{2}"),
  )
  let base = formatter.as_base_formatter()
  let state = logit_formatter_state(base)
  let input_keys = [
    LogitKey::new(
      ScalarNumber::Number(4596373779694328218UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(9221120237041090560UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4596377382574030114UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Integer(@bigint.BigInt::from_string("18446744073709551616")),
    ),
  ]
  let input = LogitInput::from_keys(input_keys)
  assert_eq(logit_named_prepare(base, state, input), ())
  assert_eq(base.locations.length(), 4)
  let snapshot = match base.locations {
    Typed(values) => values
    _ => abort("unexpected typed snapshot kind")
  }
  assert_eq(snapshot.dtype(), "object")
  assert_true(
    snapshot.get_value(0) is Number(number) &&
    number.reinterpret_as_uint64() == 4596373779694328218UL,
  )
  assert_true(
    snapshot.get_value(1) is Number(number) &&
    number.reinterpret_as_uint64() == 9221120237041090560UL,
  )
  assert_true(
    snapshot.get_value(2) is Number(number) &&
    number.reinterpret_as_uint64() == 4596377382574030114UL,
  )
  assert_eq(
    snapshot.get_value(3),
    ScalarNumber::Integer(@bigint.BigInt::from_string("18446744073709551616")),
  )
  assert_eq(
    try {
      ignore(
        logit_named_call(
          base,
          state,
          LogitKey::new(ScalarNumber::Number(0.2)),
          None,
        ),
      )
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
      _ => "unexpected error"
    },
    "ValueError: cannot convert float NaN to integer",
  )
}

