///|
fn logit_formatter_numeric_case_1137() -> Unit raise {
  let formatter = LogitFormatter::new(
    minor=LogValue::Numeric(ScalarNumber::Boolean(true)),
    use_overline=LogValue::Numeric(ScalarNumber::Boolean(false)),
    minor_number=LogValue::Numeric(
      ScalarNumber::Integer(@bigint.BigInt::from_string("6")),
    ),
    minor_threshold=LogValue::Numeric(
      ScalarNumber::Integer(@bigint.BigInt::from_string("25")),
    ),
    one_half=LogValue::Text("\\frac{1}{2}"),
  )
  let base = formatter.as_base_formatter()
  let state = logit_formatter_state(base)
  let input_keys = [
    LogitKey::new(
      ScalarNumber::Number(4596373779694328218UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(9221120237041090560UL.reinterpret_as_double()),
    ),
  ]
  let input = LogitInput::from_keys(input_keys)
  assert_eq(logit_named_prepare(base, state, input), ())
  let key = input_keys[1]
  assert_eq(
    try {
      ignore(logit_named_call(base, state, key, None))
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
      _ => "unexpected error"
    },
    "ValueError: cannot convert float NaN to integer",
  )
  assert_eq(
    try {
      ignore(formatter.format_data_key(key))
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
      _ => "unexpected error"
    },
    "ValueError: cannot convert float NaN to integer",
  )
  assert_eq(logit_named_short(key.value()), "1-nan")
}

