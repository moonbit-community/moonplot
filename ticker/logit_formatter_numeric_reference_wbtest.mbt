    ),
    LogitKey::new(
      ScalarNumber::Number(4587366580439587226UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4591870180066957722UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4596373779694328218UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4602678819172646912UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4605380978949069210UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4606281698874543309UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4606732058837280358UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4607092346807469998UL.reinterpret_as_double()),
    ),
  ]
  let input = LogitInput::from_keys(input_keys)
  assert_eq(logit_named_prepare(base, state, input), ())
