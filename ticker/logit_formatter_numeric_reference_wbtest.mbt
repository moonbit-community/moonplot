///|
fn logit_formatter_numeric_case_2037() -> Unit raise {
  let formatter = LogitFormatter::new(
    minor=LogValue::Numeric(ScalarNumber::Boolean(true)),
    use_overline=LogValue::Numeric(ScalarNumber::Boolean(false)),
    minor_number=LogValue::Numeric(
      ScalarNumber::Integer(@bigint.BigInt::from_string("0")),
    ),
    minor_threshold=LogValue::Numeric(
      ScalarNumber::Integer(@bigint.BigInt::from_string("100")),
    ),
    one_half=LogValue::Text("\\frac{1}{2}"),
  )
  let base = formatter.as_base_formatter()
  let state = logit_formatter_state(base)
  let input_keys = [
    LogitKey::new(
      ScalarNumber::Number(4591870180066957722UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4576918229304087675UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4602678819172646912UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4606281698874543309UL.reinterpret_as_double()),
    ),
    LogitKey::new(
      ScalarNumber::Number(4607092346807469998UL.reinterpret_as_double()),
    ),
  ]
  let input = LogitInput::from_keys(input_keys)
  assert_eq(logit_named_prepare(base, state, input), ())
  assert_eq(base.locations.length(), 5)
  let snapshot = match base.locations {
    NdArray(values) => values
    _ => abort("unexpected snapshot kind")
  }
  assert_eq(snapshot.is_int64(), false)
  assert_eq(snapshot.get(0).reinterpret_as_uint64(), 4591870180066957722UL)
  assert_eq(snapshot.get(1).reinterpret_as_uint64(), 4576918229304087675UL)
  assert_eq(snapshot.get(2).reinterpret_as_uint64(), 4602678819172646912UL)
  assert_eq(snapshot.get(3).reinterpret_as_uint64(), 4606281698874543309UL)
  assert_eq(snapshot.get(4).reinterpret_as_uint64(), 4607092346807469998UL)
  assert_eq(state.labelled.keys().length(), 0)
  assert_eq(state.labelled.contains(input.key_at(0)), false)
  assert_eq(state.labelled.contains(input.key_at(1)), false)
  assert_eq(state.labelled.contains(input.key_at(2)), false)
  assert_eq(state.labelled.contains(input.key_at(3)), false)
  assert_eq(state.labelled.contains(input.key_at(4)), false)
}

