    minor=LogValue::Numeric(ScalarNumber::Boolean(true)),
    use_overline=LogValue::Numeric(ScalarNumber::Boolean(false)),
    minor_number=LogValue::Numeric(
      ScalarNumber::Number(4607182418800017408UL.reinterpret_as_double()),
    ),
    minor_threshold=LogValue::Numeric(
      ScalarNumber::Integer(@bigint.BigInt::from_string("100")),
    ),
    one_half=LogValue::Text("\\frac{1}{2}"),
  )
  let base = formatter.as_base_formatter()
  let state = logit_formatter_state(base)
  let input_keys = [
    LogitKey::new(ScalarNumber::Integer(@bigint.BigInt::from_string("3"))),
    LogitKey::new(ScalarNumber::NumpyFloat64(0UL.reinterpret_as_double())),
    LogitKey::new(
      ScalarNumber::Integer(
        @bigint.BigInt::from_string("1267650600228229401496703205376"),
      ),
    ),
    LogitKey::new(ScalarNumber::Integer(@bigint.BigInt::from_string("4"))),
    LogitKey::new(ScalarNumber::Integer(@bigint.BigInt::from_string("5"))),
    LogitKey::new(ScalarNumber::Integer(@bigint.BigInt::from_string("6"))),
  ]
  let input = LogitInput::from_keys(input_keys)
  assert_eq(
    try {
      ignore(logit_named_prepare(base, state, input))
      "unexpected success"
    } catch {
      @core.DataError::InvalidTicks(message~) => message
      _ => "unexpected error"
    },
    "TypeError: loop of ufunc does not support argument 0 of type float which has no callable log method",
  )
  assert_eq(base.locations.length(), 6)
  let snapshot = match base.locations {
    Typed(values) => values
    _ => abort("unexpected typed snapshot kind")
  }
  assert_eq(snapshot.dtype(), "object")
  assert_eq(
    snapshot.get_value(0),
    ScalarNumber::Integer(@bigint.BigInt::from_string("3")),
  )
  assert_true(
    snapshot.get_value(1) is NumpyFloat64(number) &&
    number.reinterpret_as_uint64() == 0UL,
  )
  assert_eq(
    snapshot.get_value(2),
    ScalarNumber::Integer(
      @bigint.BigInt::from_string("1267650600228229401496703205376"),
    ),
  )
  assert_eq(
    snapshot.get_value(3),
    ScalarNumber::Integer(@bigint.BigInt::from_string("4")),
  )
  assert_eq(
    snapshot.get_value(4),
    ScalarNumber::Integer(@bigint.BigInt::from_string("5")),
  )
  assert_eq(
    snapshot.get_value(5),
    ScalarNumber::Integer(@bigint.BigInt::from_string("6")),
  )
  assert_eq(state.labelled.keys().length(), 0)
  assert_eq(state.labelled.contains(input.key_at(0)), false)
  assert_eq(state.labelled.contains(input.key_at(1)), false)
  assert_eq(state.labelled.contains(input.key_at(2)), false)
  assert_eq(state.labelled.contains(input.key_at(3)), false)
  assert_eq(state.labelled.contains(input.key_at(4)), false)
  assert_eq(state.labelled.contains(input.key_at(5)), false)
}

