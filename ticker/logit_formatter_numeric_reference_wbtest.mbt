  let formatter = LogitFormatter::new(
    minor=LogValue::Numeric(ScalarNumber::Boolean(true)),
    use_overline=LogValue::Numeric(ScalarNumber::Boolean(true)),
    minor_number=LogValue::Numeric(
      ScalarNumber::Integer(@bigint.BigInt::from_string("6")),
    ),
    minor_threshold=LogValue::Numeric(
      ScalarNumber::Integer(@bigint.BigInt::from_string("25")),
    ),
    one_half=LogValue::Text("\\frac{1}{2}"),
  )
  let base = formatter.as_base_formatter()
  let state = logit_formatter_state(base)
  let key = LogitKey::new(
    ScalarNumber::Number(4602678819172646912UL.reinterpret_as_double()),
  )
  assert_eq(logit_named_call(base, state, key, None), "")
  assert_eq(formatter.format_data_key(key), "")
  assert_eq(logit_named_short(key.value()), "0.500000")
}

