///|
/// Draw streamlines for a regular vector field on the current axes.
pub fn streamplot(
  xs : Array[Double],
  ys : Array[Double],
  us : Array[Array[Double]],
  vs : Array[Array[Double]],
  density~ : Double = 1.0,
  density_x~ : Double = -1.0,
  density_y~ : Double = -1.0,
  color~ : String = "",
  linewidth~ : Double = 1.0,
  max_steps~ : Int32 = 200,
  minlength~ : Double = 0.1,
  start_points~ : Array[@core.Point] = [],
  maxlength~ : Double = 4.0,
  integration_direction~ : String = "both",
  broken_streamlines~ : Bool = true,
  integration_max_step_scale~ : Double = 1.0,
  integration_max_error_scale~ : Double = 1.0,
  arrows~ : Bool = true,
  arrow_size~ : Double = 1.0,
  num_arrows~ : Int32 = 1,
  arrowstyle~ : String = "-|>",
  label~ : String = "",
) -> @scene.StreamplotSet raise @core.DataError {
  require_axes().streamplot(
    xs,
    ys,
    us,
    vs,
    density~,
    density_x~,
    density_y~,
    color~,
    linewidth~,
    max_steps~,
    minlength~,
    start_points~,
    maxlength~,
    integration_direction~,
    broken_streamlines~,
    integration_max_step_scale~,
    integration_max_error_scale~,
    arrows~,
    arrow_size~,
    num_arrows~,
    arrowstyle~,
    label~,
  )
}

///|
/// Draw streamlines with grid-valued linewidth and color controls.
pub fn streamplot_with_style_grids(
  xs : Array[Double],
  ys : Array[Double],
  us : Array[Array[Double]],
  vs : Array[Array[Double]],
  linewidths~ : Array[Array[Double]] = [],
  color_values~ : Array[Array[Double]] = [],
  density~ : Double = 1.0,
  density_x~ : Double = -1.0,
  density_y~ : Double = -1.0,
  color~ : String = "",
  linewidth~ : Double = 1.0,
  cmap~ : String = "viridis",
  vmin? : Double,
  vmax? : Double,
  max_steps~ : Int32 = 200,
  minlength~ : Double = 0.1,
  start_points~ : Array[@core.Point] = [],
  maxlength~ : Double = 4.0,
  integration_direction~ : String = "both",
  broken_streamlines~ : Bool = true,
  integration_max_step_scale~ : Double = 1.0,
  integration_max_error_scale~ : Double = 1.0,
  arrows~ : Bool = true,
  arrow_size~ : Double = 1.0,
  num_arrows~ : Int32 = 1,
  arrowstyle~ : String = "-|>",
  label~ : String = "",
) -> @scene.StreamplotSet raise @core.DataError {
  match (vmin, vmax) {
    (Some(lower), Some(upper)) =>
      require_axes().streamplot_with_style_grids(
        xs,
        ys,
        us,
        vs,
        linewidths~,
        color_values~,
        density~,
        density_x~,
        density_y~,
        color~,
        linewidth~,
        cmap~,
        vmin=lower,
        vmax=upper,
        max_steps~,
        minlength~,
        start_points~,
        maxlength~,
        integration_direction~,
        broken_streamlines~,
        integration_max_step_scale~,
        integration_max_error_scale~,
        arrows~,
        arrow_size~,
        num_arrows~,
        arrowstyle~,
        label~,
      )
    (Some(lower), None) =>
      require_axes().streamplot_with_style_grids(
        xs,
        ys,
        us,
        vs,
        linewidths~,
        color_values~,
        density~,
        density_x~,
        density_y~,
        color~,
        linewidth~,
        cmap~,
        vmin=lower,
        max_steps~,
        minlength~,
        start_points~,
        maxlength~,
        integration_direction~,
        broken_streamlines~,
        integration_max_step_scale~,
        integration_max_error_scale~,
        arrows~,
        arrow_size~,
        num_arrows~,
        arrowstyle~,
        label~,
      )
    (None, Some(upper)) =>
      require_axes().streamplot_with_style_grids(
        xs,
        ys,
        us,
        vs,
        linewidths~,
        color_values~,
        density~,
        density_x~,
        density_y~,
        color~,
        linewidth~,
        cmap~,
        vmax=upper,
        max_steps~,
        minlength~,
        start_points~,
        maxlength~,
        integration_direction~,
        broken_streamlines~,
        integration_max_step_scale~,
        integration_max_error_scale~,
        arrows~,
        arrow_size~,
        num_arrows~,
        arrowstyle~,
        label~,
      )
    (None, None) =>
      require_axes().streamplot_with_style_grids(
        xs,
        ys,
        us,
        vs,
        linewidths~,
        color_values~,
        density~,
        density_x~,
        density_y~,
        color~,
        linewidth~,
        cmap~,
        max_steps~,
        minlength~,
        start_points~,
        maxlength~,
        integration_direction~,
        broken_streamlines~,
        integration_max_step_scale~,
        integration_max_error_scale~,
        arrows~,
        arrow_size~,
        num_arrows~,
        arrowstyle~,
        label~,
      )
  }
}

///|
/// Draw streamlines from meshgrid-style two-dimensional coordinates.
pub fn streamplot_mesh(
  x_grid : Array[Array[Double]],
  y_grid : Array[Array[Double]],
  us : Array[Array[Double]],
  vs : Array[Array[Double]],
  density~ : Double = 1.0,
  density_x~ : Double = -1.0,
  density_y~ : Double = -1.0,
  color~ : String = "",
  linewidth~ : Double = 1.0,
  max_steps~ : Int32 = 200,
  minlength~ : Double = 0.1,
  start_points~ : Array[@core.Point] = [],
  maxlength~ : Double = 4.0,
  integration_direction~ : String = "both",
  broken_streamlines~ : Bool = true,
  integration_max_step_scale~ : Double = 1.0,
  integration_max_error_scale~ : Double = 1.0,
  arrows~ : Bool = true,
  arrow_size~ : Double = 1.0,
  num_arrows~ : Int32 = 1,
  arrowstyle~ : String = "-|>",
  label~ : String = "",
) -> @scene.StreamplotSet raise @core.DataError {
  require_axes().streamplot_mesh(
    x_grid,
    y_grid,
    us,
    vs,
    density~,
    density_x~,
    density_y~,
    color~,
    linewidth~,
    max_steps~,
    minlength~,
    start_points~,
    maxlength~,
    integration_direction~,
    broken_streamlines~,
    integration_max_step_scale~,
    integration_max_error_scale~,
    arrows~,
    arrow_size~,
    num_arrows~,
    arrowstyle~,
    label~,
  )
}
