  assert_eq(minors, [])
  assert_eq(minor_labels, [])
  assert_eq(value.formatter_offset_label_checked(majors, view=bounds), "")
  assert_eq(value.tick_values(bounds), majors)
  assert_eq(value.tick_labels_with_view(majors, Some(bounds)), labels)
