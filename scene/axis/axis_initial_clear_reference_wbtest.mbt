    )
    try! @config.set_formatter_limits(query_previous.formatter_limits())
  }
  @config.set_axes_autolimit_mode("data")
  @config.set_minor_tick_divisions(@config.MinorTickDivisions::Text("auto"))
  @config.set_minor_tick_divisions(
