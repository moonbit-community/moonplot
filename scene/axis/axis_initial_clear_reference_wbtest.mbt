    physical_equal(
      peer.named_formatter().unwrap().axis().unwrap(),
      value.formatter_axis_binding(),
    ),
  )
  assert_true(
    physical_equal(old_formatter.axis().unwrap(), peer.formatter_axis_binding()),
  )
}

///|
fn axis_initial_clear_case_371() -> Unit raise {
  // single Axis clear preserves shared holder and peer geometry
  let previous = @config.rc_params()
  defer {
    @config.set_minor_ticks_visible(previous.minor_ticks_visible())
    @config.set_minor_ticks_visible(
      previous.minor_ticks_visible(horizontal=false),
      horizontal=false,
    )
    @config.set_classic_mode(previous.classic_mode())
    @config.set_formatter_use_offset(previous.formatter_use_offset())
    @config.set_formatter_use_math_text(previous.formatter_use_math_text())
    @config.set_formatter_use_locale(previous.formatter_use_locale())
    @config.set_text_usetex(previous.text_usetex())
  }
  @config.set_minor_ticks_visible(false)
  @config.set_minor_ticks_visible(true, horizontal=false)
  @config.set_classic_mode(false)
  @config.set_formatter_use_offset(true)
  @config.set_formatter_use_math_text(false)
  @config.set_formatter_use_locale(false)
  @config.set_text_usetex(false)
  let value = axis(horizontal=false)
  value.set_scale(@scale.Scale::Logit(clip=false))
  let peer = axis(horizontal=false)
  peer.share_numeric_tickers(value)
  peer.set_scale(@scale.Scale::Logit(clip=false))
  let holder = value.tickers
  let old_formatter = peer.named_formatter().unwrap()
  value.clear()
  assert_eq(axis_initial_state(value), [
    "linear", "AutoLocator", "AutoMinorLocator", "ScalarFormatter", "NullFormatter",
  ])
  assert_eq(axis_initial_flags(value), [true, true, true, true])
  assert_eq(axis_initial_state(peer), [
    "logit", "AutoLocator", "AutoMinorLocator", "ScalarFormatter", "NullFormatter",
  ])
  assert_eq(axis_initial_flags(peer), [true, true, true, true])
  assert_true(physical_equal(holder, value.tickers))
  assert_true(physical_equal(holder, peer.tickers))
  assert_true(
    physical_equal(
      peer.named_formatter().unwrap(),
      value.named_formatter().unwrap(),
    ),
  )
  assert_true(
    physical_equal(
      peer.named_formatter().unwrap().axis().unwrap(),
      value.formatter_axis_binding(),
    ),
  )
  assert_true(
    physical_equal(old_formatter.axis().unwrap(), peer.formatter_axis_binding()),
  )
}

///|
fn axis_initial_clear_case_372() -> Unit raise {
  // old locator context and formatter cache survive clear
  let previous = @config.rc_params()
  defer {
    @config.set_minor_ticks_visible(previous.minor_ticks_visible())
    @config.set_minor_ticks_visible(
      previous.minor_ticks_visible(horizontal=false),
      horizontal=false,
    )
    @config.set_classic_mode(previous.classic_mode())
    @config.set_formatter_use_offset(previous.formatter_use_offset())
    @config.set_formatter_use_math_text(previous.formatter_use_math_text())
    @config.set_formatter_use_locale(previous.formatter_use_locale())
    @config.set_text_usetex(previous.text_usetex())
  }
  @config.set_minor_ticks_visible(false)
  @config.set_minor_ticks_visible(true, horizontal=false)
  @config.set_classic_mode(false)
  @config.set_formatter_use_offset(true)
  @config.set_formatter_use_math_text(false)
  @config.set_formatter_use_locale(false)
  @config.set_text_usetex(false)
  let value = axis(horizontal=true)
  value.set_scale(@scale.Scale::Linear)
  value.set_named_formatter(@ticker.NullFormatter::new().as_base_formatter())
  value.set_minor_named_formatter(
    @ticker.NullFormatter::new().as_base_formatter(),
  )
  let old_provider = axis_initial_view_provider(value)
  let old_formatter = value.named_formatter().unwrap()
  let cache = [0.125, 0.875]
  old_formatter.set_locs_checked(cache)
  value.clear()
  value.bind_view_interval(() => (0.2, 0.8))
  assert_eq(
    old_provider(),
    (
      4596373779694328218UL.reinterpret_as_double(),
      4605380978949069210UL.reinterpret_as_double(),
    ),
  )
  assert_true(
    physical_equal(
      old_formatter.axis().unwrap(),
      value.formatter_axis_binding(),
    ),
  )
  let cached = match old_formatter.locations() {
    @ticker.FormatterLocations::Sequence(values) => values
    _ => abort("old sequence")
  }
  assert_true(physical_equal(cached, cache))
  assert_eq(cached, [
    4593671619917905920UL.reinterpret_as_double(),
    4606056518893174784UL.reinterpret_as_double(),
  ])
  assert_eq(value.named_formatter().unwrap().locations().length(), 0)
}

