  // clear replaces four slots in place and retains view inversion and overlap
  let previous = @config.rc_params()
  defer {
    @config.set_minor_ticks_visible(previous.minor_ticks_visible())
    @config.set_minor_ticks_visible(
      previous.minor_ticks_visible(horizontal=false),
      horizontal=false,
    )
    @config.set_classic_mode(previous.classic_mode())
    @config.set_formatter_use_offset(previous.formatter_use_offset())
    @config.set_formatter_use_math_text(previous.formatter_use_math_text())
    @config.set_formatter_use_locale(previous.formatter_use_locale())
    @config.set_text_usetex(previous.text_usetex())
  }
  @config.set_minor_ticks_visible(true)
  @config.set_minor_ticks_visible(false, horizontal=false)
  @config.set_classic_mode(false)
  @config.set_formatter_use_offset(true)
  @config.set_formatter_use_math_text(false)
  @config.set_formatter_use_locale(false)
  @config.set_text_usetex(false)
  let value = axis(horizontal=true)
  value.set_scale(@scale.Scale::Log)
  value.set_locator(@ticker.FixedLocator::new([-3.0, 2.0]).as_locator())
  value.set_minor_locator(
    @ticker.FixedLocator::new([-0.5, 1.5]).as_minor_locator(),
  )
  value.set_named_formatter(@ticker.NullFormatter::new().as_base_formatter())
  value.set_limits(0.9, 0.1)
  value.set_minor_overlap_removal(true)
  let holder = value.tickers
  let retained = axis_initial_handles(value)
  value.clear()
  assert_eq(axis_initial_state(value), [
    "linear", "AutoLocator", "AutoMinorLocator", "ScalarFormatter", "NullFormatter",
  ])
  assert_eq(axis_initial_flags(value), [true, true, true, true])
  assert_true(physical_equal(holder, value.tickers))
  assert_eq(axis_initial_replaced(retained, axis_initial_handles(value)), [
    true, true, true, true,
  ])
  assert_eq(
    value.view_interval_checked(),
    (
      4606281698874543309UL.reinterpret_as_double(),
      4591870180066957722UL.reinterpret_as_double(),
    ),
  )
  assert_eq(value.inverted(), true)
  assert_eq(value.minor_overlap_removal(), true)
  assert_eq(
    (value.limits().unwrap().lower(), value.limits().unwrap().upper()),
    (0.9, 0.1),
  )
  assert_true(value.auto_view is None)
  assert_true(
    physical_equal(retained.2.axis().unwrap(), value.formatter_axis_binding()),
  )
  assert_true(
    physical_equal(retained.3.axis().unwrap(), value.formatter_axis_binding()),
  )
}

