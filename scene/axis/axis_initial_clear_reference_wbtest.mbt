  @config.set_minor_ticks_visible(true, horizontal=false)
  @config.set_classic_mode(true)
  @config.set_formatter_use_offset(true)
  @config.set_formatter_use_math_text(false)
  @config.set_formatter_use_locale(false)
  @config.set_text_usetex(true)
  let value = axis(horizontal=false)
  assert_eq(axis_initial_state(value), [
    "linear", "AutoLocator", "AutoMinorLocator", "ScalarFormatter", "NullFormatter",
  ])
  assert_eq(axis_initial_flags(value), [true, true, true, true])
  assert_eq(value.tick_horizontal, false)
  let scalar = value.named_formatter().unwrap().scalar_formatter().unwrap()
  assert_eq(scalar.get_use_offset(), true)
  assert_eq(scalar.get_use_locale(), false)
  assert_eq(scalar.get_usetex(), true)
  assert_eq(
    value.locator().unwrap().auto_locator().unwrap().nbins(),
    @ticker.MaxNBins::Count(9),
  )
  assert_true(
    physical_equal(
      value.named_formatter().unwrap().axis().unwrap(),
      value.formatter_axis_binding(),
    ),
  )
  assert_true(
    physical_equal(
      value.minor_named_formatter().unwrap().axis().unwrap(),
      value.formatter_axis_binding(),
    ),
  )
  assert_true(value.limits() is None)
  assert_true(value.auto_view is None)
  assert_true(!value.inverted())
}

