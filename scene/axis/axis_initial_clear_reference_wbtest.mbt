  assert_eq(minors, [])
  assert_eq(minor_labels, [])
  assert_eq(value.formatter_offset_label_checked(majors, view=bounds), "")
  assert_eq(value.tick_values(bounds), majors)
  assert_eq(value.tick_labels_with_view(majors, Some(bounds)), labels)
  assert_eq(value.minor_tick_values(bounds), minors)
  assert_eq(value.minor_tick_labels(minors, view=bounds), minor_labels)
  assert_eq(value.formatter_offset_label_with_view(majors, Some(bounds)), "")
  let observed : Array[(String, Double, String)] = []
  for i, loc in majors {
    observed.push(("major", loc, labels[i]))
  }
  for i, loc in minors {
    observed.push(("minor", loc, minor_labels[i]))
  }
  assert_eq(observed, [
    ("major", 0UL.reinterpret_as_double(), "0.0"),
    ("major", 4596373779694328218UL.reinterpret_as_double(), "0.2"),
    ("major", 4600877379321698714UL.reinterpret_as_double(), "0.4"),
    ("major", 4603579539098121012UL.reinterpret_as_double(), "0.6"),
    ("major", 4605380978949069210UL.reinterpret_as_double(), "0.8"),
    ("major", 4607182418800017408UL.reinterpret_as_double(), "1.0"),
  ])
}

