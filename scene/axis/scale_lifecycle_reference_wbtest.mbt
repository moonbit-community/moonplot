// Generated by scripts/generate_scale_lifecycle_reference.py from pinned original Axis/Ticker/Scale AST.

///|
fn scale_lifecycle_flags(value : Axis) -> Array[Bool] {
  [
    value.is_default_locator(),
    value.is_default_locator(minor=true),
    value.is_default_formatter(),
    value.is_default_formatter(minor=true),
  ]
}

///|
fn scale_lifecycle_major(value : @ticker.Locator?) -> String {
  match value {
    Some(@ticker.Locator::NamedAuto(_)) => "AutoLocator"
    Some(@ticker.Locator::NamedLog(_)) => "LogLocator"
    Some(@ticker.Locator::NamedSymLog(_)) => "SymmetricalLogLocator"
    Some(@ticker.Locator::NamedAsinh(_)) => "AsinhLocator"
    Some(@ticker.Locator::NamedLogit(_)) => "LogitLocator"
    Some(@ticker.Locator::NamedFixed(_)) => "FixedLocator"
    _ => "unexpected major locator"
  }
}

///|
fn scale_lifecycle_minor(value : @ticker.MinorLocator?) -> String {
  match value {
    Some(@ticker.MinorLocator::Null(_)) => "NullLocator"
    Some(@ticker.MinorLocator::NamedAutoMinor(_)) => "AutoMinorLocator"
    Some(@ticker.MinorLocator::NamedLog(_)) => "LogLocator"
    Some(@ticker.MinorLocator::NamedSymLog(_)) => "SymmetricalLogLocator"
    Some(@ticker.MinorLocator::NamedAsinh(_)) => "AsinhLocator"
    Some(@ticker.MinorLocator::NamedLogit(_)) => "LogitLocator"
    Some(@ticker.MinorLocator::NamedFixed(_)) => "FixedLocator"
    _ => "unexpected minor locator"
  }
}

///|
fn scale_lifecycle_formatter(value : @ticker.BaseFormatter?) -> String {
  match value {
    Some(value) =>
      if value.scalar_formatter() is Some(_) {
        "ScalarFormatter"
      } else if value.null_formatter() is Some(_) {
        "NullFormatter"
      } else if value.log_formatter_sci_notation() is Some(_) {
        "LogFormatterSciNotation"
      } else if value.logit_formatter() is Some(_) {
        "LogitFormatter"
      } else {
        "unexpected formatter"
      }
    None => "missing formatter"
  }
}

///|
fn scale_lifecycle_state(value : Axis) -> Array[String] {
  let geometry = match value.scale() {
    @scale.Scale::Linear => "linear"
    @scale.Scale::Log => "log"
    @scale.Scale::SymLog(..) => "symlog"
    @scale.Scale::Asinh(..) => "asinh"
    @scale.Scale::Logit(..) => "logit"
  }
  [
    geometry,
    scale_lifecycle_major(value.locator()),
    scale_lifecycle_minor(value.minor_locator()),
    scale_lifecycle_formatter(value.named_formatter()),
    scale_lifecycle_formatter(value.minor_named_formatter()),
  ]
}

///|
fn scale_lifecycle_handles(
  value : Axis,
) -> (
  @ticker.Locator,
  @ticker.MinorLocator,
  @ticker.BaseFormatter,
  @ticker.BaseFormatter,
) {
  (
    value.tickers.locator.unwrap(),
    value.tickers.minor_locator.unwrap(),
    value.named_formatter().unwrap(),
    value.minor_named_formatter().unwrap(),
  )
}

///|
fn scale_lifecycle_replaced(
  old : (
    @ticker.Locator,
    @ticker.MinorLocator,
    @ticker.BaseFormatter,
    @ticker.BaseFormatter,
  ),
  current : (
    @ticker.Locator,
    @ticker.MinorLocator,
    @ticker.BaseFormatter,
    @ticker.BaseFormatter,
  ),
) -> Array[Bool] {
  // Each enum wraps a fresh named reference object; inspect that object rather than adapter allocation.
  let major = match (old.0, current.0) {
    (@ticker.Locator::NamedAuto(a), @ticker.Locator::NamedAuto(b)) =>
      !physical_equal(a, b)
    (@ticker.Locator::NamedLog(a), @ticker.Locator::NamedLog(b)) =>
      !physical_equal(a, b)
    (@ticker.Locator::NamedSymLog(a), @ticker.Locator::NamedSymLog(b)) =>
      !physical_equal(a, b)
    (@ticker.Locator::NamedAsinh(a), @ticker.Locator::NamedAsinh(b)) =>
      !physical_equal(a, b)
    (@ticker.Locator::NamedLogit(a), @ticker.Locator::NamedLogit(b)) =>
      !physical_equal(a, b)
    _ => true
  }
  let minor = match (old.1, current.1) {
    (@ticker.MinorLocator::Null(a), @ticker.MinorLocator::Null(b)) =>
      !physical_equal(a, b)
    (
      @ticker.MinorLocator::NamedAutoMinor(a),
      @ticker.MinorLocator::NamedAutoMinor(b),
    ) => !physical_equal(a, b)
    (@ticker.MinorLocator::NamedLog(a), @ticker.MinorLocator::NamedLog(b)) =>
      !physical_equal(a, b)
    (@ticker.MinorLocator::NamedSymLog(a), @ticker.MinorLocator::NamedSymLog(b)) =>
      !physical_equal(a, b)
    (@ticker.MinorLocator::NamedAsinh(a), @ticker.MinorLocator::NamedAsinh(b)) =>
      !physical_equal(a, b)
    (@ticker.MinorLocator::NamedLogit(a), @ticker.MinorLocator::NamedLogit(b)) =>
      !physical_equal(a, b)
    _ => true
  }
  [
    major,
    minor,
    !physical_equal(old.2, current.2),
    !physical_equal(old.3, current.3),
  ]
}

///|
fn scale_lifecycle_view_provider(
  value : Axis,
) -> () -> (Double, Double) raise @core.DataError {
  match value.locator().unwrap() {
    @ticker.Locator::NamedAuto(v) => v.view_interval_provider().unwrap()
    @ticker.Locator::NamedLog(v) => v.view_interval_provider().unwrap()
    @ticker.Locator::NamedSymLog(v) => v.view_interval_provider().unwrap()
    @ticker.Locator::NamedAsinh(v) => v.view_interval_provider().unwrap()
    @ticker.Locator::NamedLogit(v) => v.view_interval_provider().unwrap()
    _ => abort("named default locator expected")
  }
}

///|
fn scale_lifecycle_case_0() -> Unit raise {
  // repeat same geometry resets independent user slots
  let previous_x = @config.minor_ticks_visible()
  let previous_y = @config.minor_ticks_visible(horizontal=false)
  defer {
    @config.set_minor_ticks_visible(previous_x)
    @config.set_minor_ticks_visible(previous_y, horizontal=false)
  }
  @config.set_minor_ticks_visible(false)
  @config.set_minor_ticks_visible(false, horizontal=false)
  let value = axis()
  value.set_scale(@scale.Scale::Linear)

  assert_eq(scale_lifecycle_state(value), [
    "linear", "AutoLocator", "NullLocator", "ScalarFormatter", "NullFormatter",
  ])
  assert_eq(scale_lifecycle_flags(value), [true, true, true, true])
  let retained = scale_lifecycle_handles(value)
  value.set_scale(@scale.Scale::Linear)
  assert_eq(scale_lifecycle_state(value), [
    "linear", "AutoLocator", "NullLocator", "ScalarFormatter", "NullFormatter",
  ])
  assert_eq(scale_lifecycle_flags(value), [true, true, true, true])
  assert_eq(
    scale_lifecycle_replaced(retained, scale_lifecycle_handles(value)),
    [true, true, true, true],
  )
  assert_true(
    physical_equal(retained.2.axis().unwrap(), value.formatter_axis_binding()),
  )
  assert_true(
    physical_equal(retained.3.axis().unwrap(), value.formatter_axis_binding()),
  )
}

