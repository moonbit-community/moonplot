///|
fn scale_lifecycle_case_130() -> Unit raise {
  // discarded locator and formatter retain live original axis context
  let previous_x = @config.minor_ticks_visible()
  let previous_y = @config.minor_ticks_visible(horizontal=false)
  defer {
    @config.set_minor_ticks_visible(previous_x)
    @config.set_minor_ticks_visible(previous_y, horizontal=false)
  }
  @config.set_minor_ticks_visible(false)
  @config.set_minor_ticks_visible(false, horizontal=false)
  let value = axis()
  value.set_scale(@scale.Scale::Linear)
  let old_provider = scale_lifecycle_view_provider(value)
  let old_formatter = value.named_formatter().unwrap()
  value.set_scale(@scale.Scale::Linear)
  value.bind_view_interval(() => (0.2, 0.8))
  assert_eq(
    old_provider(),
    (
      4596373779694328218UL.reinterpret_as_double(),
      4605380978949069210UL.reinterpret_as_double(),
    ),
  )
  assert_true(
    physical_equal(
      old_formatter.axis().unwrap(),
      value.formatter_axis_binding(),
    ),
  )
  assert_true(!physical_equal(old_formatter, value.named_formatter().unwrap()))
}

