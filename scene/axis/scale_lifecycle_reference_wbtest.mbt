  let peer = axis()
  peer.share_numeric_tickers(value)
  assert_true(physical_equal(peer.tickers, value.tickers))
  assert_true(peer.scale().is_nonlinear() == false)
  assert_true(
    physical_equal(
      peer.named_formatter().unwrap().axis().unwrap(),
      value.formatter_axis_binding(),
    ),
  )
  peer.set_locator(@ticker.FixedLocator::new([-3.0, 2.0]).as_locator())
  assert_eq(scale_lifecycle_flags(value), [false, true, true, true])
  assert_eq(scale_lifecycle_flags(peer), [false, true, true, true])
  assert_eq(scale_lifecycle_state(value), [
    "logit", "FixedLocator", "LogitLocator", "LogitFormatter", "LogitFormatter",
  ])
  assert_eq(scale_lifecycle_state(peer), [
    "linear", "FixedLocator", "LogitLocator", "LogitFormatter", "LogitFormatter",
  ])
}

