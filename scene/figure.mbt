///|
/// Clear this axes' artists and presentation state while retaining its panel
/// rectangle and shared-axis membership.
pub fn Axes::clear(self : Axes) -> Unit {
  try! self.clear_checked()
}

///|
/// Add a line plot from paired x/y samples.
pub fn Figure::plot(
  self : Figure,
  xs : Array[Double],
  ys : Array[Double],
  color~ : String = "",
  label~ : String = "",
) -> Unit raise @core.DataError {
  self.axes().plot(xs, ys, color~, label~)
}

///|
/// Add a line plot from explicit points to the default axes.
pub fn Figure::line(
  self : Figure,
  points : Array[@core.Point],
  color~ : String = "",
  label~ : String = "",
) -> Unit {
  self.axes().line(points, color~, label~)
}

///|
/// Add a scatter plot to the default axes.
pub fn Figure::scatter(
  self : Figure,
  points : Array[@core.Point],
  color~ : String = "",
  label~ : String = "",
) -> Unit {
  self.axes().scatter(points, color~, label~)
}

///|
/// Add bars to the default axes.
pub fn Figure::bar(
  self : Figure,
  points : Array[@core.Point],
  color~ : String = "",
  label~ : String = "",
) -> Unit {
  self.axes().bar(points, color~, label~)
}

///|
/// Add a line plot through the axes view.
pub fn Axes::plot(
  self : Axes,
  xs : Array[Double],
  ys : Array[Double],
  color~ : String = "",
  label~ : String = "",
) -> Unit raise @core.DataError {
  let values = @core.series(xs, ys)
  self.line(values.points(), color~, label~)
}

///|
/// Add explicit line points through the axes view.
pub fn Axes::line(
  self : Axes,
  points : Array[@core.Point],
  color~ : String = "",
  label~ : String = "",
) -> Unit {
  let resolved_color = self.resolve_color(color)
  self.push_artist(
    Artist::Line(copy_points(points), @core.style(resolved_color)),
  )
  self.add_auto_legend(label, resolved_color, LegendKind::Line)
}

///|
/// Add scatter points through the axes view.
pub fn Axes::scatter(
  self : Axes,
  points : Array[@core.Point],
  color~ : String = "",
  label~ : String = "",
) -> Unit {
  let resolved_color = self.resolve_color(color)
  self.push_artist(
    Artist::Scatter(
      copy_points(points),
      @core.style(resolved_color, width=0.0, radius=3.5),
    ),
  )
  self.add_auto_legend(label, resolved_color, LegendKind::Marker)
}

///|
/// Add bars through the axes view.
pub fn Axes::bar(
  self : Axes,
  points : Array[@core.Point],
  color~ : String = "",
  label~ : String = "",
) -> Unit {
  let resolved_color = self.resolve_color(color)
  let start = self.state.val.artists.length()
  self.push_artist(
    Artist::Bar(
      copy_points(points),
      @core.style(resolved_color, width=0.0, fill=resolved_color),
    ),
  )
  self.add_auto_legend(label, resolved_color, LegendKind::Patch)
  self.add_container(ContainerKind::Bar, start, label)
}
