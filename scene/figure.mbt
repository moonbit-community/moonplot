///|
/// A plotting primitive stored by a figure.
pub(all) enum Artist {
  Line(Array[@core.Point], @core.Style)
  Scatter(Array[@core.Point], @core.Style)
  PathCollection(PathCollection)
  Bar(Array[@core.Point], @core.Style)
  BarH(Array[@core.Point], @core.Style)
  FillBetween(Array[@core.Point], Array[@core.Point], @core.Style)
  Polygon(Array[@core.Point], @core.Style)
  CompoundPolygon(Array[Array[@core.Point]], @core.Style)
  GouraudTriangle(Array[@core.Point], Array[String])
  HLine(Double, @core.Style)
  VLine(Double, @core.Style)
  AxLine(@core.Point, @core.Point, @core.Style)
  HSpan(Double, Double, @core.Style)
  VSpan(Double, Double, @core.Style)
  Text(Double, Double, String, @core.Style)
  Annotation(Annotation)
  ErrorBar(Array[@core.Point], Array[Double], Array[Double], @core.Style)
  Image(Array[Array[Double]], Double?, Double?, @colors.ColorMap)
  ImageNorm(
    Array[Array[Double]],
    @colors.ColorNorm,
    @colors.ColorMap,
    ImageOrigin,
    (Double, Double, Double, Double)?,
    Double,
    ImageInterpolation
  )
  /// An image whose pixels already carry RGB or RGBA colors.
  ColorImage(
    Array[Array[@colors.Rgba]],
    ImageOrigin,
    (Double, Double, Double, Double)?,
    Double,
    ImageInterpolation
  )
  Table(Table)
  Pie(Array[Double], Array[String], Array[String], Double)
  BoxPlot(Array[@boxplot.BoxStats], Bool, @core.Style)
  Quiver(Array[@core.Point], Array[@core.Point], @core.Style)
  Violin(
    Array[ViolinStats],
    Array[Double],
    Array[Double],
    Bool,
    ViolinSide,
    Bool,
    Bool,
    Bool,
    @core.Style,
    @core.Style,
    Double
  )
}

///|
/// The line and arrow artists produced by one streamplot call.
///
/// The arrays contain copies of the artists added to the owning axes, so the
/// returned value can be inspected without changing the figure.
pub struct StreamplotSet {
  lines : Array[Artist]
  arrows : Array[Artist]
}

///|
/// Construct a streamplot result from its line and arrow artists.
pub fn streamplot_set(
  lines : Array[Artist],
  arrows : Array[Artist],
) -> StreamplotSet {
  { lines: lines.copy(), arrows: arrows.copy(), }
}

///|
/// Return the streamline artists generated by this result.
pub fn StreamplotSet::lines(self : StreamplotSet) -> Array[Artist] {
  self.lines.copy()
}

///|
/// Return the arrow artists generated by this result.
pub fn StreamplotSet::arrows(self : StreamplotSet) -> Array[Artist] {
  self.arrows.copy()
}

///|
fn copy_points(points : Array[@core.Point]) -> Array[@core.Point] {
  points.copy()
}

///|
fn copy_artist(artist : Artist) -> Artist {
  match artist {
    Artist::Line(points, style) => Artist::Line(copy_points(points), style)
    Artist::Scatter(points, style) =>
      Artist::Scatter(copy_points(points), style)
    Artist::PathCollection(collection) =>
      Artist::PathCollection(copy_path_collection(collection))
    Artist::Bar(points, style) => Artist::Bar(copy_points(points), style)
    Artist::BarH(points, style) => Artist::BarH(copy_points(points), style)
    Artist::FillBetween(upper, lower, style) =>
      Artist::FillBetween(copy_points(upper), copy_points(lower), style)
    Artist::Polygon(points, style) =>
      Artist::Polygon(copy_points(points), style)
    Artist::CompoundPolygon(polygons, style) => {
      let copied : Array[Array[@core.Point]] = []
      for polygon in polygons {
        copied.push(copy_points(polygon))
      }
      Artist::CompoundPolygon(copied, style)
    }
    Artist::GouraudTriangle(points, colors) =>
      Artist::GouraudTriangle(copy_points(points), colors.copy())
    Artist::HLine(value, style) => Artist::HLine(value, style)
    Artist::VLine(value, style) => Artist::VLine(value, style)
    Artist::AxLine(point, direction, style) =>
      Artist::AxLine(point, direction, style)
    Artist::HSpan(lower, upper, style) => Artist::HSpan(lower, upper, style)
    Artist::VSpan(lower, upper, style) => Artist::VSpan(lower, upper, style)
    Artist::Text(x, y, value, style) => Artist::Text(x, y, value, style)
    Artist::Annotation(value) => Artist::Annotation(value)
    Artist::ErrorBar(points, yerr, xerr, style) =>
      Artist::ErrorBar(copy_points(points), yerr.copy(), xerr.copy(), style)
    Artist::Image(data, vmin, vmax, cmap) => {
      let copied = Array(capacity=data.length())
      for row in data {
        copied.push(row.copy())
      }
      Artist::Image(copied, vmin, vmax, cmap)
    }
    Artist::ImageNorm(data, norm, cmap, origin, extent, alpha, interpolation) => {
      let copied = Array(capacity=data.length())
      for row in data {
        copied.push(row.copy())
      }
      Artist::ImageNorm(
        copied, norm, cmap, origin, extent, alpha, interpolation,
      )
    }
    Artist::ColorImage(data, origin, extent, alpha, interpolation) => {
      let copied = Array(capacity=data.length())
      for row in data {
        copied.push(row.copy())
      }
      Artist::ColorImage(copied, origin, extent, alpha, interpolation)
    }
    Artist::Table(table) => Artist::Table(copy_table(table))
    Artist::Pie(values, labels, colors, start_angle) =>
      Artist::Pie(values.copy(), labels.copy(), colors.copy(), start_angle)
    Artist::BoxPlot(stats, horizontal, style) =>
      Artist::BoxPlot(stats.copy(), horizontal, style)
    Artist::Quiver(points, vectors, style) =>
      Artist::Quiver(points.copy(), vectors.copy(), style)
    Artist::Violin(
      stats,
      positions,
      widths,
      horizontal,
      side,
      showmeans,
      showextrema,
      showmedians,
      body_style,
      line_style,
      opacity
    ) =>
      Artist::Violin(
        stats.copy(),
        positions.copy(),
        widths.copy(),
        horizontal,
        side,
        showmeans,
        showextrema,
        showmedians,
        body_style,
        line_style,
        opacity,
      )
  }
}

///|
fn default_color_cycle() -> Array[String] {
  @config.color_cycle()
}

///|
/// Mutable state owned by one independent axes panel.
struct AxesData {
  artists : Array[Artist]
  x_axis : @axis.Axis
  y_axis : @axis.Axis
  mut title : String?
  mut explicit_bounds : @core.Bounds?
  mut legend : Array[LegendEntry]
  auto_legend : Array[LegendEntry]
  mut explicit_legend : Bool
  containers : Array[Container]
  rect : @gridspec.Rect?
  mut position_override : @gridspec.Rect?
  mut active_position : @gridspec.Rect?
  mut subplot_spec : @gridspec.SubplotSpec?
  mut share_x_group : Int32?
  mut share_y_group : Int32?
  mut share_x_order : Int64
  mut share_y_order : Int64
  mut share_x_target : @ref.Ref[AxesData]?
  mut share_y_target : @ref.Ref[AxesData]?
  mut share_x_members : SharedAxesGroup?
  mut share_y_members : SharedAxesGroup?
  mut show_x_tick_labels : Bool
  mut show_y_tick_labels : Bool
  mut frame_visible : Bool
  spines : Array[SpineState]
  mut x_margin : Double
  mut y_margin : Double
  mut raw_x_data : @core.Limits
  mut raw_y_data : @core.Limits
  mut x_data_minpos : Double
  mut y_data_minpos : Double
  mut ignore_existing_data_limits : Bool
  mut tight : Bool?
  mut use_sticky_edges : Bool
  color_cycle : Array[String]
  mut color_cycle_index : Int32
  mut data_aspect : Double?
  mut anchor : Anchor
  mut adjustable : String
  mut box_aspect : Double?
  secondary_x : Array[SecondaryAxis]
  secondary_y : Array[SecondaryAxis]
}

///|
/// State retained by a SubFigure handle and consumed by the renderer.
struct SubFigureData {
  spec : @gridspec.SubplotSpec
  mut title : String?
  axes : Array[@ref.Ref[AxesData]]
  subfigures : Array[@ref.Ref[SubFigureData]]
}

///|
/// Clear the presentation state retained by a nested figure tree.
fn SubFigureData::clear_titles(self : SubFigureData) -> Unit {
  for child in self.subfigures {
    child.val.clear_titles()
  }
  self.title = None
}

///|
fn AxesData::clear_presentation(self : AxesData) -> Unit {
  self.artists.clear()
  self.title = None
  self.explicit_bounds = None
  self.legend.clear()
  self.auto_legend.clear()
  self.containers.clear()
  self.explicit_legend = false
  self.show_x_tick_labels = true
  self.show_y_tick_labels = true
  self.frame_visible = true
  self.spines.clear()
  for spine in default_spines() {
    self.spines.push(spine)
  }
  self.x_margin = @config.x_margin()
  self.y_margin = @config.y_margin()
  self.ignore_existing_data_limits = true
  self.tight = None
  self.use_sticky_edges = true
  self.color_cycle.clear()
  for color in default_color_cycle() {
    self.color_cycle.push(color)
  }
  self.color_cycle_index = 0
  self.data_aspect = None
  self.secondary_x.clear()
  self.secondary_y.clear()
}

///|
/// A backend-independent figure containing ordered axes panels.
pub struct Figure {
  width : Int32
  height : Int32
  margin : Int32
  axes : Array[@ref.Ref[AxesData]]
  priv axes_selection : Array[@ref.Ref[AxesData]]
  subfigures : Array[@ref.Ref[SubFigureData]]
  colorbars : Array[@colorbar.Colorbar]
  mut share_group_seed : Int32
  priv mut share_x_next_order : Int64
  priv mut share_y_next_order : Int64
  mut title : String?
  priv mut subplot_left : Double
  priv mut subplot_bottom : Double
  priv mut subplot_right : Double
  priv mut subplot_top : Double
  priv mut subplot_wspace : Double?
  priv mut subplot_hspace : Double?
}

///|
/// Create an empty figure with one default axes panel.
pub fn figure(width~ : Int32 = 640, height~ : Int32 = 480) -> Figure {
  let margin = 56
  let figure_width = Double::from_int(width)
  let figure_height = Double::from_int(height)
  let left = if width > 0 {
    Double::from_int(margin) / figure_width
  } else {
    0.0
  }
  let bottom = if height > 0 {
    Double::from_int(margin) / figure_height
  } else {
    0.0
  }
  let default_axes = @ref.new({
    artists: [],
    x_axis: @axis.axis(),
    y_axis: @axis.axis(horizontal=false),
    title: None,
    explicit_bounds: None,
    legend: [],
    auto_legend: [],
    explicit_legend: false,
    containers: [],
    rect: None,
    position_override: None,
    active_position: None,
    subplot_spec: None,
    share_x_group: None,
    share_y_group: None,
    share_x_order: 0L,
    share_y_order: 0L,
    share_x_target: None,
    share_y_target: None,
    share_x_members: None,
    share_y_members: None,
    show_x_tick_labels: true,
    show_y_tick_labels: true,
    frame_visible: true,
    spines: default_spines(),
    x_margin: @config.x_margin(),
    y_margin: @config.y_margin(),
    raw_x_data: @core.limits(1.0 / 0.0, -1.0 / 0.0),
    raw_y_data: @core.limits(1.0 / 0.0, -1.0 / 0.0),
    x_data_minpos: 1.0 / 0.0,
    y_data_minpos: 1.0 / 0.0,
    ignore_existing_data_limits: true,
    tight: None,
    use_sticky_edges: true,
    color_cycle: default_color_cycle(),
    color_cycle_index: 0,
    data_aspect: None,
    anchor: Anchor::Named("C"),
    adjustable: "box",
    box_aspect: None,
    secondary_x: [],
    secondary_y: [],
  })
  let result : Figure = {
    width,
    height,
    margin,
    axes: [default_axes],
    axes_selection: [default_axes],
    subfigures: [],
    colorbars: [],
    share_group_seed: -1,
    share_x_next_order: 0L,
    share_y_next_order: 0L,
    title: None,
    subplot_left: left,
    subplot_bottom: bottom,
    subplot_right: 1.0 - left,
    subplot_top: 1.0 - bottom,
    subplot_wspace: None,
    subplot_hspace: None,
  }
  let axes : Axes = { figure: result, state: default_axes, }
  axes.bind_axis_data(true)
  axes.bind_axis_data(false)
  try! axes.clear_checked()
  result
}

///|
/// Allocate a never-reused projection id for a retained sharing group.
fn Figure::allocate_share_group(self : Figure, count : Int32) -> Int32 {
  let result = self.share_group_seed
  self.share_group_seed -= count
  result
}

///|
fn Figure::default_axes_data(self : Figure) -> @ref.Ref[AxesData] {
  if self.axes.is_empty() {
    return self.add_subplot(try! @gridspec.gridspec(1, 1).cell_spec(0, 0)).state
  }
  self.axes[0]
}

///|
fn Axes::push_artist(self : Axes, artist : Artist) -> Unit {
  self.state.val.artists.push(artist)
  self.update_artist_data_limits(artist)
  match artist {
    Artist::Text(_, _, _, _) | Artist::Annotation(_) | Artist::Table(_) => ()
    Artist::HLine(_, _) | Artist::HSpan(_, _, _) =>
      self.state.val.y_axis.request_autoscale()
    Artist::VLine(_, _) | Artist::VSpan(_, _, _) =>
      self.state.val.x_axis.request_autoscale()
    _ => {
      self.state.val.x_axis.request_autoscale()
      self.state.val.y_axis.request_autoscale()
    }
  }
}

///|
/// Set the figure title.
pub fn Figure::set_title(self : Figure, title : String) -> Unit {
  self.title = Some(title)
}

///|
/// Clear all axes, artists, legends, and colorbars while retaining the
/// figure's dimensions and subplot layout.
pub fn Figure::clear(self : Figure) -> Unit {
  try! self.clear_checked()
}

///|
/// Execute the checked Axes clear lifecycle once per retained panel.
/// The panel-preserving Figure convenience contract remains unchanged.
pub fn Figure::clear_checked(self : Figure) -> Unit raise @core.DataError {
  for state in self.axes.copy() {
    ({ figure: self, state, } : Axes).clear_checked()
  }
  for data in self.subfigures {
    data.val.clear_titles()
  }
  self.title = None
  self.subfigures.clear()
  self.colorbars.clear()
}

///|
/// Set the x-axis label on the default axes.
pub fn Figure::set_x_label(self : Figure, label : String) -> Unit {
  self.default_axes_data().val.x_axis.set_label(label)
}

///|
/// Set the y-axis label on the default axes.
pub fn Figure::set_y_label(self : Figure, label : String) -> Unit {
  self.default_axes_data().val.y_axis.set_label(label)
}

///|
/// Set explicit data limits for the default axes.
pub fn Figure::set_bounds(
  self : Figure,
  limits : @core.Bounds,
) -> Unit raise @core.DataError {
  if !limits.is_finite() {
    raise @core.DataError::NonFiniteLimit(axis="both")
  }
  self.axes().set_bounds(limits)
}

///|
/// Set x-axis limits on the default axes, preserving their direction.
pub fn Figure::set_x_limits(
  self : Figure,
  lower : Double,
  upper : Double,
) -> Unit raise @core.DataError {
  if !@core.limits(lower, upper).is_finite() {
    raise @core.DataError::NonFiniteLimit(axis="x")
  }
  self.axes().set_x_limits(lower, upper)
}

///|
/// Set y-axis limits on the default axes, preserving their direction.
pub fn Figure::set_y_limits(
  self : Figure,
  lower : Double,
  upper : Double,
) -> Unit raise @core.DataError {
  if !@core.limits(lower, upper).is_finite() {
    raise @core.DataError::NonFiniteLimit(axis="y")
  }
  self.axes().set_y_limits(lower, upper)
}

///|
/// Set the automatic x-axis margin on the default axes.
pub fn Figure::set_x_margin(
  self : Figure,
  value : Double,
) -> Unit raise @core.DataError {
  self.axes().set_x_margin(value)
}

///|
/// Set the automatic y-axis margin on the default axes.
pub fn Figure::set_y_margin(
  self : Figure,
  value : Double,
) -> Unit raise @core.DataError {
