  )
  axis.set_minor_named_formatter(
    @ticker.FuncFormatter::new((_, _) => {
      major.set_one_half(@ticker.LogValue::Text("late-half"))
      major.use_overline(
        @ticker.LogValue::Numeric(@ticker.ScalarNumber::Boolean(true)),
      )
      "minor"
    }).as_base_formatter(),
  )
  let svg = figure.to_svg_checked()
