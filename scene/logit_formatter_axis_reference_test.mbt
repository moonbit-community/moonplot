///|
fn logit_formatter_axis_case_58() -> Unit raise {
  let saved = @config.unicode_minus()
  defer @config.set_unicode_minus(saved)
  @config.set_unicode_minus(true)
  let f = @ticker.LogitFormatter::new(
    minor=@ticker.LogValue::Numeric(@ticker.ScalarNumber::Boolean(true)),
  )
  let owner = [0.03, 0.2, 0.5, 0.8, 0.97]
  let original = @ticker.TickValues::from_array(owner)
  f.set_locs_view(original)
  let copied = f.copy()
  owner[0] = 0.123
  logit_axis_assert_values(copied.locations(), [0.03, 0.2, 0.5, 0.8, 0.97])
  assert_true(physical_equal(logit_axis_view(f), logit_axis_view(copied)))
  assert_true(!physical_equal(original, logit_axis_view(f)))
  assert_eq(f.locations().length(), 5)
  logit_axis_assert_values(f.locations(), [0.03, 0.2, 0.5, 0.8, 0.97])
  assert_true(f.locations() is @ticker.FormatterLocations::NdArray(_))
  assert_eq(f.locations().dtype(), Some("float64"))
  logit_axis_assert_labelled(f, [0.5, 0.8, 0.2, 0.03, 0.97])
}

