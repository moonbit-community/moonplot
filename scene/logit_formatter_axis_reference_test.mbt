  axes.set_x_minor_locator(@ticker.NullLocator::new().as_minor_locator())
  axes.set_y_locator(@ticker.NullLocator::new().as_locator())
  axes.set_y_minor_locator(@ticker.NullLocator::new().as_minor_locator())
  let major = @ticker.LogitFormatter::new(
    minor=@ticker.LogValue::Numeric(@ticker.ScalarNumber::Boolean(false)),
  )
  let minor = @ticker.LogitFormatter::new(
    minor=@ticker.LogValue::Numeric(@ticker.ScalarNumber::Boolean(true)),
  )
  axis.set_named_formatter(major.as_base_formatter())
  axis.set_minor_named_formatter(minor.as_base_formatter())
  let replacement = @ticker.FuncFormatter::new((_, _) => "replacement")
  replacement.set_offset_string("late offset")
  axis.set_minor_named_formatter(
    @ticker.FuncFormatter::new((_, _) => {
      axis.set_named_formatter(replacement.as_base_formatter())
      "minor"
    }).as_base_formatter(),
  )
  axis.set_locator(
    @ticker.FixedLocator::new([0.01, 0.2, 0.5, 0.8, 0.99]).as_locator(),
  )
