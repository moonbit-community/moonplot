  let figure = @scene.figure(width=400, height=300)
  let axes = figure.axes()
  axes.set_x_limits(0.2, 0.8)
  axes.set_y_limits(0.2, 0.8)
  let axis = axes.x_axis()
  axis.set_scale(@scale.logit_scale())
  axes.set_x_locator(@ticker.NullLocator::new().as_locator())
  axes.set_x_minor_locator(@ticker.NullLocator::new().as_minor_locator())
  axes.set_y_locator(@ticker.NullLocator::new().as_locator())
  axes.set_y_minor_locator(@ticker.NullLocator::new().as_minor_locator())
  let major = @ticker.LogitFormatter::new(
    minor=@ticker.LogValue::Numeric(@ticker.ScalarNumber::Boolean(false)),
  )
  let minor = @ticker.LogitFormatter::new(
    minor=@ticker.LogValue::Numeric(@ticker.ScalarNumber::Boolean(true)),
  )
  axis.set_named_formatter(major.as_base_formatter())
  axis.set_minor_named_formatter(minor.as_base_formatter())
  let replacement = @ticker.FuncFormatter::new((_, _) => "replacement")
  replacement.set_offset_string("late offset")
  axis.set_minor_named_formatter(
    @ticker.FuncFormatter::new((_, _) => {
      axis.set_named_formatter(replacement.as_base_formatter())
      "minor"
    }).as_base_formatter(),
  )
  axis.set_locator(
    @ticker.FixedLocator::new([0.01, 0.2, 0.5, 0.8, 0.99]).as_locator(),
  )
  axis.set_minor_locator(
    @ticker.FixedLocator::new([0.03, 0.23, 0.37, 0.63, 0.77, 0.97]).as_minor_locator(),
  )
  let svg = figure.to_svg_checked()
  assert_eq(logit_axis_count(svg, "$\\mathdefault{0.2}$"), 1)
  assert_eq(logit_axis_count(svg, "$\\mathdefault{\\frac{1}{2}}$"), 1)
  assert_eq(logit_axis_count(svg, "$\\mathdefault{0.8}$"), 1)
  assert_eq(logit_axis_count(svg, "minor"), 4)
  assert_true(svg.contains("late offset"))
  assert_eq(major.locations().length(), 5)
  logit_axis_assert_values(major.locations(), [0.01, 0.2, 0.5, 0.8, 0.99])
  assert_true(major.locations() is @ticker.FormatterLocations::NdArray(_))
  assert_eq(major.locations().dtype(), Some("float64"))
  logit_axis_assert_labelled(major, [])
}

