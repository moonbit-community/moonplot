///|
fn logit_formatter_axis_case_108() -> Unit raise {
  let saved = @config.unicode_minus()
  defer @config.set_unicode_minus(saved)
  @config.set_unicode_minus(true)
  let figure = @scene.figure(width=400, height=300)
  let axes = figure.axes()
  axes.set_x_limits(0.01, 0.99)
  axes.set_y_limits(0.01, 0.99)
  let axis = axes.x_axis()
  axes.set_x_locator(@ticker.NullLocator::new().as_locator())
  axes.set_x_minor_locator(@ticker.NullLocator::new().as_minor_locator())
  axes.set_y_locator(@ticker.NullLocator::new().as_locator())
  axes.set_y_minor_locator(@ticker.NullLocator::new().as_minor_locator())
  ignore(axis)
  let secondary = axes.secondary_xaxis(value => value * 0.5, value => {
    value * 2.0
  })
  secondary.apply_aspect()
  let f = @ticker.LogitFormatter::new(
    minor=@ticker.LogValue::Numeric(@ticker.ScalarNumber::Boolean(false)),
  )
  secondary.set_named_formatter(f.as_base_formatter())
  secondary.set_minor_named_formatter(
    @ticker.NullFormatter::new().as_base_formatter(),
  )
  secondary.set_locator(
    @ticker.FixedLocator::new([0.01, 0.2, 0.3, 0.5, 0.8, 0.99]).as_locator(),
  )
  secondary.set_minor_locator(@ticker.NullLocator::new().as_minor_locator())
  let svg = figure.to_svg_checked()
  assert_eq(logit_axis_count(svg, "$\\mathdefault{10^{-2}}$"), 1)
  assert_eq(logit_axis_count(svg, "$\\mathdefault{0.2}$"), 1)
  assert_eq(logit_axis_count(svg, "$\\mathdefault{0.3}$"), 1)
  assert_eq(f.locations().length(), 6)
  logit_axis_assert_values(f.locations(), [0.01, 0.2, 0.3, 0.5, 0.8, 0.99])
  assert_true(f.locations() is @ticker.FormatterLocations::NdArray(_))
  assert_eq(f.locations().dtype(), Some("float64"))
  logit_axis_assert_labelled(f, [])
}

