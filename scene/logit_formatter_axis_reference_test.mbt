///|
fn logit_formatter_axis_case_145() -> Unit raise {
  let saved = @config.unicode_minus()
  defer @config.set_unicode_minus(saved)
  @config.set_unicode_minus(true)
  let f = @ticker.LogitFormatter::new(
    minor=@ticker.LogValue::Numeric(@ticker.ScalarNumber::Boolean(false)),
  )
  let values = Array::make(200001, 0.5)
  let labels = f.format_ticks_view(@ticker.TickValues::from_array(values))
  assert_eq(labels.length(), 200001)
  assert_eq(f.locations().length(), 200001)
  assert_eq(f.labelled().length(), 0)
  for label in labels {
    assert_eq(label, "$\\mathdefault{\\frac{1}{2}}$")
  }
}

///|
fn logit_formatter_axis_case_146() -> Unit raise {
  let saved = @config.unicode_minus()
  defer @config.set_unicode_minus(saved)
  @config.set_unicode_minus(true)
  let f = @ticker.LogitFormatter::new(
    minor=@ticker.LogValue::Numeric(@ticker.ScalarNumber::Boolean(true)),
  )
  let values = Array::makei(200001, index => {
    if index == 200000 {
      0.8
    } else {
      0.2 + index.to_double() * ((0.8 - 0.2) / 200000.0)
    }
  })
  let labels = f.format_ticks_view(@ticker.TickValues::from_array(values))
  assert_eq(labels.length(), 200001)
  assert_eq(f.locations().length(), 200001)
  assert_eq(f.labelled().length(), 0)
  for label in labels {
    assert_eq(label, "")
  }
}

