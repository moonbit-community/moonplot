// Generated by scripts/generate_logit_formatter_axis_reference.py; do not edit.

///|
fn logit_axis_view(formatter : @ticker.LogitFormatter) -> @ticker.TickValues {
  match formatter.locations() {
    @ticker.FormatterLocations::NdArray(view) => view
    _ => abort("expected ndarray fixture")
  }
}

///|
fn logit_axis_count(text : String, part : String) -> Int32 {
  text.split(part).count() - 1
}

///|
fn logit_axis_assert_values(
  actual : @ticker.FormatterLocations,
  expected : Array[Double],
) -> Unit raise {
  assert_eq(actual.length(), expected.length())
  for index in 0..<expected.length() {
    let value = actual.get(index)
    if expected[index].is_nan() {
      assert_true(value.is_nan())
    } else {
      assert_eq(
        value.reinterpret_as_uint64(),
        expected[index].reinterpret_as_uint64(),
      )
    }
  }
}

///|
fn logit_axis_assert_labelled(
  formatter : @ticker.LogitFormatter,
  expected : Array[Double],
) -> Unit raise {
  let actual = formatter
    .labelled()
    .map(key => {
      match key.value() {
        @ticker.ScalarNumber::Number(value)
        | @ticker.ScalarNumber::NumpyFloat64(value) => value
        @ticker.ScalarNumber::NumpyInt64(value) => value.to_double()
        _ => abort("unexpected scalar in Float64/Int64 Axis fixture")
      }
    })
  assert_eq(actual.length(), expected.length())
  for value in expected {
    assert_true(
      if value.is_nan() {
        actual.any(item => item.is_nan())
      } else {
        actual.contains(value)
      },
    )
  }
}

///|
fn logit_formatter_axis_case_0() -> Unit raise {
  let saved = @config.unicode_minus()
  defer @config.set_unicode_minus(saved)
  @config.set_unicode_minus(true)
  let f = @ticker.LogitFormatter::new(
    minor=@ticker.LogValue::Numeric(@ticker.ScalarNumber::Boolean(false)),
  )
  ignore(
    f.set_locs_view(@ticker.TickValues::from_array([0.03, 0.2, 0.5, 0.8, 0.97])),
  )
  assert_eq(f.locations().length(), 5)
  logit_axis_assert_values(f.locations(), [0.03, 0.2, 0.5, 0.8, 0.97])
  assert_true(f.locations() is @ticker.FormatterLocations::NdArray(_))
  assert_eq(f.locations().dtype(), Some("float64"))
  logit_axis_assert_labelled(f, [])
}

