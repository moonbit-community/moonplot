///|
fn logit_formatter_axis_case_141() -> Unit raise {
  let saved = @config.unicode_minus()
  defer @config.set_unicode_minus(saved)
  @config.set_unicode_minus(true)
  let f = @ticker.LogitFormatter::new(
    minor=@ticker.LogValue::Numeric(@ticker.ScalarNumber::Boolean(false)),
  )
  let owner = [0L, 1L, 2L, 3L]
  let source = @ticker.TickValues::from_int64_array(owner)
  let original = source.view(3, -1, 4)
  f.set_locs_view(original)
  for index in 0..<owner.length() {
    owner[index] = 9L
  }
  assert_eq(f.locations().length(), 4)
  logit_axis_assert_values(f.locations(), [3.0, 2.0, 1.0, 0.0])
  assert_true(f.locations() is @ticker.FormatterLocations::NdArray(_))
  assert_eq(f.locations().dtype(), Some("int64"))
  logit_axis_assert_labelled(f, [])
}

