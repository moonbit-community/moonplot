    raise @core.DataError::InvalidTicks(message="unexpected view")
  })
  binding.bind_transform_linthresh(() => {
    raise @core.DataError::InvalidTicks(message="unexpected transform")
  })
  binding.bind_short_format_delta(_ => {
    raise @core.DataError::InvalidTicks(message="unexpected pixel")
  })
  f.set_axis(Some(binding))
  f.set_locs_view(@ticker.TickValues::from_array([0.03, 0.2, 0.5, 0.8, 0.97]))
  assert_eq(f.format_data(0.2), "$\\mathdefault{0.2}$")
  assert_eq(f.locations().length(), 5)
  logit_axis_assert_values(f.locations(), [0.03, 0.2, 0.5, 0.8, 0.97])
  assert_true(f.locations() is @ticker.FormatterLocations::NdArray(_))
  assert_eq(f.locations().dtype(), Some("float64"))
  logit_axis_assert_labelled(f, [0.5, 0.8, 0.2, 0.03, 0.97])
}

