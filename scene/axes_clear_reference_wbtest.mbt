///|
fn axes_clear_axis(panel : Axes, horizontal : Bool) -> @axis.Axis {
  if horizontal {
    panel.state.val.x_axis
  } else {
    panel.state.val.y_axis
  }
}

///|
fn axes_clear_major_class(value : @ticker.Locator) -> String {
  match value {
    @ticker.Locator::NamedAuto(_) => "AutoLocator"
    @ticker.Locator::NamedLog(_) => "LogLocator"
    _ => "unexpected"
  }
}

///|
fn axes_clear_minor_class(value : @ticker.MinorLocator) -> String {
  match value {
    @ticker.MinorLocator::Null(_) => "NullLocator"
    @ticker.MinorLocator::NamedAutoMinor(_) => "AutoMinorLocator"
    @ticker.MinorLocator::NamedLog(_) => "LogLocator"
    _ => "unexpected"
  }
}

///|
fn axes_clear_same_major(
  left : @ticker.Locator,
  right : @ticker.Locator,
) -> Bool {
  match (left, right) {
    (@ticker.Locator::NamedAuto(first), @ticker.Locator::NamedAuto(second)) =>
      physical_equal(first, second)
    (@ticker.Locator::NamedLog(first), @ticker.Locator::NamedLog(second)) =>
      physical_equal(first, second)
    _ => false
  }
}

///|
fn axes_clear_same_minor(
  left : @ticker.MinorLocator,
  right : @ticker.MinorLocator,
) -> Bool {
  match (left, right) {
    (@ticker.MinorLocator::Null(first), @ticker.MinorLocator::Null(second)) =>
      physical_equal(first, second)
    (
      @ticker.MinorLocator::NamedAutoMinor(first),
      @ticker.MinorLocator::NamedAutoMinor(second),
    ) => physical_equal(first, second)
    (
      @ticker.MinorLocator::NamedLog(first),
      @ticker.MinorLocator::NamedLog(second),
    ) => physical_equal(first, second)
    _ => false
  }
}

///|
fn axes_clear_formatter_class(value : @ticker.BaseFormatter) -> String {
  if value.scalar_formatter() is Some(_) {
    "ScalarFormatter"
  } else if value.log_formatter_sci_notation() is Some(_) {
    "LogFormatterSciNotation"
  } else if value.null_formatter() is Some(_) {
    "NullFormatter"
  } else {
    "unexpected"
  }
}

///|
fn axes_clear_geometry(value : @axis.Axis) -> String {
  if value.scale().is_log() {
    "log"
  } else {
    "linear"
  }
}

///|
fn axes_clear_group_indices(
  panel : Axes,
  panels : Array[Axes],
  horizontal : Bool,
) -> Array[Int32] {
  let states = if horizontal {
    panel.x_group_states()
  } else {
    panel.y_group_states()
  }
  states.map(state => {
    let mut found = -1
    for index, item in panels {
      if physical_equal(state, item.state) {
        found = index
      }
    }
    found
  })
}

///|
fn axes_clear_bind_stored_views(panels : Array[Axes]) -> Unit {
  for panel in panels {
    for horizontal in [true, false] {
      let axis = axes_clear_axis(panel, horizontal)
      axis.bind_view_interval(() => {
        let view = axis.current_view_limits().unwrap_or(@core.limits(0.0, 1.0))
        (view.lower(), view.upper())
      })
    }
  }
}

///|
fn axes_clear_locator_view(
  value : @ticker.Locator,
) -> (Double, Double) raise @core.DataError {
  match value {
    @ticker.Locator::NamedAuto(value) =>
      value.view_interval_provider().unwrap()()
    @ticker.Locator::NamedLog(value) =>
      value.view_interval_provider().unwrap()()
    _ => (0.0 / 0.0, 0.0 / 0.0)
  }
}

///|
fn axes_clear_minor_view(
  value : @ticker.MinorLocator,
) -> (Double, Double) raise @core.DataError {
  match value {
    @ticker.MinorLocator::NamedAutoMinor(value) =>
      value.view_interval_provider().unwrap()()
    @ticker.MinorLocator::NamedLog(value) =>
      value.view_interval_provider().unwrap()()
    _ => (0.0 / 0.0, 0.0 / 0.0)
  }
}

///|
priv struct AxesClearCoordinate {
  geometry : String
  lower : Double
  upper : Double
  automatic : Bool
  group : Array[Int32]
  classes : Array[String]
  flags : Array[Bool]
  owners : Array[Int32]
  shared : Array[Bool]
  target : Int32
}

///|
priv struct AxesClearPanel {
  active : Bool
  children : Int32
  x : AxesClearCoordinate
  y : AxesClearCoordinate
}

///|
fn axes_clear_check_coordinate(
  panel : Axes,
  panels : Array[Axes],
  horizontal : Bool,
  expected : AxesClearCoordinate,
) -> Unit raise {
  let axis = axes_clear_axis(panel, horizontal)
  let first = axes_clear_axis(panels[0], horizontal)
  assert_eq(axes_clear_geometry(axis), expected.geometry)
  assert_eq(
    axis.current_view_limits().map(v => [v.lower(), v.upper()]),
    Some([expected.lower, expected.upper]),
  )
  assert_eq(axis.limits() is None, expected.automatic)
  assert_eq(axes_clear_group_indices(panel, panels, horizontal), expected.group)
  assert_eq(
    [
      axes_clear_major_class(axis.locator().unwrap()),
      axes_clear_minor_class(axis.minor_locator().unwrap()),
      axes_clear_formatter_class(axis.named_formatter().unwrap()),
      axes_clear_formatter_class(axis.minor_named_formatter().unwrap()),
    ],
    expected.classes,
  )
  assert_eq(
    [
      axis.is_default_locator(),
      axis.is_default_locator(minor=true),
      axis.is_default_formatter(),
      axis.is_default_formatter(minor=true),
    ],
    expected.flags,
  )
  assert_eq(
    axis.named_formatter().unwrap().axis(),
    Some(
      axes_clear_axis(panels[expected.owners[2]], horizontal).formatter_axis_binding(),
    ),
  )
  assert_eq(
    axis.minor_named_formatter().unwrap().axis(),
    Some(
      axes_clear_axis(panels[expected.owners[3]], horizontal).formatter_axis_binding(),
    ),
  )
  assert_eq(
    [
      axes_clear_same_major(axis.locator().unwrap(), first.locator().unwrap()),
      axes_clear_same_minor(
        axis.minor_locator().unwrap(),
        first.minor_locator().unwrap(),
      ),
      physical_equal(
        axis.named_formatter().unwrap(),
        first.named_formatter().unwrap(),
      ),
      physical_equal(
        axis.minor_named_formatter().unwrap(),
        first.minor_named_formatter().unwrap(),
      ),
    ],
    expected.shared,
  )
  let target = if horizontal {
    panel.state.val.share_x_target
  } else {
    panel.state.val.share_y_target
  }
  if expected.target < 0 {
    assert_true(target is None)
  } else {
    assert_true(physical_equal(target.unwrap(), panels[expected.target].state))
  }
}

///|
fn axes_clear_check(
  fig : Figure,
  panels : Array[Axes],
  reads : Array[String],
  expected_reads : Array[String],
  expected : Array[AxesClearPanel],
) -> Unit raise {
  assert_eq(
    fig.axes_list().length(),
    expected.filter(row => row.active).length(),
  )
  assert_eq(reads, expected_reads)
  for index, row in expected {
    let panel = panels[index]
    assert_eq(panel.is_attached(), row.active)
    assert_eq(panel.state.val.artists.length(), row.children)
    axes_clear_check_coordinate(panel, panels, true, row.x)
    axes_clear_check_coordinate(panel, panels, false, row.y)
  }
  // Public provider witness disambiguates retained locator owners after all
  // source view assertions, including owners outside current Figure membership.
  for index, panel in panels {
    panel.state.val.x_axis.bind_view_interval(() => {
      (index.to_double() + 2.0, index.to_double() + 3.0)
    })
    panel.state.val.y_axis.bind_view_interval(() => {
      (index.to_double() + 12.0, index.to_double() + 13.0)
    })
  }
  for index, row in expected {
    for horizontal in [true, false] {
      let axis = axes_clear_axis(panels[index], horizontal)
      let state = if horizontal { row.x } else { row.y }
      let addition = if horizontal { 2.0 } else { 12.0 }
      assert_eq(
        axes_clear_locator_view(axis.locator().unwrap()),
        (
          state.owners[0].to_double() + addition,
          state.owners[0].to_double() + addition + 1.0,
        ),
      )
      if state.classes[1] != "NullLocator" {
        assert_eq(
          axes_clear_minor_view(axis.minor_locator().unwrap()),
          (
            state.owners[1].to_double() + addition,
            state.owners[1].to_double() + addition + 1.0,
          ),
        )
      }
    }
  }
}

