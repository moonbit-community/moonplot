///|
// Actual Native SVG from immutable formal1215721, not a mirrored writer.
#cfg(target="native")
test "streamplot three formal 0.14 Native static controls stay byte identical" {
  let expected = [
    "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400\" height=\"300\" viewBox=\"0 0 400 300\"><rect width=\"100%\" height=\"100%\" fill=\"white\"/><polyline fill=\"none\" stroke=\"#398575\" stroke-width=\"1.5\" points=\"92,197 120.8,197 149.60000000000002,197 178.4,197 207.20000000000002,197 236,197 264.79999999999995,197\"/><polyline fill=\"none\" stroke=\"#398575\" stroke-width=\"1.5\" points=\"92,103 120.8,103 149.60000000000002,103 178.4,103 207.20000000000002,103 236,103 264.79999999999995,103\"/><rect x=\"184\" y=\"64\" width=\"152\" height=\"32\" fill=\"white\" fill-opacity=\"0.85\" stroke=\"#9ca3af\" stroke-width=\"1\"/><line x1=\"194\" y1=\"80\" x2=\"216\" y2=\"80\" stroke=\"#398575\" stroke-width=\"2\"/><text x=\"226\" y=\"84\" text-anchor=\"start\" font-family=\"sans-serif\" font-size=\"11\">Fixed flow</text></svg>",
    "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400\" height=\"300\" viewBox=\"0 0 400 300\"><rect width=\"100%\" height=\"100%\" fill=\"white\"/><polyline fill=\"none\" stroke=\"#398575\" stroke-width=\"1.5\" points=\"92,197 120.8,197 149.60000000000002,197 178.4,197 207.20000000000002,197 236,197 264.79999999999995,197\"/><polyline fill=\"none\" stroke=\"#398575\" stroke-width=\"1.5\" points=\"149.60000000000002,197 154,197\"/><polygon points=\"154,200.25 164,197 154,193.75\" fill=\"#398575\" stroke=\"#398575\" stroke-width=\"1.5\"/><polyline fill=\"none\" stroke=\"#398575\" stroke-width=\"1.5\" points=\"92,103 120.8,103 149.60000000000002,103 178.4,103 207.20000000000002,103 236,103 264.79999999999995,103\"/><polyline fill=\"none\" stroke=\"#398575\" stroke-width=\"1.5\" points=\"149.60000000000002,103 154,103\"/><polygon points=\"154,106.25 164,103 154,99.75\" fill=\"#398575\" stroke=\"#398575\" stroke-width=\"1.5\"/><rect x=\"184\" y=\"64\" width=\"152\" height=\"32\" fill=\"white\" fill-opacity=\"0.85\" stroke=\"#9ca3af\" stroke-width=\"1\"/><line x1=\"194\" y1=\"80\" x2=\"216\" y2=\"80\" stroke=\"#398575\" stroke-width=\"2\"/><text x=\"226\" y=\"84\" text-anchor=\"start\" font-family=\"sans-serif\" font-size=\"11\">Mesh flow with arrows</text></svg>",
    "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400\" height=\"300\" viewBox=\"0 0 400 300\"><rect width=\"100%\" height=\"100%\" fill=\"white\"/><polyline fill=\"none\" stroke=\"#3a3772\" stroke-width=\"1.35\" points=\"92,150 120.8,150\"/><polyline fill=\"none\" stroke=\"#345684\" stroke-width=\"1.55\" points=\"120.8,150 149.60000000000002,150\"/><polyline fill=\"none\" stroke=\"#32728b\" stroke-width=\"1.75\" points=\"149.60000000000002,150 178.4,150\"/><polyline fill=\"none\" stroke=\"#338a85\" stroke-width=\"1.9500000000000002\" points=\"178.4,150 207.20000000000002,150\"/><polyline fill=\"none\" stroke=\"#34a17f\" stroke-width=\"2.15\" points=\"207.20000000000002,150 236,150\"/><polyline fill=\"none\" stroke=\"#3ab877\" stroke-width=\"2.35\" points=\"236,150 264.79999999999995,150\"/><polyline fill=\"none\" stroke=\"#31658d\" stroke-width=\"1.65\" points=\"149.60000000000002,150 154,150\"/><polyline fill=\"none\" stroke=\"#31658d\" stroke-width=\"1.65\" points=\"154,153.25 164,150 154,146.75\"/><rect x=\"184\" y=\"64\" width=\"152\" height=\"32\" fill=\"white\" fill-opacity=\"0.85\" stroke=\"#9ca3af\" stroke-width=\"1\"/><line x1=\"194\" y1=\"80\" x2=\"216\" y2=\"80\" stroke=\"#398575\" stroke-width=\"2\"/><text x=\"226\" y=\"84\" text-anchor=\"start\" font-family=\"sans-serif\" font-size=\"11\">Style-grid flow</text></svg>",
  ]
  for case in 0..<3 {
    let (fig, _) = streamplot_control_fixture(case)
    assert_eq(fig.to_svg_checked(), expected[case])
    assert_eq(fig.to_drawing().svg(), expected[case])
  }
}
