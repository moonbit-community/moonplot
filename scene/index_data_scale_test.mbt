// Generated from original Bbox.update_from_path and IndexLocator data calls.

///|
test "Index raw data scale 0 x log retains negative x data" {
  let figure = @scene.figure(width=420, height=280)
  let axes = figure.axes()
  axes.plot([-2.0, 2.0, 4.0], [1.0, 1.0, 1.0])
  axes.set_x_scale(@scale.log_scale())
  axes.set_y_limits(0.0, 2.0)
  let locator = @ticker.IndexLocator::new(base=3.0, offset=0.0)
  axes.set_x_locator(locator.as_locator())
  axes.set_x_formatter(@ticker.format_str_formatter("raw-data-0=%.0f"))
  let axis = axes.x_axis()
  axes.set_x_limits(0.5, 5.0)
  let data_0 = axis.data_interval()
  assert_eq((data_0.lower(), data_0.upper()), (-2.0, 4.0))
  assert_eq(locator.call(), [-2.0, 1.0, 4.0])
  assert_eq(axis.tick_values_checked(@core.limits(0.5, 5.0)), [-2.0, 1.0, 4.0])
  let svg_0 = figure.to_svg_checked()
  assert_true(!svg_0.contains(">raw-data-0=-2<"))
  assert_true(svg_0.contains(">raw-data-0=1<"))
  assert_true(svg_0.contains(">raw-data-0=4<"))
  assert_true(!svg_0.contains("NaN"))
  assert_true(!svg_0.contains("Infinity"))
  axes.set_x_limits(5.0, 2.5)
  let data_1 = axis.data_interval()
  assert_eq((data_1.lower(), data_1.upper()), (-2.0, 4.0))
  assert_eq(locator.call(), [-2.0, 1.0, 4.0])
  assert_eq(axis.tick_values_checked(@core.limits(5.0, 2.5)), [-2.0, 1.0, 4.0])
  let svg_1 = figure.to_svg_checked()
  assert_true(!svg_1.contains(">raw-data-0=-2<"))
  assert_true(!svg_1.contains(">raw-data-0=1<"))
  assert_true(svg_1.contains(">raw-data-0=4<"))
  assert_true(!svg_1.contains("NaN"))
  assert_true(!svg_1.contains("Infinity"))
}

