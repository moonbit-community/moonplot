pub fn Container::kind(Self) -> ContainerKind
pub fn Container::label(Self) -> String

pub(all) enum ContainerKind {
  Generic
  Bar
  ErrorBar
  Stem
  BoxPlot
  Contour
  Quiver
  Violin
  Pie
  Stackplot
  Streamplot
}

pub struct ContourSet {
