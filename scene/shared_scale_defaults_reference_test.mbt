///|
fn shared_scale_defaults_case_4() -> Unit raise {
  let saved = @config.rc_params()
  defer {
    @config.set_classic_mode(saved.classic_mode())
    @config.set_minor_ticks_visible(saved.minor_ticks_visible())
    @config.set_minor_ticks_visible(
      saved.minor_ticks_visible(horizontal=false),
      horizontal=false,
    )
    @config.set_formatter_use_offset(saved.formatter_use_offset())
    @config.set_formatter_use_math_text(saved.formatter_use_math_text())
    @config.set_formatter_use_locale(saved.formatter_use_locale())
    @config.set_text_usetex(saved.text_usetex())
    @config.set_unicode_minus(saved.unicode_minus())
    @config.set_formatter_min_exponent(saved.formatter_min_exponent())
    @config.set_formatter_offset_threshold(saved.formatter_offset_threshold())
    try! @config.set_formatter_limits(saved.formatter_limits())
  }
  @config.set_classic_mode(false)
  @config.set_minor_ticks_visible(false)
  @config.set_minor_ticks_visible(true, horizontal=false)
  @config.set_formatter_use_offset(true)
  @config.set_formatter_use_math_text(false)
  @config.set_formatter_use_locale(false)
  @config.set_text_usetex(false)
  @config.set_unicode_minus(true)
  @config.set_formatter_min_exponent(@bigint.BigInt::from_int(0))
  @config.set_formatter_offset_threshold(@bigint.BigInt::from_int(4))
  @config.set_formatter_limits([
    @bigint.BigInt::from_int(-5),
    @bigint.BigInt::from_int(6),
  ])
  let figure = @scene.figure(width=400, height=300)
  let grid = figure.grid_spec(2, 2)
  let axes = figure.subplots_with_grid(
    grid.with_shared_axes(@gridspec.ShareMode::Row, @gridspec.ShareMode::None),
  )
  for axes in axes {
    axes.set_x_limits(0.01, 0.99)
  }
  for axes in axes {
    axes.set_y_limits(0.01, 0.99)
  }
  let axis_handles = axes.map(axes => axes.x_axis())
  axes[0].set_x_scale(@scale.log_scale())
  axis_handles[1].bind_view_interval(() => (3.0, 4.0))
  axis_handles[0].bind_view_interval(() => (2.0, 3.0))
  assert_eq(
    shared_scale_major_class(axis_handles[1].locator().unwrap()),
    "LogLocator",
  )
  assert_eq(
    shared_scale_minor_class(axis_handles[1].minor_locator().unwrap()),
    "LogLocator",
  )
  assert_eq(
    shared_scale_formatter_class(axis_handles[1].named_formatter().unwrap()),
    "LogFormatterSciNotation",
  )
  assert_eq(
    shared_scale_formatter_class(
      axis_handles[1].minor_named_formatter().unwrap(),
    ),
    "LogFormatterSciNotation",
  )
  assert_eq(
    [
      axis_handles[1].is_default_locator(),
      axis_handles[1].is_default_locator(minor=true),
      axis_handles[1].is_default_formatter(),
      axis_handles[1].is_default_formatter(minor=true),
    ],
    [true, true, true, true],
  )
  assert_eq(
    axis_handles[1].named_formatter().unwrap().axis(),
    Some(axis_handles[0].formatter_axis_binding()),
  )
  assert_eq(
    axis_handles[1].minor_named_formatter().unwrap().axis(),
    Some(axis_handles[0].formatter_axis_binding()),
  )
  assert_eq(
    shared_scale_major_class(axis_handles[0].locator().unwrap()),
    "LogLocator",
  )
  assert_eq(
    shared_scale_minor_class(axis_handles[0].minor_locator().unwrap()),
    "LogLocator",
  )
  assert_eq(
    shared_scale_formatter_class(axis_handles[0].named_formatter().unwrap()),
    "LogFormatterSciNotation",
  )
  assert_eq(
    shared_scale_formatter_class(
      axis_handles[0].minor_named_formatter().unwrap(),
    ),
    "LogFormatterSciNotation",
  )
  assert_eq(
    [
      axis_handles[0].is_default_locator(),
      axis_handles[0].is_default_locator(minor=true),
      axis_handles[0].is_default_formatter(),
      axis_handles[0].is_default_formatter(minor=true),
    ],
    [true, true, true, true],
  )
  assert_true(
    physical_equal(
      axis_handles[0].named_formatter().unwrap(),
      axis_handles[1].named_formatter().unwrap(),
    ),
  )
  assert_eq(
