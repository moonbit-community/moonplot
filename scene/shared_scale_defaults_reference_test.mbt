    shared_scale_formatter_class(
      axis_handles[2].minor_named_formatter().unwrap(),
    ),
    "NullFormatter",
  )
  assert_eq(
    [
      axis_handles[2].is_default_locator(),
      axis_handles[2].is_default_locator(minor=true),
      axis_handles[2].is_default_formatter(),
      axis_handles[2].is_default_formatter(minor=true),
    ],
    [true, true, true, false],
  )
  assert_eq(
    axis_handles[2].named_formatter().unwrap().axis(),
    Some(axis_handles[0].formatter_axis_binding()),
  )
  assert_eq(
    axis_handles[2].minor_named_formatter().unwrap().axis(),
    Some(axis_handles[0].formatter_axis_binding()),
  )
  assert_eq(
    shared_scale_major_class(axis_handles[0].locator().unwrap()),
    "LogLocator",
  )
  assert_eq(
    shared_scale_minor_class(axis_handles[0].minor_locator().unwrap()),
    "LogLocator",
  )
  assert_eq(
    shared_scale_formatter_class(axis_handles[0].named_formatter().unwrap()),
    "LogFormatterSciNotation",
  )
  assert_eq(
    shared_scale_formatter_class(
      axis_handles[0].minor_named_formatter().unwrap(),
    ),
    "NullFormatter",
  )
  assert_eq(
    [
      axis_handles[0].is_default_locator(),
      axis_handles[0].is_default_locator(minor=true),
      axis_handles[0].is_default_formatter(),
      axis_handles[0].is_default_formatter(minor=true),
    ],
    [true, true, true, false],
  )
  assert_true(
    physical_equal(
      axis_handles[0].named_formatter().unwrap(),
      axis_handles[2].named_formatter().unwrap(),
    ),
  )
  assert_eq(
    axis_handles[0].named_formatter().unwrap().axis(),
    Some(axis_handles[0].formatter_axis_binding()),
  )
  assert_true(
    physical_equal(
      axis_handles[0].minor_named_formatter().unwrap(),
      axis_handles[2].minor_named_formatter().unwrap(),
    ),
  )
  assert_eq(
    axis_handles[0].minor_named_formatter().unwrap().axis(),
    Some(axis_handles[0].formatter_axis_binding()),
  )
  assert_true(
    shared_scale_same_locator(
      axis_handles[0].locator().unwrap(),
      axis_handles[2].locator().unwrap(),
    ),
  )
  assert_true(
    shared_scale_same_minor(
      axis_handles[0].minor_locator().unwrap(),
      axis_handles[2].minor_locator().unwrap(),
    ),
  )
  assert_eq(
    shared_scale_locator_view(axis_handles[2].locator().unwrap()),
    (2.0, 3.0),
  )
  axes[0].set_y_scale(@scale.log_scale())
  assert_true(
    !shared_scale_same_locator(
      previous_locator,
      axis_handles[0].locator().unwrap(),
    ),
  )
  assert_true(
    !physical_equal(
      previous_formatter,
      axis_handles[0].named_formatter().unwrap(),
    ),
  )
  axis_handles[2].bind_view_interval(() => (4.0, 5.0))
  axis_handles[0].bind_view_interval(() => (2.0, 3.0))
  assert_eq(
    shared_scale_major_class(axis_handles[2].locator().unwrap()),
    "LogLocator",
  )
  assert_eq(
    shared_scale_minor_class(axis_handles[2].minor_locator().unwrap()),
    "LogLocator",
  )
  assert_eq(
    shared_scale_formatter_class(axis_handles[2].named_formatter().unwrap()),
    "LogFormatterSciNotation",
  )
  assert_eq(
    shared_scale_formatter_class(
      axis_handles[2].minor_named_formatter().unwrap(),
    ),
    "LogFormatterSciNotation",
  )
  assert_eq(
    [
      axis_handles[2].is_default_locator(),
      axis_handles[2].is_default_locator(minor=true),
      axis_handles[2].is_default_formatter(),
      axis_handles[2].is_default_formatter(minor=true),
