///|
fn shared_scale_defaults_case_19() -> Unit raise {
  let saved = @config.rc_params()
  defer {
    @config.set_classic_mode(saved.classic_mode())
    @config.set_minor_ticks_visible(saved.minor_ticks_visible())
    @config.set_minor_ticks_visible(
      saved.minor_ticks_visible(horizontal=false),
      horizontal=false,
    )
    @config.set_formatter_use_offset(saved.formatter_use_offset())
    @config.set_formatter_use_math_text(saved.formatter_use_math_text())
    @config.set_formatter_use_locale(saved.formatter_use_locale())
    @config.set_text_usetex(saved.text_usetex())
    @config.set_unicode_minus(saved.unicode_minus())
    @config.set_formatter_min_exponent(saved.formatter_min_exponent())
    @config.set_formatter_offset_threshold(saved.formatter_offset_threshold())
    try! @config.set_formatter_limits(saved.formatter_limits())
  }
  @config.set_classic_mode(false)
  @config.set_minor_ticks_visible(false)
  @config.set_minor_ticks_visible(true, horizontal=false)
  @config.set_formatter_use_offset(true)
  @config.set_formatter_use_math_text(false)
