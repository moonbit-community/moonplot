    ),
  )
  assert_true(
    shared_scale_same_minor(
      axis_handles[0].minor_locator().unwrap(),
      axis_handles[1].minor_locator().unwrap(),
    ),
  )
  assert_eq(
    shared_scale_locator_view(axis_handles[1].locator().unwrap()),
    (2.0, 3.0),
  )
  let previous_locator = axis_handles[0].locator().unwrap()
  let previous_formatter = axis_handles[0].named_formatter().unwrap()
  let external_formatter = previous_formatter.copy()
  axis_handles[0].set_minor_named_formatter(
    @ticker.NullFormatter::new().as_base_formatter(),
  )
  axis_handles[1].bind_view_interval(() => (3.0, 4.0))
  axis_handles[0].bind_view_interval(() => (2.0, 3.0))
  assert_eq(
    shared_scale_major_class(axis_handles[1].locator().unwrap()),
