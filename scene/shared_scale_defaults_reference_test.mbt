///|
fn shared_scale_defaults_case_66() -> Unit raise {
  let saved = @config.rc_params()
  defer {
    @config.set_classic_mode(saved.classic_mode())
    @config.set_minor_ticks_visible(saved.minor_ticks_visible())
    @config.set_minor_ticks_visible(
      saved.minor_ticks_visible(horizontal=false),
      horizontal=false,
    )
    @config.set_formatter_use_offset(saved.formatter_use_offset())
    @config.set_formatter_use_math_text(saved.formatter_use_math_text())
    @config.set_formatter_use_locale(saved.formatter_use_locale())
    @config.set_text_usetex(saved.text_usetex())
    @config.set_unicode_minus(saved.unicode_minus())
    @config.set_formatter_min_exponent(saved.formatter_min_exponent())
    @config.set_formatter_offset_threshold(saved.formatter_offset_threshold())
    try! @config.set_formatter_limits(saved.formatter_limits())
  }
  @config.set_classic_mode(false)
  @config.set_minor_ticks_visible(false)
  @config.set_minor_ticks_visible(false, horizontal=false)
  @config.set_formatter_use_offset(true)
  @config.set_formatter_use_math_text(false)
  @config.set_formatter_use_locale(false)
  @config.set_text_usetex(false)
  @config.set_unicode_minus(true)
  @config.set_formatter_min_exponent(@bigint.BigInt::from_int(0))
  @config.set_formatter_offset_threshold(@bigint.BigInt::from_int(4))
  @config.set_formatter_limits([
    @bigint.BigInt::from_int(-5),
    @bigint.BigInt::from_int(6),
  ])
  let figure = @scene.figure()
  let axes = figure.subplots(1, 3, share_x=true, share_y=true)
  axes[0].set_x_limits(1.0, 10.0)
  axes[0].set_x_ticks([1.0, 10.0])
  axes[0].set_x_tick_labels(["one", "ten"])
  axes[1].remove()
  axes[1].set_x_limits(100.0, 200.0)
  axes[1].set_x_scale(@scale.log_scale())
  axes[1].set_x_ticks([100.0])
  axes[1].set_x_tick_labels(["detached"])
  axes[0].set_x_limits(5.0, 15.0)
  axes[0]
  .x_axis()
  .set_minor_locator(@ticker.NullLocator::new().as_minor_locator())
  assert_eq(
    axes[0].x_axis().ticks(),
    Some([4636737291354636288UL.reinterpret_as_double()]),
  )
  assert_eq(
    axes[0]
    .x_axis()
    .tick_labels_checked([4636737291354636288UL.reinterpret_as_double()]),
    ["detached"],
  )
  assert_true(!axes[0].x_axis().is_default_locator())
  assert_true(!axes[0].x_axis().is_default_formatter())
  assert_true(!axes[0].x_axis().scale().is_log())
  let view_0 = axes[0].x_axis().limits().unwrap()
  assert_eq((view_0.lower(), view_0.upper()), (5.0, 15.0))
  assert_eq(
    axes[2].x_axis().ticks(),
    Some([4636737291354636288UL.reinterpret_as_double()]),
  )
  assert_eq(
    axes[2]
    .x_axis()
    .tick_labels_checked([4636737291354636288UL.reinterpret_as_double()]),
    ["detached"],
  )
  assert_true(!axes[2].x_axis().is_default_locator())
  assert_true(!axes[2].x_axis().is_default_formatter())
  assert_true(!axes[2].x_axis().scale().is_log())
  let view_2 = axes[2].x_axis().limits().unwrap()
  assert_eq((view_2.lower(), view_2.upper()), (5.0, 15.0))
  let removed_view = axes[1].x_axis().limits().unwrap()
  assert_eq((removed_view.lower(), removed_view.upper()), (100.0, 200.0))
  let svg = figure.to_svg_checked()
  assert_true(!svg.contains(">detached<"))
  assert_true(!svg.contains(">one<"))
  assert_true(!svg.contains(">ten<"))
}

