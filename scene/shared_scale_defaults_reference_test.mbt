  let axis_handles = axes.map(axes => axes.y_axis())
  axes[0].set_y_scale(@scale.asinh_scale())
  axis_handles[1].bind_view_interval(() => (3.0, 4.0))
  axis_handles[0].bind_view_interval(() => (2.0, 3.0))
